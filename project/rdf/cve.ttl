<https://w3id.org/lmodel/cve/cveRecordMetadata__cveId> a linkml:SlotDefinition ;
	skos:broadMatch "http://purl.org/dc/terms/identifier"^^xsd:anyURI , "http://schema.org/identifier"^^xsd:anyURI ;
