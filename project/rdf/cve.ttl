	linkml:minimum_cardinality 1 ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/cve/CveAdpContainer> ;
	linkml:range <https://w3id.org/lmodel/cve/CveProduct> ;
	linkml:slot_uri "https://w3id.org/lmodel/cve/affected"^^xsd:anyURI .
<https://w3id.org/lmodel/cve/analyst> linkml:description "Checked that it is accurate or how severe it is." .
