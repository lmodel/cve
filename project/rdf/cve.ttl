<https://w3id.org/lmodel/cve/dataVersion> a linkml:SlotDefinition ;
	skos:note "The upstream gives 5.2.0 as a default, which cannot apply to a required key." ;
	linkml:annotations _:c14n331 ;
	linkml:description "The version of the record format that this record follows." ;
