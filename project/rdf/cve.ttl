	linkml:range <https://w3id.org/lmodel/cve/cve_version> ;
	linkml:slot_uri "https://w3id.org/lmodel/cve/at"^^xsd:anyURI .
<https://w3id.org/lmodel/cve/attackComplexity> a linkml:SlotDefinition ;
