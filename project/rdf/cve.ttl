<https://w3id.org/lmodel/cve/assignerShortName> a linkml:SlotDefinition ;
	linkml:annotations _:c14n369 ;
	linkml:description "The short name of the organisation that was given the CVE identifier." ;
	linkml:range <https://w3id.org/lmodel/cve/cve_short_name> .
<https://w3id.org/lmodel/cve/at> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/cve/cve_record"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/cve/at"^^xsd:anyURI ;
	linkml:annotations _:c14n153 ;
	linkml:definition_uri "https://w3id.org/lmodel/cve/at"^^xsd:anyURI ;
	linkml:description "The version from which a new status starts." ;
