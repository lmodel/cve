<https://w3id.org/lmodel/cve/CveRecord> a linkml:ClassDefinition ;
	skos:closeMatch "sepses_cve:CVE"^^xsd:anyURI , "spdx_security:Vulnerability"^^xsd:anyURI , "stix:StixVulnerability"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/cve/cve_record"^^xsd:anyURI ;
	skos:note "Its two kinds are told apart by cveMetadata's state, nested inside the record, so LinkML's type designator cannot choose between them. A reader picks the class from the state, or validates against CveRecordRoot." , "wd:Q631425 is the idea of a vulnerability, which a record describes and is not, so that mapping is only related. SEPSES, SPDX and STIX each have a class for the description of one vulnerability, so those are close." ;
	skos:relatedMatch "wd:Q631425"^^xsd:anyURI ;
	linkml:abstract true ;
	linkml:annotations _:c14n89 ;
	linkml:attributes <https://w3id.org/lmodel/cve/dataType> , <https://w3id.org/lmodel/cve/dataVersion> ;
	linkml:children_are_mutually_disjoint true ;
	linkml:class_uri "https://w3id.org/lmodel/cve/CveRecord"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/cve/CveRecord"^^xsd:anyURI ;
