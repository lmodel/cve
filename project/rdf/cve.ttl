	linkml:slot_uri "https://w3id.org/lmodel/cve/exploitCodeMaturity"^^xsd:anyURI .
<https://w3id.org/lmodel/cve/exploitMaturity> a linkml:SlotDefinition ;
	linkml:annotations _:c14n97 ;
