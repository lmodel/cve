<https://w3id.org/lmodel/cve/CvssV4ModifiedAttackVector> skos:inScheme "https://w3id.org/lmodel/cve/cve_cvss"^^xsd:anyURI ;
	linkml:annotations _:c14n171 ;
	linkml:definition_uri "https://w3id.org/lmodel/cve/CvssV4ModifiedAttackVector"^^xsd:anyURI ;
	linkml:description "The attack vector as the scorer's environment changes it, in CVSS 4.0's terms." ;
	linkml:permissible_values <https://w3id.org/lmodel/cve/ADJACENT> , <https://w3id.org/lmodel/cve/LOCAL> , <https://w3id.org/lmodel/cve/NETWORK> , <https://w3id.org/lmodel/cve/NOT_DEFINED> , <https://w3id.org/lmodel/cve/PHYSICAL> .
<https://w3id.org/lmodel/cve/CvssV4ModifiedSubsequentImpact> skos:inScheme "https://w3id.org/lmodel/cve/cve_cvss"^^xsd:anyURI ;
	linkml:annotations _:c14n332 ;
	linkml:definition_uri "https://w3id.org/lmodel/cve/CvssV4ModifiedSubsequentImpact"^^xsd:anyURI ;
	linkml:description "The integrity or availability impact on connected systems as the scorer's environment changes it, which may include a risk to safety." ;
	linkml:permissible_values <https://w3id.org/lmodel/cve/HIGH> , <https://w3id.org/lmodel/cve/LOW> , <https://w3id.org/lmodel/cve/NONE> , <https://w3id.org/lmodel/cve/NOT_DEFINED> , <https://w3id.org/lmodel/cve/SAFETY> .
<https://w3id.org/lmodel/cve/CvssV4ModifiedUserInteraction> skos:inScheme "https://w3id.org/lmodel/cve/cve_cvss"^^xsd:anyURI ;
	linkml:annotations _:c14n397 ;
	linkml:definition_uri "https://w3id.org/lmodel/cve/CvssV4ModifiedUserInteraction"^^xsd:anyURI ;
	linkml:description "The user interaction as the scorer's environment changes it, in CVSS 4.0's terms." ;
	linkml:permissible_values <https://w3id.org/lmodel/cve/ACTIVE> , <https://w3id.org/lmodel/cve/NONE> , <https://w3id.org/lmodel/cve/NOT_DEFINED> , <https://w3id.org/lmodel/cve/PASSIVE> .
<https://w3id.org/lmodel/cve/CvssV4ProviderUrgency> skos:inScheme "https://w3id.org/lmodel/cve/cve_cvss"^^xsd:anyURI ;
	linkml:annotations _:c14n339 ;
	linkml:definition_uri "https://w3id.org/lmodel/cve/CvssV4ProviderUrgency"^^xsd:anyURI ;
	linkml:description "How urgent the product's supplier says the flaw is, as a colour." ;
	linkml:permissible_values <https://w3id.org/lmodel/cve/AMBER> , <https://w3id.org/lmodel/cve/CLEAR> , <https://w3id.org/lmodel/cve/GREEN> , <https://w3id.org/lmodel/cve/NOT_DEFINED> , <https://w3id.org/lmodel/cve/RED> .
<https://w3id.org/lmodel/cve/CvssV4Recovery> skos:inScheme "https://w3id.org/lmodel/cve/cve_cvss"^^xsd:anyURI ;
	linkml:annotations _:c14n263 ;
	linkml:definition_uri "https://w3id.org/lmodel/cve/CvssV4Recovery"^^xsd:anyURI ;
	linkml:description "How the affected system comes back after an attack." ;
	linkml:permissible_values <https://w3id.org/lmodel/cve/AUTOMATIC> , <https://w3id.org/lmodel/cve/IRRECOVERABLE> , <https://w3id.org/lmodel/cve/NOT_DEFINED> , <https://w3id.org/lmodel/cve/USER> .
<https://w3id.org/lmodel/cve/CvssV4ResponseEffort> skos:inScheme "https://w3id.org/lmodel/cve/cve_cvss"^^xsd:anyURI ;
	linkml:annotations _:c14n16 ;
	linkml:definition_uri "https://w3id.org/lmodel/cve/CvssV4ResponseEffort"^^xsd:anyURI ;
	linkml:description "How much work it takes a consumer to respond to the flaw." ;
	linkml:permissible_values <https://w3id.org/lmodel/cve/HIGH> , <https://w3id.org/lmodel/cve/LOW> , <https://w3id.org/lmodel/cve/MODERATE> , <https://w3id.org/lmodel/cve/NOT_DEFINED> .
<https://w3id.org/lmodel/cve/CvssV4Safety> skos:inScheme "https://w3id.org/lmodel/cve/cve_cvss"^^xsd:anyURI ;
	linkml:annotations _:c14n246 ;
	linkml:definition_uri "https://w3id.org/lmodel/cve/CvssV4Safety"^^xsd:anyURI ;
	linkml:description "Whether an attack could put people's safety at risk." ;
	linkml:permissible_values <https://w3id.org/lmodel/cve/NEGLIGIBLE> , <https://w3id.org/lmodel/cve/NOT_DEFINED> , <https://w3id.org/lmodel/cve/PRESENT> .
<https://w3id.org/lmodel/cve/CvssV4UserInteraction> skos:inScheme "https://w3id.org/lmodel/cve/cve_cvss"^^xsd:anyURI ;
	linkml:annotations _:c14n359 ;
	linkml:definition_uri "https://w3id.org/lmodel/cve/CvssV4UserInteraction"^^xsd:anyURI ;
	linkml:description "Whether someone else has to take part, in CVSS 4.0's terms." ;
	linkml:permissible_values <https://w3id.org/lmodel/cve/ACTIVE> , <https://w3id.org/lmodel/cve/NONE> , <https://w3id.org/lmodel/cve/PASSIVE> .
<https://w3id.org/lmodel/cve/CvssV4ValueDensity> skos:inScheme "https://w3id.org/lmodel/cve/cve_cvss"^^xsd:anyURI ;
	linkml:annotations _:c14n289 ;
	linkml:definition_uri "https://w3id.org/lmodel/cve/CvssV4ValueDensity"^^xsd:anyURI ;
	linkml:description "How much of a resource one successful attack gains the attacker." ;
	linkml:permissible_values <https://w3id.org/lmodel/cve/CONCENTRATED> , <https://w3id.org/lmodel/cve/DIFFUSE> , <https://w3id.org/lmodel/cve/NOT_DEFINED> .
<https://w3id.org/lmodel/cve/DIFFUSE> linkml:description "Each target holds little, so an attacker must take many." .
<https://w3id.org/lmodel/cve/FUNCTIONAL> linkml:description "Working attack code exists for most situations." .
<https://w3id.org/lmodel/cve/GREEN> linkml:description "The supplier says the flaw can wait for regular work." .
<https://w3id.org/lmodel/cve/HIGH> linkml:description "A loss would have catastrophic effect." , "Administrator-level access." , "All of it is lost, or the loss has serious consequences." , "Attack code is reliable and widely available, or no code is needed." , "Catastrophic loss." , "More than about three quarters of systems." , "Much work, or a long outage." , "Only under unusual, hard-to-arrange conditions." , "Success depends on conditions the attacker must overcome or wait for." , "The rating below critical." ;
	linkml:meaning "spdx_security:CvssSeverityType/high"^^xsd:anyURI .
<https://w3id.org/lmodel/cve/IRRECOVERABLE> linkml:description "The system cannot be restored." .
<https://w3id.org/lmodel/cve/LOCAL> linkml:description "Only by acting on the system itself, directly or through a user." , "Only with an account on the system or hands on it." .
<https://w3id.org/lmodel/cve/LOW> linkml:description "A loss would have limited effect." , "Little work, such as reading advice or a small configuration change." , "Ordinary user access." , "Slight loss." , "Some is lost, with limited consequences." , "The attacker can succeed again and again with no special effort." , "The lowest rating above none." , "Up to about a quarter of systems." , "With no special conditions." ;
	linkml:meaning "spdx_security:CvssSeverityType/low"^^xsd:anyURI .
<https://w3id.org/lmodel/cve/LOW_MEDIUM> linkml:description "Moderate loss." .
<https://w3id.org/lmodel/cve/MEDIUM> linkml:description "A loss would have serious effect." , "About a quarter to three quarters of systems." , "The middle rating." , "Under conditions that take some arranging." ;
	linkml:meaning "spdx_security:CvssSeverityType/medium"^^xsd:anyURI .
<https://w3id.org/lmodel/cve/MEDIUM_HIGH> linkml:description "Significant loss." .
<https://w3id.org/lmodel/cve/MODERATE> linkml:description "Some work, with a noticeable effect on the service." .
<https://w3id.org/lmodel/cve/MULTIPLE> linkml:description "More than one login." .
<https://w3id.org/lmodel/cve/NEGLIGIBLE> linkml:description "Any harm to people would be slight at most." .
<https://w3id.org/lmodel/cve/NETWORK> linkml:description "From anywhere that can route to the system." .
<https://w3id.org/lmodel/cve/NO> linkml:description "At least one step resists automation." .
<https://w3id.org/lmodel/cve/NONE> linkml:description "No access at all." , "No login at all." , "No severity at all, for a score of 0." , "No such loss." , "No systems at all, or only in a lab." , "Nothing is lost." , "The attack needs nobody else." , "The attack works whatever the target's state." ;
	linkml:meaning "spdx_security:CvssSeverityType/none"^^xsd:anyURI .
<https://w3id.org/lmodel/cve/NOT_DEFINED> linkml:description "The scorer gave no value, so the base metric stands." , "The scorer gave no value, so the metric does not change the score." , "The scorer gave no value, so the worst case is assumed." , "The scorer gave no value." .
<https://w3id.org/lmodel/cve/OFFICIAL_FIX> linkml:description "The vendor offers a complete fix." .
<https://w3id.org/lmodel/cve/OR> linkml:description "At least one of the parts must hold." .
<https://w3id.org/lmodel/cve/PARTIAL> linkml:description "Some is lost, and the attacker cannot choose all of it." .
<https://w3id.org/lmodel/cve/PASSIVE> linkml:description "Someone has to act only in the ordinary course of their work." .
<https://w3id.org/lmodel/cve/PHYSICAL> linkml:description "Only by touching the hardware." .
<https://w3id.org/lmodel/cve/PRESENT> linkml:description "People could be seriously hurt." , "The attack works only when the target is in a certain state." .
<https://w3id.org/lmodel/cve/PROOF_OF_CONCEPT> linkml:description "A demonstration exists that needs skilled work to use." , "A demonstration is public, with no reported attack." .
<https://w3id.org/lmodel/cve/PUBLISHED> linkml:description "The assigning authority has filled the record in and made it public." .
<https://w3id.org/lmodel/cve/REASONABLE> linkml:description "Solid details exist, without full confirmation of the cause." .
<https://w3id.org/lmodel/cve/RED> linkml:description "The supplier says the flaw is at the highest urgency." .
<https://w3id.org/lmodel/cve/REJECTED> linkml:description "The identifier and its record are withdrawn from use." .
<https://w3id.org/lmodel/cve/REQUIRED> linkml:description "Someone other than the attacker has to do something." .
<https://w3id.org/lmodel/cve/Recovery> a linkml:SlotDefinition ;
	linkml:annotations _:c14n175 ;
	linkml:description "How the affected system comes back after an attack." ;
	linkml:ifabsent "CvssV4Recovery(NOT_DEFINED)" ;
	linkml:range <https://w3id.org/lmodel/cve/CvssV4Recovery> .
<https://w3id.org/lmodel/cve/SAFETY> linkml:description "The loss could injure people." .
<https://w3id.org/lmodel/cve/SINGLE> linkml:description "One login." .
<https://w3id.org/lmodel/cve/Safety> a linkml:SlotDefinition ;
	linkml:annotations _:c14n295 ;
	linkml:description "Whether an attack could put people's safety at risk." ;
	linkml:ifabsent "CvssV4Safety(NOT_DEFINED)" ;
	linkml:range <https://w3id.org/lmodel/cve/CvssV4Safety> .
<https://w3id.org/lmodel/cve/TEMPORARY_FIX> linkml:description "The vendor offers a stopgap for now." .
<https://w3id.org/lmodel/cve/UNAVAILABLE> linkml:description "No fix exists, or it cannot be applied." .
<https://w3id.org/lmodel/cve/UNCHANGED> linkml:description "The harm stays within the same security authority." .
<https://w3id.org/lmodel/cve/UNCONFIRMED> linkml:description "A single report or conflicting reports that nobody has checked." .
<https://w3id.org/lmodel/cve/UNCORROBORATED> linkml:description "Several unofficial sources agree, with some doubt remaining." .
<https://w3id.org/lmodel/cve/UNKNOWN> linkml:description "Reports say something is wrong, but the cause is not clear." .
<https://w3id.org/lmodel/cve/UNPROVEN> linkml:description "No attack code is known, or the attack is only theory." .
<https://w3id.org/lmodel/cve/UNREPORTED> linkml:description "No demonstration or attack has been reported." .
<https://w3id.org/lmodel/cve/USER> linkml:description "Someone has to step in and restore it." .
<https://w3id.org/lmodel/cve/WORKAROUND> linkml:description "Others offer a way round the flaw that is not from the vendor." .
<https://w3id.org/lmodel/cve/YES> linkml:description "Every step can be automated." .
<https://w3id.org/lmodel/cve/accessComplexity> a linkml:SlotDefinition ;
	skos:closeMatch "sepses_cvss:accessComplexity"^^xsd:anyURI ;
	linkml:annotations _:c14n438 ;
	linkml:description "How hard the flaw is to use once the attacker can reach it." ;
	linkml:range <https://w3id.org/lmodel/cve/CvssV2AccessComplexity> .
<https://w3id.org/lmodel/cve/accessVector> a linkml:SlotDefinition ;
	skos:closeMatch "sepses_cvss:accessVector"^^xsd:anyURI ;
	linkml:annotations _:c14n416 ;
	linkml:description "How far away an attacker can be when using the flaw, in CVSS 2.0's terms." ;
	linkml:range <https://w3id.org/lmodel/cve/CvssV2AccessVector> .
<https://w3id.org/lmodel/cve/adp> a linkml:SlotDefinition ;
	linkml:annotations _:c14n377 ;
	linkml:description "The containers added by Authorized Data Publishers." ;
	linkml:inlined_as_list true ;
	linkml:list_elements_unique true ;
	linkml:minimum_cardinality 1 ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/cve/CveAdpContainer> .
