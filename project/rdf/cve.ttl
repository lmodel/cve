<https://w3id.org/lmodel/cve/cve_cpe22and23> a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/cve/cve_record"^^xsd:anyURI ;
	skos:note "The upstream's pattern has no anchors, and it allows 1 to 2048 characters. tests/cve_rules.py checks the length." ;
	linkml:annotations _:c14n512 ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/cve/CveCpe22and23"^^xsd:anyURI ;
	linkml:description "A Common Platform Enumeration name in the form of version 2.2 or 2.3." ;
	linkml:pattern "([c][pP][eE]:/[AHOaho]?(:[A-Za-z0-9._\\-~%]*){0,6})|(cpe:2\\.3:[aho*\\-](:(((\\?*|\\*?)([a-zA-Z0-9\\-._]|(\\\\[\\\\*?!\"#$%&'()+,/:;<=>@\\[\\]\\^`{|}~]))+(\\?*|\\*?))|[*\\-])){5}(:(([a-zA-Z]{2,3}(-([a-zA-Z]{2}|[0-9]{3}))?)|[*\\-]))(:(((\\?*|\\*?)([a-zA-Z0-9\\-._]|(\\\\[\\\\*?!\"#$%&'()+,/:;<=>@\\[\\]\\^`{|}~]))+(\\?*|\\*?))|[*\\-])){4})" ;
	linkml:typeof <https://w3id.org/lmodel/cve/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/cve/cve_cpe23> a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/cve/cve_record"^^xsd:anyURI ;
	skos:note "The upstream's pattern has no anchors, and it allows 1 to 2048 characters. tests/cve_rules.py checks the length." ;
	linkml:annotations _:c14n270 ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/cve/CveCpe23"^^xsd:anyURI ;
	linkml:description "A Common Platform Enumeration name in the form of version 2.3." ;
	linkml:pattern "(cpe:2\\.3:[aho*\\-](:(((\\?*|\\*?)([a-zA-Z0-9\\-._]|(\\\\[\\\\*?!\"#$%&'()+,/:;<=>@\\[\\]\\^`{|}~]))+(\\?*|\\*?))|[*\\-])){5}(:(([a-zA-Z]{2,3}(-([a-zA-Z]{2}|[0-9]{3}))?)|[*\\-]))(:(((\\?*|\\*?)([a-zA-Z0-9\\-._]|(\\\\[\\\\*?!\"#$%&'()+,/:;<=>@\\[\\]\\^`{|}~]))+(\\?*|\\*?))|[*\\-])){4})" ;
	linkml:typeof <https://w3id.org/lmodel/cve/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/cve/cve_data_version> a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/cve/cve_record"^^xsd:anyURI ;
	linkml:annotations _:c14n503 ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/cve/CveDataVersion"^^xsd:anyURI ;
	linkml:description "The version of the record format that a record follows, such as 5.1." ;
	linkml:pattern "^5\\.(0|[1-9][0-9]*)(\\.(0|[1-9][0-9]*))?$" ;
	linkml:typeof <https://w3id.org/lmodel/cve/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/cve/cve_datestamp> a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/cve/cve_record"^^xsd:anyURI ;
	skos:note "The upstream defines this and uses it nowhere, so no slot ranges over it." ;
	linkml:annotations _:c14n187 ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/cve/CveDatestamp"^^xsd:anyURI ;
	linkml:description "A calendar date, such as 2021-12-10." ;
	linkml:pattern "^((2000|2400|2800|(19|2[0-9](0[48]|[2468][048]|[13579][26])))-02-29)|(((19|2[0-9])[0-9]{2})-02-(0[1-9]|1[0-9]|2[0-8]))|(((19|2[0-9])[0-9]{2})-(0[13578]|10|12)-(0[1-9]|[12][0-9]|3[01]))|(((19|2[0-9])[0-9]{2})-(0[469]|11)-(0[1-9]|[12][0-9]|30))$" ;
	linkml:typeof <https://w3id.org/lmodel/cve/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#date"^^xsd:anyURI .
<https://w3id.org/lmodel/cve/cve_english_language> a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/cve/cve_record"^^xsd:anyURI ;
	linkml:annotations _:c14n523 ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/cve/CveEnglishLanguage"^^xsd:anyURI ;
	linkml:description "A language tag for English, such as en or en-US." ;
	linkml:pattern "^en([_-][A-Za-z]{4})?([_-]([A-Za-z]{2}|[0-9]{3}))?$" ;
	linkml:typeof <https://w3id.org/lmodel/cve/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#language"^^xsd:anyURI .
<https://w3id.org/lmodel/cve/cve_identifier> a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/cve/cve_record"^^xsd:anyURI ;
	linkml:annotations _:c14n363 ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/cve/CveIdentifier"^^xsd:anyURI ;
	linkml:description "A CVE identifier, such as CVE-2021-44228." ;
	linkml:pattern "^CVE-[0-9]{4}-[0-9]{4,19}$" ;
	linkml:typeof <https://w3id.org/lmodel/cve/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/cve/cve_language> a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/cve/cve_record"^^xsd:anyURI ;
	linkml:annotations _:c14n56 ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/cve/CveLanguage"^^xsd:anyURI ;
	linkml:description "A language tag, such as en or pt-BR." ;
	linkml:pattern "^[A-Za-z]{2,4}([_-][A-Za-z]{4})?([_-]([A-Za-z]{2}|[0-9]{3}))?$" ;
	linkml:typeof <https://w3id.org/lmodel/cve/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#language"^^xsd:anyURI .
<https://w3id.org/lmodel/cve/cve_short_name> a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/cve/cve_record"^^xsd:anyURI ;
	linkml:annotations _:c14n321 ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/cve/CveShortName"^^xsd:anyURI ;
	linkml:description "An organisation's short name of 2 to 32 characters." ;
	linkml:pattern "^[\\s\\S]{2,32}$" ;
	linkml:typeof <https://w3id.org/lmodel/cve/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/cve/cve_tag_extension> a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/cve/cve_record"^^xsd:anyURI ;
	skos:note "The upstream also allows it 2 to 128 characters. tests/cve_rules.py checks the length." ;
	linkml:annotations _:c14n98 ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/cve/CveTagExtension"^^xsd:anyURI ;
	linkml:description "A tag of the publisher's own, beginning x_." ;
	linkml:pattern "^x_.*$" ;
	linkml:typeof <https://w3id.org/lmodel/cve/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/cve/cve_text_1024> a linkml:TypeDefinition ;
	skos:inScheme "https://w3id.org/lmodel/cve/cve_record"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/lmodel/cve/CveText1024"^^xsd:anyURI ;
	linkml:description "Text of 1 to 1024 characters." ;
	linkml:pattern "^[\\s\\S]{1,1024}$" ;
	linkml:typeof <https://w3id.org/lmodel/cve/string> ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/cve/cve_text_128> a linkml:TypeDefinition ;
