<https://w3id.org/lmodel/cve/cweId> a linkml:SlotDefinition ;
	skos:closeMatch "wdt:P3624"^^xsd:anyURI ;
	skos:note "The upstream also allows it 5 to 9 characters. tests/cve_rules.py checks the length." , "Wikidata's P3624 holds the CWE number alone, without the CWE- prefix the format writes, so it is close." ;
	linkml:annotations _:c14n318 ;
	linkml:description "The Common Weakness Enumeration identifier that best fits, such as CWE-79." ;
	linkml:pattern "^CWE-[1-9][0-9]*$" .
