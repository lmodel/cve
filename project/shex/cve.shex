# metamodel_version: 1.12.0
# version: 5.2.0
BASE <https://w3id.org/lmodel/cve/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX linkml: <https://w3id.org/linkml/>


linkml:String xsd:string

linkml:Integer xsd:integer

linkml:Boolean xsd:boolean

linkml:Float xsd:float

linkml:Double xsd:double

linkml:Decimal xsd:decimal

linkml:Time xsd:time

linkml:Date xsd:date

linkml:Datetime xsd:dateTime

linkml:DateOrDatetime linkml:DateOrDatetime

linkml:Uriorcurie IRI

linkml:Curie xsd:string

linkml:Uri IRI

linkml:Ncname xsd:string

linkml:Objectidentifier IRI

linkml:Nodeidentifier NONLITERAL

linkml:Jsonpointer xsd:string

linkml:Jsonpath xsd:string

linkml:Sparqlpath xsd:string

<CveUri> IRI

<CveUuid> xsd:string

<CveIdentifier> xsd:string

<CveCpe22and23> xsd:string

<CveCpe23> xsd:string

<CveShortName> xsd:string

<CveDatestamp> xsd:date

<CveTimestamp> xsd:dateTime

<CveVersion> xsd:string

<CveDataVersion> xsd:string

<CveLanguage> xsd:language

<CveEnglishLanguage> xsd:language

<CveTagExtension> xsd:string

<CveText64> xsd:string

<CveText128> xsd:string

<CveText256> xsd:string

<CveText512> xsd:string

<CveText1024> xsd:string

<CveShortText1024> xsd:string

<CveText2048> xsd:string

<CveText4096> xsd:string

<CveText16384> xsd:string

<CveAdpContainer> CLOSED {
    (  $<CveAdpContainer_tes> (  <providerMetadata> @<CveProviderMetadata> ;
          <datePublic> @<CveTimestamp> ? ;
          <title> @<CveText256> ? ;
          <descriptions> @<CveDescription> * ;
          <affected> @<CveProduct> * ;
          <cpeApplicability> @<CveCpeApplicabilityElement> * ;
          <problemTypes> @<CveProblemType> * ;
          <references> @<CveReference> * ;
          <impacts> @<CveImpact> * ;
          <metrics> @<CveMetric> * ;
          <configurations> @<CveDescription> * ;
          <workarounds> @<CveDescription> * ;
          <solutions> @<CveDescription> * ;
          <exploits> @<CveDescription> * ;
          <timeline> @<CveTimelineEvent> * ;
          <credits> @<CveCredit> * ;
          <source> @<CveSource> ? ;
          <tags> @linkml:String * ;
          <taxonomyMappings> @<CveTaxonomyMapping> *
       ) ;
       rdf:type [ <CveAdpContainer> ] ?
    )
}

<CveCnaContainer>  (
    @<CveCnaPublishedContainer> OR @<CveCnaRejectedContainer>
)

<CveCnaContainer_struct> {
    (  $<CveCnaContainer_tes> <providerMetadata> @<CveProviderMetadata> ;
       rdf:type [ <CveCnaContainer> ] ?
    )
}

<CveCnaPublishedContainer> CLOSED {
    (  $<CveCnaPublishedContainer_tes> (  &<CveCnaContainer_tes> ;
          rdf:type [ <CveCnaContainer> ] ? ;
          <datePublic> @<CveTimestamp> ? ;
          <title> @<CveText256> ? ;
          <descriptions> @<CveDescription> + ;
          <affected> @<CveProduct> + ;
          <cpeApplicability> @<CveCpeApplicabilityElement> * ;
          <problemTypes> @<CveProblemType> * ;
          <references> @<CveReference> + ;
          <impacts> @<CveImpact> * ;
          <metrics> @<CveMetric> * ;
          <configurations> @<CveDescription> * ;
          <workarounds> @<CveDescription> * ;
          <solutions> @<CveDescription> * ;
          <exploits> @<CveDescription> * ;
          <timeline> @<CveTimelineEvent> * ;
          <credits> @<CveCredit> * ;
          <source> @<CveSource> ? ;
          <tags> @linkml:String * ;
          <taxonomyMappings> @<CveTaxonomyMapping> * ;
          <dateAssigned> @<CveTimestamp> ?
       ) ;
       rdf:type [ <CveCnaPublishedContainer> ] ?
    )
}

<CveCnaRejectedContainer> CLOSED {
    (  $<CveCnaRejectedContainer_tes> (  &<CveCnaContainer_tes> ;
          rdf:type [ <CveCnaContainer> ] ? ;
          <rejectedReasons> @<CveDescription> + ;
          <replacedBy> @<CveIdentifier> *
       ) ;
       rdf:type [ <CveCnaRejectedContainer> ] ?
    )
}

<CveContainers>  (
    @<CvePublishedContainers> OR @<CveRejectedContainers>
)

<CveContainers_struct> {
    (  $<CveContainers_tes> <cna> @<CveCnaContainer> ;
       rdf:type [ <CveContainers> ] ?
    )
}

<CveCpeApplicabilityElement> CLOSED {
    (  $<CveCpeApplicabilityElement_tes> (  <operator> [ <https://w3id.org/lmodel/cve/CveCpeOperator#AND>
             <https://w3id.org/lmodel/cve/CveCpeOperator#OR> ] ? ;
          <negate> @linkml:Boolean ? ;
          <nodes> @<CveCpeNode> +
       ) ;
       rdf:type [ <CveCpeApplicabilityElement> ] ?
    )
}

<CveCpeMatch> CLOSED {
    (  $<CveCpeMatch_tes> (  <vulnerable> @linkml:Boolean ;
          <criteria> @<CveCpe23> ;
          <matchCriteriaId> @<CveUuid> ? ;
          <versionStartExcluding> @<CveVersion> ? ;
          <versionStartIncluding> @<CveVersion> ? ;
          <versionEndExcluding> @<CveVersion> ? ;
          <versionEndIncluding> @<CveVersion> ?
       ) ;
       rdf:type [ <CveCpeMatch> ] ?
    )
}

<CveCpeNode> CLOSED {
    (  $<CveCpeNode_tes> (  <operator> [ <https://w3id.org/lmodel/cve/CveCpeOperator#AND>
             <https://w3id.org/lmodel/cve/CveCpeOperator#OR> ] ;
          <negate> @linkml:Boolean ? ;
          <cpeMatch> @<CveCpeMatch> +
       ) ;
       rdf:type [ <CveCpeNode> ] ?
    )
}

<CveCredit> CLOSED {
    (  $<CveCredit_tes> (  <lang> @<CveLanguage> ;
          <value> @<CveText4096> ;
          <type> [ <https://w3id.org/lmodel/cve/CveCreditType#finder> <https://w3id.org/lmodel/cve/CveCreditType#reporter>
             <https://w3id.org/lmodel/cve/CveCreditType#analyst> <https://w3id.org/lmodel/cve/CveCreditType#coordinator>
             <https://w3id.org/lmodel/cve/CveCreditType#remediation%20developer>
             <https://w3id.org/lmodel/cve/CveCreditType#remediation%20reviewer>
             <https://w3id.org/lmodel/cve/CveCreditType#remediation%20verifier> <https://w3id.org/lmodel/cve/CveCreditType#tool>
             <https://w3id.org/lmodel/cve/CveCreditType#sponsor> <https://w3id.org/lmodel/cve/CveCreditType#other> ] ? ;
          <user> @<CveUuid> ?
       ) ;
       rdf:type [ <CveCredit> ] ?
    )
}

<CveDescription> CLOSED {
    (  $<CveDescription_tes> (  <lang> @<CveLanguage> ;
          <value> @<CveText4096> ;
          <supportingMedia> @<CveSupportingMedia> *
       ) ;
       rdf:type [ <CveDescription> ] ?
    )
}

<CveImpact> CLOSED {
    (  $<CveImpact_tes> (  <descriptions> @<CveDescription> + ;
          <capecId> @linkml:String ?
       ) ;
       rdf:type [ <CveImpact> ] ?
    )
}

<CveMetadataPublished> CLOSED {
    (  $<CveMetadataPublished_tes> (  &<CveRecordMetadata_tes> ;
          rdf:type [ <CveRecordMetadata> ] ? ;
          <requesterUserId> @<CveUuid> ? ;
          <state> [ <https://w3id.org/lmodel/cve/CvePublishedState#PUBLISHED> ]
       ) ;
       rdf:type [ <CveMetadataPublished> ] ?
    )
}

<CveMetadataRejected> CLOSED {
    (  $<CveMetadataRejected_tes> (  &<CveRecordMetadata_tes> ;
          rdf:type [ <CveRecordMetadata> ] ? ;
          <dateRejected> @<CveTimestamp> ? ;
          <state> [ <https://w3id.org/lmodel/cve/CveRejectedState#REJECTED> ]
       ) ;
       rdf:type [ <CveMetadataRejected> ] ?
    )
}

<CveMetric> CLOSED {
    (  $<CveMetric_tes> (  <format> @<CveText64> ? ;
          <scenarios> @<CveMetricScenario> * ;
          <cvssV4_0> @<CvssV40> ? ;
          <cvssV3_1> @<CvssV31> ? ;
          <cvssV3_0> @<CvssV30> ? ;
          <cvssV2_0> @<CvssV20> ? ;
          <other> @<CveOtherMetric> ?
       ) ;
       rdf:type [ <CveMetric> ] ?
    )
}

<CveMetricScenario> CLOSED {
    (  $<CveMetricScenario_tes> (  <lang> @<CveLanguage> ;
          <value> @<CveText4096>
       ) ;
       rdf:type [ <CveMetricScenario> ] ?
    )
}

<CveOtherMetric> CLOSED {
    (  $<CveOtherMetric_tes> (  <type> @<CveText128> ;
          <content> @<CveOtherMetricContent>
       ) ;
       rdf:type [ <CveOtherMetric> ] ?
    )
}

<CveOtherMetricContent> CLOSED {
    (  $<CveOtherMetricContent_tes> rdf:type . * ;
       rdf:type [ <CveOtherMetricContent> ] ?
    )
}

<CveProblemType> CLOSED {
    (  $<CveProblemType_tes> <descriptions> @<CveProblemTypeDescription> + ;
       rdf:type [ <CveProblemType> ] ?
    )
}

<CveProblemTypeDescription> CLOSED {
    (  $<CveProblemTypeDescription_tes> (  <lang> @<CveLanguage> ;
          <description> @<CveText4096> ;
          <type> @<CveText128> ? ;
          <references> @<CveReference> * ;
          <cweId> @linkml:String ?
       ) ;
       rdf:type [ <CveProblemTypeDescription> ] ?
    )
}

<CveProduct> CLOSED {
    (  $<CveProduct_tes> (  <vendor> @<CveText512> ? ;
          <product> @<CveText2048> ? ;
          <collectionURL> @<CveUri> ? ;
          <packageName> @<CveText2048> ? ;
          <packageURL> @<CveUri> ? ;
          <cpes> @<CveCpe22and23> * ;
          <modules> @<CveText4096> * ;
          <programFiles> @<CveText1024> * ;
          <programRoutines> @<CveProgramRoutine> * ;
          <platforms> @<CveShortText1024> * ;
          <repo> @<CveUri> ? ;
          <defaultStatus> [ <https://w3id.org/lmodel/cve/CveVersionStatus#affected>
             <https://w3id.org/lmodel/cve/CveVersionStatus#unaffected> <https://w3id.org/lmodel/cve/CveVersionStatus#unknown> ] ? ;
          <versions> @<CveProductVersion> *
       ) ;
       rdf:type [ <CveProduct> ] ?
    )
}

<CveProductVersion> CLOSED {
    (  $<CveProductVersion_tes> (  <version> @<CveVersion> ;
          <status> [ <https://w3id.org/lmodel/cve/CveVersionStatus#affected>
             <https://w3id.org/lmodel/cve/CveVersionStatus#unaffected> <https://w3id.org/lmodel/cve/CveVersionStatus#unknown> ] ;
          <versionType> @<CveText128> ? ;
          <lessThan> @<CveVersion> ? ;
          <lessThanOrEqual> @<CveVersion> ? ;
          <changes> @<CveVersionChange> *
       ) ;
       rdf:type [ <CveProductVersion> ] ?
    )
}

<CveProgramRoutine> CLOSED {
    (  $<CveProgramRoutine_tes> <name> @<CveText4096> ;
       rdf:type [ <CveProgramRoutine> ] ?
    )
}

<CveProviderMetadata> CLOSED {
    (  $<CveProviderMetadata_tes> (  <dateUpdated> @<CveTimestamp> ? ;
          <orgId> @<CveUuid> ;
          <shortName> @<CveShortName> ?
       ) ;
       rdf:type [ <CveProviderMetadata> ] ?
    )
}

<CvePublishedContainers> CLOSED {
    (  $<CvePublishedContainers_tes> (  &<CveContainers_tes> ;
          rdf:type [ <CveContainers> ] ? ;
          <adp> @<CveAdpContainer> * ;
          <cna> @<CveCnaPublishedContainer>
       ) ;
       rdf:type [ <CvePublishedContainers> ] ?
    )
}

<CvePublishedRecord> CLOSED {
    (  $<CvePublishedRecord_tes> (  &<CveRecord_tes> ;
          rdf:type [ <CveRecord> ] ? ;
          <cveMetadata> @<CveMetadataPublished> ;
          <containers> @<CvePublishedContainers>
       ) ;
       rdf:type [ <CvePublishedRecord> ] ?
    )
}

<CveRecord>  (
    @<CvePublishedRecord> OR @<CveRejectedRecord>
)

<CveRecord_struct> {
    (  $<CveRecord_tes> (  <cveMetadata> @<CveRecordMetadata> ;
          <containers> @<CveContainers> ;
          <dataType> [ <https://w3id.org/lmodel/cve/CveDataType#CVE_RECORD> ] ;
          <dataVersion> @<CveDataVersion>
       ) ;
       rdf:type [ <CveRecord> ] ?
    )
}

<CveRecordMetadata>  (
    @<CveMetadataPublished> OR @<CveMetadataRejected>
)

<CveRecordMetadata_struct> {
    (  $<CveRecordMetadata_tes> (  <dateUpdated> @<CveTimestamp> ? ;
          <state> [ <https://w3id.org/lmodel/cve/CveRecordState#PUBLISHED> <https://w3id.org/lmodel/cve/CveRecordState#REJECTED> ]
          ;
          <cveId> @<CveIdentifier> ;
          <assignerOrgId> @<CveUuid> ;
          <assignerShortName> @<CveShortName> ? ;
          <serial> @linkml:Integer ? ;
          <dateReserved> @<CveTimestamp> ? ;
          <datePublished> @<CveTimestamp> ?
       ) ;
       rdf:type [ <CveRecordMetadata> ] ?
    )
}

<CveRecordRoot> CLOSED {
    (  $<CveRecordRoot_tes> rdf:type . * ;
       rdf:type [ <CveRecordRoot> ] ?
    )
}

<CveReference> CLOSED {
    (  $<CveReference_tes> (  <url> @<CveUri> ;
          <name> @<CveText512> ? ;
          <tags> @linkml:String *
       ) ;
       rdf:type [ <CveReference> ] ?
    )
}

<CveRejectedContainers> CLOSED {
    (  $<CveRejectedContainers_tes> (  &<CveContainers_tes> ;
          rdf:type [ <CveContainers> ] ? ;
          <cna> @<CveCnaRejectedContainer>
       ) ;
       rdf:type [ <CveRejectedContainers> ] ?
    )
}

<CveRejectedRecord> CLOSED {
    (  $<CveRejectedRecord_tes> (  &<CveRecord_tes> ;
          rdf:type [ <CveRecord> ] ? ;
          <cveMetadata> @<CveMetadataRejected> ;
          <containers> @<CveRejectedContainers>
       ) ;
       rdf:type [ <CveRejectedRecord> ] ?
    )
}

<CveSource> CLOSED {
    (  $<CveSource_tes> rdf:type . * ;
       rdf:type [ <CveSource> ] ?
    )
}

<CveSupportingMedia> CLOSED {
    (  $<CveSupportingMedia_tes> (  <type> @<CveText256> ;
          <value> @<CveText16384> ;
          <base64> @linkml:Boolean ?
       ) ;
       rdf:type [ <CveSupportingMedia> ] ?
    )
}

<CveTaxonomyMapping> CLOSED {
    (  $<CveTaxonomyMapping_tes> (  <taxonomyName> @<CveText128> ;
          <taxonomyVersion> @<CveText128> ? ;
          <taxonomyRelations> @<CveTaxonomyRelation> +
       ) ;
       rdf:type [ <CveTaxonomyMapping> ] ?
    )
}

<CveTaxonomyRelation> CLOSED {
    (  $<CveTaxonomyRelation_tes> (  <taxonomyId> @<CveText2048> ;
          <relationshipName> @<CveText128> ;
          <relationshipValue> @<CveText2048>
       ) ;
       rdf:type [ <CveTaxonomyRelation> ] ?
    )
}

<CveTimelineEvent> CLOSED {
    (  $<CveTimelineEvent_tes> (  <lang> @<CveLanguage> ;
          <value> @<CveText4096> ;
          <time> @<CveTimestamp>
       ) ;
       rdf:type [ <CveTimelineEvent> ] ?
    )
}

<CveVersionChange> CLOSED {
    (  $<CveVersionChange_tes> (  <at> @<CveVersion> ;
          <status> [ <https://w3id.org/lmodel/cve/CveVersionStatus#affected>
             <https://w3id.org/lmodel/cve/CveVersionStatus#unaffected> <https://w3id.org/lmodel/cve/CveVersionStatus#unknown> ]
       ) ;
       rdf:type [ <CveVersionChange> ] ?
    )
}

<CvssSeverityBandsMixin> {
    (  $<CvssSeverityBandsMixin_tes> (  <baseScore> @linkml:Float ;
          <baseSeverity> [ <https://spdx.org/rdf/3.0.1/terms/Security/CvssSeverityType/none>
             <https://spdx.org/rdf/3.0.1/terms/Security/CvssSeverityType/low>
             <https://spdx.org/rdf/3.0.1/terms/Security/CvssSeverityType/medium>
             <https://spdx.org/rdf/3.0.1/terms/Security/CvssSeverityType/high>
             <https://spdx.org/rdf/3.0.1/terms/Security/CvssSeverityType/critical> ]
       ) ;
       rdf:type [ <CvssSeverityBandsMixin> ] ?
    )
}

<CvssV20> CLOSED {
    (  $<CvssV20_tes> (  <version> @linkml:String ;
          <vectorString> @linkml:String ;
          <baseScore> @linkml:Float ;
          <confidentialityImpact> [ <https://w3id.org/lmodel/cve/CvssV2Impact#NONE>
             <https://w3id.org/lmodel/cve/CvssV2Impact#PARTIAL> <https://w3id.org/lmodel/cve/CvssV2Impact#COMPLETE> ] ? ;
          <integrityImpact> [ <https://w3id.org/lmodel/cve/CvssV2Impact#NONE> <https://w3id.org/lmodel/cve/CvssV2Impact#PARTIAL>
             <https://w3id.org/lmodel/cve/CvssV2Impact#COMPLETE> ] ? ;
          <availabilityImpact> [ <https://w3id.org/lmodel/cve/CvssV2Impact#NONE> <https://w3id.org/lmodel/cve/CvssV2Impact#PARTIAL>
             <https://w3id.org/lmodel/cve/CvssV2Impact#COMPLETE> ] ? ;
          <remediationLevel> [ <https://w3id.org/lmodel/cve/CvssRemediationLevel#OFFICIAL_FIX>
             <https://w3id.org/lmodel/cve/CvssRemediationLevel#TEMPORARY_FIX>
             <https://w3id.org/lmodel/cve/CvssRemediationLevel#WORKAROUND>
             <https://w3id.org/lmodel/cve/CvssRemediationLevel#UNAVAILABLE>
             <https://w3id.org/lmodel/cve/CvssRemediationLevel#NOT_DEFINED> ] ? ;
          <reportConfidence> [ <https://w3id.org/lmodel/cve/CvssV2ReportConfidence#UNCONFIRMED>
             <https://w3id.org/lmodel/cve/CvssV2ReportConfidence#UNCORROBORATED>
             <https://w3id.org/lmodel/cve/CvssV2ReportConfidence#CONFIRMED>
             <https://w3id.org/lmodel/cve/CvssV2ReportConfidence#NOT_DEFINED> ] ? ;
          <temporalScore> @linkml:Float ? ;
          <confidentialityRequirement> [ <https://w3id.org/lmodel/cve/CvssRequirement#LOW>
             <https://w3id.org/lmodel/cve/CvssRequirement#MEDIUM> <https://w3id.org/lmodel/cve/CvssRequirement#HIGH>
             <https://w3id.org/lmodel/cve/CvssRequirement#NOT_DEFINED> ] ? ;
          <integrityRequirement> [ <https://w3id.org/lmodel/cve/CvssRequirement#LOW>
             <https://w3id.org/lmodel/cve/CvssRequirement#MEDIUM> <https://w3id.org/lmodel/cve/CvssRequirement#HIGH>
             <https://w3id.org/lmodel/cve/CvssRequirement#NOT_DEFINED> ] ? ;
          <availabilityRequirement> [ <https://w3id.org/lmodel/cve/CvssRequirement#LOW>
             <https://w3id.org/lmodel/cve/CvssRequirement#MEDIUM> <https://w3id.org/lmodel/cve/CvssRequirement#HIGH>
             <https://w3id.org/lmodel/cve/CvssRequirement#NOT_DEFINED> ] ? ;
          <environmentalScore> @linkml:Float ? ;
          <accessVector> [ <https://w3id.org/lmodel/cve/CvssV2AccessVector#NETWORK>
             <https://w3id.org/lmodel/cve/CvssV2AccessVector#ADJACENT_NETWORK>
             <https://w3id.org/lmodel/cve/CvssV2AccessVector#LOCAL> ] ? ;
          <accessComplexity> [ <https://w3id.org/lmodel/cve/CvssV2AccessComplexity#HIGH>
             <https://w3id.org/lmodel/cve/CvssV2AccessComplexity#MEDIUM> <https://w3id.org/lmodel/cve/CvssV2AccessComplexity#LOW> ]
          ? ;
          <authentication> [ <https://w3id.org/lmodel/cve/CvssV2Authentication#MULTIPLE>
             <https://w3id.org/lmodel/cve/CvssV2Authentication#SINGLE> <https://w3id.org/lmodel/cve/CvssV2Authentication#NONE> ] ?
          ;
          <exploitability> [ <https://w3id.org/lmodel/cve/CvssExploitCodeMaturity#UNPROVEN>
             <https://w3id.org/lmodel/cve/CvssExploitCodeMaturity#PROOF_OF_CONCEPT>
             <https://w3id.org/lmodel/cve/CvssExploitCodeMaturity#FUNCTIONAL>
             <https://w3id.org/lmodel/cve/CvssExploitCodeMaturity#HIGH>
             <https://w3id.org/lmodel/cve/CvssExploitCodeMaturity#NOT_DEFINED> ] ? ;
          <collateralDamagePotential> [ <https://w3id.org/lmodel/cve/CvssV2CollateralDamagePotential#NONE>
             <https://w3id.org/lmodel/cve/CvssV2CollateralDamagePotential#LOW>
             <https://w3id.org/lmodel/cve/CvssV2CollateralDamagePotential#LOW_MEDIUM>
             <https://w3id.org/lmodel/cve/CvssV2CollateralDamagePotential#MEDIUM_HIGH>
             <https://w3id.org/lmodel/cve/CvssV2CollateralDamagePotential#HIGH>
             <https://w3id.org/lmodel/cve/CvssV2CollateralDamagePotential#NOT_DEFINED> ] ? ;
          <targetDistribution> [ <https://w3id.org/lmodel/cve/CvssV2TargetDistribution#NONE>
             <https://w3id.org/lmodel/cve/CvssV2TargetDistribution#LOW>
             <https://w3id.org/lmodel/cve/CvssV2TargetDistribution#MEDIUM>
             <https://w3id.org/lmodel/cve/CvssV2TargetDistribution#HIGH>
             <https://w3id.org/lmodel/cve/CvssV2TargetDistribution#NOT_DEFINED> ] ?
       ) ;
       rdf:type [ <CvssV20> ] ?
    )
}

<CvssV30> CLOSED {
    (  $<CvssV30_tes> (  &<CvssSeverityBandsMixin_tes> ;
          rdf:type [ <CvssSeverityBandsMixin> ] ? ;
          <version> @linkml:String ;
          <vectorString> @linkml:String ;
