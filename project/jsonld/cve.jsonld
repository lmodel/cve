      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "source_discovery",
      "definition_uri": "https://w3id.org/lmodel/cve/source_discovery",
      "annotations": [
        {
          "tag": "min_length",
          "value": 1,
          "@type": "Annotation"
        },
        {
          "tag": "max_length",
          "value": 4096,
          "@type": "Annotation"
        }
      ],
      "description": "How the vulnerability was discovered (e.g., INTERNAL, EXTERNAL, USER).",
