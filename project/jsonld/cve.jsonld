    {
      "name": "CveRecord",
      "definition_uri": "https://w3id.org/lmodel/cve/CveRecord",
      "annotations": [
        {
          "tag": "upstream_path",
          "value": "CVE_Record_Format.json#/oneOf",
          "@type": "Annotation"
        }
      ],
      "description": "A record of one vulnerability under one CVE identifier, in the CVE Program's format.",
      "comments": [
        "Its two kinds are told apart by cveMetadata's state, nested inside the record, so LinkML's type designator cannot choose between them. A reader picks the class from the state, or validates against CveRecordRoot.",
        "wd:Q631425 is the idea of a vulnerability, which a record describes and is not, so that mapping is only related. SEPSES, SPDX and STIX each have a class for the description of one vulnerability, so those are close."
      ],
      "from_schema": "https://w3id.org/lmodel/cve/cve_record",
      "close_mappings": [
        "sepses_cve:CVE",
        "spdx_security:Vulnerability",
        "stix:StixVulnerability"
      ],
      "related_mappings": [
        "wd:Q631425"
      ],
      "abstract": true,
      "slots": [
        "cveMetadata",
        "containers",
        "cveRecord__dataType",
        "cveRecord__dataVersion"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "dataType",
          "annotations": [
            {
              "tag": "upstream_path",
              "value": "CVE_Record_Format.json#/definitions/dataType",
              "@type": "Annotation"
            }
          ],
          "description": "The kind of document this is, which is always a CVE record.",
          "range": "CveDataType",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "dataVersion",
          "annotations": [
            {
              "tag": "upstream_path",
              "value": "CVE_Record_Format.json#/definitions/dataVersion",
              "@type": "Annotation"
            }
          ],
          "description": "The version of the record format that this record follows.",
          "comments": [
            "The upstream gives 5.2.0 as a default, which cannot apply to a required key."
          ],
          "range": "cve_data_version",
          "required": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/cve/CveRecord",
      "@type": "ClassDefinition"
    },
