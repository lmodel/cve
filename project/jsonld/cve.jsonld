      "aliases": [
        "capecId"
      ],
      "slot_uri": "https://w3id.org/lmodel/cve/capec_id",
      "owner": "ImpactEntry",
      "domain_of": [
        "ImpactEntry"
      ],
      "range": "string",
      "pattern": "^CAPEC-[1-9][0-9]{0,4}$",
      "@type": "SlotDefinition"
    },
    {
      "name": "impact_descriptions",
      "definition_uri": "https://w3id.org/lmodel/cve/impact_descriptions",
      "description": "Prose description of the impact scenario. At a minimum, provide the description given by CAPEC.",
      "from_schema": "https://w3id.org/lmodel/cve",
      "aliases": [
        "descriptions"
      ],
      "slot_uri": "https://w3id.org/lmodel/cve/impact_descriptions",
      "owner": "ImpactEntry",
      "domain_of": [
        "ImpactEntry"
      ],
      "range": "MultiLangDescription",
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "metric_format",
      "definition_uri": "https://w3id.org/lmodel/cve/metric_format",
      "annotations": [
        {
          "tag": "min_length",
          "value": 1,
          "@type": "Annotation"
        },
        {
          "tag": "max_length",
          "value": 64,
          "@type": "Annotation"
        }
      ],
      "description": "Name of the scoring format (e.g., cvssV4_0, cvssV3_1). Provides future-proofing and supports proprietary format inclusion.",
      "from_schema": "https://w3id.org/lmodel/cve",
      "aliases": [
        "format"
      ],
      "slot_uri": "https://w3id.org/lmodel/cve/metric_format",
      "owner": "MetricEntry",
      "domain_of": [
        "MetricEntry"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "metric_scenarios",
      "definition_uri": "https://w3id.org/lmodel/cve/metric_scenarios",
      "description": "Scenarios this metrics object applies to. If no specific scenario is given, GENERAL applies when no more specific metric matches.",
      "from_schema": "https://w3id.org/lmodel/cve",
      "aliases": [
        "scenarios"
      ],
      "slot_uri": "https://w3id.org/lmodel/cve/metric_scenarios",
      "owner": "MetricEntry",
      "domain_of": [
        "MetricEntry"
      ],
      "range": "MetricScenario",
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "scenario_value",
      "definition_uri": "https://w3id.org/lmodel/cve/scenario_value",
      "annotations": [
        {
          "tag": "min_length",
          "value": 1,
          "@type": "Annotation"
        },
        {
          "tag": "max_length",
          "value": 4096,
          "@type": "Annotation"
        }
      ],
      "description": "Description of the scenario this metrics object applies to.",
      "from_schema": "https://w3id.org/lmodel/cve",
      "aliases": [
        "value"
      ],
