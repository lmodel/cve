        },
        {
          "name": "vulnIntegrityImpact",
          "annotations": [
            {
              "tag": "upstream_path",
              "value": "imports/cvss/cvss-v4.0.json#/properties/vulnIntegrityImpact",
              "@type": "Annotation"
            }
          ],
          "description": "How much an attack could change in the vulnerable system.",
