    {
      "name": "CvssV20_version",
      "definition_uri": "https://w3id.org/lmodel/cve/version",
      "annotations": {
        "upstream_path": {
          "tag": "upstream_path",
          "value": "imports/cvss/cvss-v2.0.json#/properties/version imports/cvss/cvss-v3.0.json#/properties/version imports/cvss/cvss-v3.1.json#/properties/version imports/cvss/cvss-v4.0.json#/properties/version",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "A version string. On a score it is the CVSS version; on a product entry, the product's.",
      "comments": [
        "Each class that uses it narrows it. A top-level slot, so that lokf adapt renames it beside LOKF's version."
      ],
      "from_schema": "https://w3id.org/lmodel/cve/cve_cvss",
      "mappings": [
        "https://w3id.org/lmodel/cve/version"
      ],
      "is_a": "version",
      "domain": "CvssV20",
      "slot_uri": "https://w3id.org/lmodel/cve/version",
      "alias": "version",
      "owner": "CvssV20",
      "domain_of": [
        "CvssV20"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "version",
      "range": "string",
      "required": true,
      "equals_string": "2.0",
      "@type": "SlotDefinition"
    },
    {
      "name": "CvssV20_vectorString",
      "definition_uri": "https://w3id.org/lmodel/cve/vectorString",
      "annotations": {
        "upstream_path": {
          "tag": "upstream_path",
          "value": "imports/cvss/cvss-v2.0.json#/properties/vectorString imports/cvss/cvss-v3.0.json#/properties/vectorString imports/cvss/cvss-v3.1.json#/properties/vectorString imports/cvss/cvss-v4.0.json#/properties/vectorString",
          "extensions": {},
          "annotations": {}
        }
      },
      "description": "The scores' metric values written as one compact string.",
      "from_schema": "https://w3id.org/lmodel/cve/cve_cvss",
      "close_mappings": [
        "http://w3id.org/sepses/vocab/ref/cvss#vectorString",
        "https://spdx.org/rdf/3.0.1/terms/Security/vectorString"
      ],
      "is_a": "vectorString",
      "domain": "CvssV20",
      "slot_uri": "https://w3id.org/lmodel/cve/vectorString",
      "alias": "vectorString",
      "owner": "CvssV20",
      "domain_of": [
        "CvssV20"
      ],
      "is_usage_slot": true,
      "usage_slot_name": "vectorString",
      "range": "string",
      "required": true,
      "pattern": "^((AV:[NAL]|AC:[LMH]|Au:[MSN]|[CIA]:[NPC]|E:(U|POC|F|H|ND)|RL:(OF|TF|W|U|ND)|RC:(UC|UR|C|ND)|CDP:(N|L|LM|MH|H|ND)|TD:(N|L|M|H|ND)|[CIA]R:(L|M|H|ND))/)*(AV:[NAL]|AC:[LMH]|Au:[MSN]|[CIA]:[NPC]|E:(U|POC|F|H|ND)|RL:(OF|TF|W|U|ND)|RC:(UC|UR|C|ND)|CDP:(N|L|LM|MH|H|ND)|TD:(N|L|M|H|ND)|[CIA]R:(L|M|H|ND))$",
      "@type": "SlotDefinition"
    },
