      "from_schema": "https://w3id.org/lmodel/cve/cve_record",
      "slots": [
        "cveProduct__vendor",
        "cveProduct__product",
        "cveProduct__collectionURL",
        "cveProduct__packageName",
        "cveProduct__packageURL",
        "cveProduct__cpes",
        "cveProduct__modules",
        "cveProduct__programFiles",
        "cveProduct__programRoutines",
        "cveProduct__platforms",
        "cveProduct__repo",
        "cveProduct__defaultStatus",
        "cveProduct__versions"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "vendor",
          "annotations": [
            {
              "tag": "upstream_path",
              "value": "CVE_Record_Format.json#/definitions/product/properties/vendor",
              "@type": "Annotation"
            }
          ],
          "description": "Who makes or maintains the product. It can be N/A.",
          "range": "cve_text_512",
