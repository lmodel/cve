        {
          "tag": "max_length",
          "value": 1024,
          "@type": "Annotation"
        }
      ],
      "description": "A list of the affected source code files.",
      "from_schema": "https://w3id.org/lmodel/cve",
      "aliases": [
        "programFiles"
      ],
      "slot_uri": "https://w3id.org/lmodel/cve/program_files",
      "owner": "AffectedProduct",
