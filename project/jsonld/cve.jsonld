      "owner": "AdpContainer",
      "domain_of": [
        "CnaPublishedContainer",
        "AdpContainer"
      ],
      "range": "CreditEntry",
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "cna_source",
      "definition_uri": "https://w3id.org/lmodel/cve/cna_source",
