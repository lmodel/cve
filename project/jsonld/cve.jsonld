      "slot_uri": "https://w3id.org/lmodel/cve/cna",
      "owner": "Containers",
      "domain_of": [
        "Containers"
      ],
      "range": "CnaContainer",
      "inlined": true,
      "inlined_as_list": true,
      "any_of": [
        {
          "range": "CnaPublishedContainer",
          "@type": "AnonymousSlotExpression"
        },
        {
          "range": "CnaRejectedContainer",
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "adp",
      "definition_uri": "https://w3id.org/lmodel/cve/adp",
      "description": "One or more ADP containers providing additional vulnerability information. Multiple ADPs may contribute containers for the same CVE ID.",
      "from_schema": "https://w3id.org/lmodel/cve",
      "slot_uri": "https://w3id.org/lmodel/cve/adp",
      "owner": "Containers",
      "domain_of": [
