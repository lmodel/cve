        },
        {
          "name": "collectionURL",
          "annotations": [
            {
              "tag": "upstream_path",
              "value": "CVE_Record_Format.json#/definitions/product/properties/collectionURL",
              "@type": "Annotation"
            }
          ],
          "description": "The address of the package collection that gives packageName its meaning.",
          "range": "cve_uri",
