    {
      "name": "CnaPublishedContainer",
      "definition_uri": "https://w3id.org/lmodel/cve/CnaPublishedContainer",
      "description": "An object containing vulnerability information provided by a CVE Numbering Authority (CNA) for a published CVE ID. There can only be one CNA container per CVE record since there can only be one assigning CNA.",
      "from_schema": "https://w3id.org/lmodel/cve",
