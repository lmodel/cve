  "classes": [
    {
      "name": "CveRecordRoot",
      "definition_uri": "https://w3id.org/lmodel/cve/CveRecordRoot",
      "annotations": [
        {
          "tag": "upstream_path",
          "value": "CVE_Record_Format.json#/",
          "@type": "Annotation"
        }
      ],
      "description": "Any one CVE record, published or rejected, as a file or an API answer holds it.",
      "comments": [
        "It has no keys of its own, and a record must be exactly one of the two kinds, each of which is closed. So a rejected state with a published container fails."
      ],
      "from_schema": "https://w3id.org/lmodel/cve",
      "slot_usage": {},
      "class_uri": "https://w3id.org/lmodel/cve/CveRecordRoot",
      "tree_root": true,
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "exactly_one_of": [
        {
          "is_a": "CvePublishedRecord",
          "@type": "AnonymousClassExpression"
        },
        {
          "is_a": "CveRejectedRecord",
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "CvssSeverityBandsMixin",
      "definition_uri": "https://w3id.org/lmodel/cve/CvssSeverityBandsMixin",
      "annotations": [
        {
          "tag": "upstream_path",
          "value": "imports/cvss/cvss-v3.0.json#/anyOf imports/cvss/cvss-v3.1.json#/anyOf imports/cvss/cvss-v4.0.json#/allOf/0/anyOf",
          "@type": "Annotation"
        }
      ],
      "description": "The base score and base severity of a CVSS version with severity bands, and the bands that tie one to the other.",
      "comments": [
        "The upstream also rules out a score that is not a multiple of 0.1, as a list of numbers no LinkML range can state. tests/cve_rules.py checks that."
      ],
      "from_schema": "https://w3id.org/lmodel/cve/cve_cvss",
      "mixin": true,
      "slots": [
        "baseScore",
        "baseSeverity"
      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/lmodel/cve/CvssSeverityBandsMixin",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "baseSeverity",
                "equals_string": "NONE",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "baseScore",
                "minimum_value": 0,
                "maximum_value": 0,
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "A base severity of NONE goes with a base score of exactly 0.",
          "title": "base severity NONE",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "baseSeverity",
                "equals_string": "LOW",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "baseScore",
                "minimum_value": 0.1,
                "maximum_value": 3.9,
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "A base severity of LOW goes with a base score from 0.1 to 3.9.",
          "title": "base severity LOW",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "baseSeverity",
                "equals_string": "MEDIUM",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "baseScore",
                "minimum_value": 4.0,
                "maximum_value": 6.9,
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "A base severity of MEDIUM goes with a base score from 4.0 to 6.9.",
          "title": "base severity MEDIUM",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "baseSeverity",
                "equals_string": "HIGH",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "baseScore",
                "minimum_value": 7.0,
                "maximum_value": 8.9,
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "A base severity of HIGH goes with a base score from 7.0 to 8.9.",
          "title": "base severity HIGH",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "baseSeverity",
                "equals_string": "CRITICAL",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "baseScore",
                "minimum_value": 9.0,
                "maximum_value": 10.0,
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "A base severity of CRITICAL goes with a base score from 9.0 to 10.",
          "title": "base severity CRITICAL",
          "@type": "ClassRule"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "CvssV20",
      "definition_uri": "https://w3id.org/lmodel/cve/CvssV20",
      "annotations": [
        {
          "tag": "upstream_path",
          "value": "imports/cvss/cvss-v2.0.json#/",
