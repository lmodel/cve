      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "cna_tags",
      "definition_uri": "https://w3id.org/lmodel/cve/cna_tags",
      "annotations": [
        {
          "tag": "min_length",
          "value": 1,
          "@type": "Annotation"
        },
        {
          "tag": "max_length",
          "value": 128,
          "@type": "Annotation"
        }
      ],
      "description": "Tags provided by a CNA describing the CVE Record.",
      "from_schema": "https://w3id.org/lmodel/cve",
      "aliases": [
        "tags"
      ],
      "slot_uri": "https://w3id.org/lmodel/cve/cna_tags",
      "owner": "CnaPublishedContainer",
      "domain_of": [
        "CnaPublishedContainer"
      ],
      "range": "string",
      "multivalued": true,
      "any_of": [
        {
          "range": "CNATag",
          "@type": "AnonymousSlotExpression"
        },
        {
          "range": "string",
          "pattern": "^x_.*$",
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "adp_tags",
      "definition_uri": "https://w3id.org/lmodel/cve/adp_tags",
      "annotations": [
        {
          "tag": "min_length",
          "value": 1,
          "@type": "Annotation"
        },
        {
          "tag": "max_length",
          "value": 128,
          "@type": "Annotation"
        }
      ],
      "description": "Tags provided by an ADP describing the CVE Record.",
      "from_schema": "https://w3id.org/lmodel/cve",
      "aliases": [
        "tags"
      ],
      "slot_uri": "https://w3id.org/lmodel/cve/adp_tags",
      "owner": "AdpContainer",
      "domain_of": [
        "AdpContainer"
      ],
      "range": "string",
      "multivalued": true,
      "any_of": [
        {
          "range": "ADPTag",
          "@type": "AnonymousSlotExpression"
        },
        {
          "range": "string",
          "pattern": "^x_.*$",
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
