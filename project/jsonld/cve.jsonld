          "@type": "SlotDefinition"
        },
        {
          "name": "exploitMaturity",
          "annotations": [
            {
              "tag": "upstream_path",
              "value": "imports/cvss/cvss-v4.0.json#/properties/exploitMaturity",
              "@type": "Annotation"
            }
          ],
          "description": "How much is known about attacks on this flaw, in CVSS 4.0's terms.",
          "ifabsent": "CvssV4ExploitMaturity(NOT_DEFINED)",
          "range": "CvssV4ExploitMaturity",
          "@type": "SlotDefinition"
        },
        {
          "name": "modifiedAttackRequirements",
          "annotations": [
            {
              "tag": "upstream_path",
              "value": "imports/cvss/cvss-v4.0.json#/properties/modifiedAttackRequirements",
              "@type": "Annotation"
            }
          ],
          "description": "The attack requirements as the scorer's own environment changes them.",
          "ifabsent": "CvssV4ModifiedAttackRequirements(NOT_DEFINED)",
          "range": "CvssV4ModifiedAttackRequirements",
          "@type": "SlotDefinition"
        },
        {
          "name": "modifiedVulnConfidentialityImpact",
          "annotations": [
            {
              "tag": "upstream_path",
              "value": "imports/cvss/cvss-v4.0.json#/properties/modifiedVulnConfidentialityImpact",
              "@type": "Annotation"
            }
          ],
          "description": "The confidentiality impact on the vulnerable system, in the scorer's environment.",
          "ifabsent": "CvssModifiedImpact(NOT_DEFINED)",
          "range": "CvssModifiedImpact",
          "@type": "SlotDefinition"
        },
        {
