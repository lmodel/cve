        "metrics",
        "configurations",
        "workarounds",
        "solutions",
        "exploits",
        "timeline",
        "credits",
        "source",
        "CveAdpContainer_tags",
        "taxonomyMappings"
      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/lmodel/cve/CveAdpContainer",
      "extra_slots": {
        "allowed": true,
        "@type": "ExtraSlotsExpression"
      },
      "@type": "ClassDefinition"
    },
    {
      "name": "CveProduct",
      "definition_uri": "https://w3id.org/lmodel/cve/CveProduct",
