      "slot_uri": "https://w3id.org/lmodel/cve/date_rejected",
      "owner": "CveMetadataRejected",
      "domain_of": [
        "CveMetadataRejected"
      ],
      "range": "Timestamp",
      "@type": "SlotDefinition"
    },
    {
      "name": "published_state",
      "definition_uri": "https://w3id.org/lmodel/cve/published_state",
      "description": "State of the CVE Record. For published records, this is always PUBLISHED.",
      "in_subset": [
        "cna_metadata"
      ],
      "from_schema": "https://w3id.org/lmodel/cve",
      "aliases": [
        "state"
      ],
      "slot_uri": "https://w3id.org/lmodel/cve/published_state",
      "owner": "CveMetadataPublished",
      "domain_of": [
