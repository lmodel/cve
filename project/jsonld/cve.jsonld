        {
          "tag": "upstream_path",
          "value": "CVE_Record_Format.json#/definitions/cpe_match",
          "@type": "Annotation"
        }
      ],
      "description": "One CPE name, optionally bounded by versions, and whether it is vulnerable.",
      "from_schema": "https://w3id.org/lmodel/cve/cve_record",
      "slots": [
        "cveCpeMatch__vulnerable",
        "cveCpeMatch__criteria",
        "cveCpeMatch__matchCriteriaId",
