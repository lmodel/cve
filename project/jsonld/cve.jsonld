              "tag": "upstream_path",
              "value": "CVE_Record_Format.json#/definitions/cveMetadataPublished/properties/assignerOrgId",
              "@type": "Annotation"
            }
          ],
          "description": "The UUID of the organisation that was given the CVE identifier.",
          "range": "cve_uuid",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "assignerShortName",
          "annotations": [
            {
              "tag": "upstream_path",
              "value": "CVE_Record_Format.json#/definitions/cveMetadataPublished/properties/assignerShortName",
              "@type": "Annotation"
            }
          ],
