      "@type": "SlotDefinition"
    },
    {
      "name": "repo",
      "definition_uri": "https://w3id.org/lmodel/cve/repo",
      "annotations": [
        {
          "tag": "min_length",
          "value": 1,
          "@type": "Annotation"
        },
        {
          "tag": "max_length",
          "value": 2048,
          "@type": "Annotation"
        }
      ],
      "description": "The URL of the source code repository, for informational purposes and/or to resolve git hash version ranges.",
      "from_schema": "https://w3id.org/lmodel/cve",
      "slot_uri": "https://w3id.org/lmodel/cve/repo",
      "owner": "AffectedProduct",
      "domain_of": [
        "AffectedProduct"
      ],
      "range": "uri",
      "@type": "SlotDefinition"
    },
    {
      "name": "default_status",
      "definition_uri": "https://w3id.org/lmodel/cve/default_status",
      "description": "The default status for versions not otherwise listed in the versions list. Defaults to 'unknown' if not specified. Versions or defaultStatus may be omitted, but not both.",
      "from_schema": "https://w3id.org/lmodel/cve",
      "aliases": [
        "defaultStatus"
      ],
      "slot_uri": "https://w3id.org/lmodel/cve/default_status",
      "owner": "AffectedProduct",
      "domain_of": [
        "AffectedProduct"
      ],
      "range": "VersionStatus",
      "@type": "SlotDefinition"
    },
    {
      "name": "versions",
      "definition_uri": "https://w3id.org/lmodel/cve/versions",
      "description": "Set of product versions or version ranges related to the vulnerability. Versions or defaultStatus may be omitted, but not both.",
      "from_schema": "https://w3id.org/lmodel/cve",
      "slot_uri": "https://w3id.org/lmodel/cve/versions",
      "owner": "AffectedProduct",
      "domain_of": [
        "AffectedProduct"
      ],
      "range": "VersionEntry",
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "package_url",
      "definition_uri": "https://w3id.org/lmodel/cve/package_url",
      "annotations": [
        {
          "tag": "min_length",
          "value": 1,
          "@type": "Annotation"
        },
        {
          "tag": "max_length",
          "value": 2048,
          "@type": "Annotation"
        }
      ],
      "description": "A Package URL (PURL), a unified URL specification for identifying packages hosted by known package hosts. The Package URL MUST NOT include a version.",
      "from_schema": "https://w3id.org/lmodel/cve",
      "aliases": [
        "packageURL"
      ],
      "slot_uri": "https://w3id.org/lmodel/cve/package_url",
      "owner": "AffectedProduct",
      "domain_of": [
        "AffectedProduct"
      ],
      "range": "uri",
      "@type": "SlotDefinition"
    },
    {
      "name": "version_value",
      "definition_uri": "https://w3id.org/lmodel/cve/version_value",
      "description": "The single version being described, or the version at the start of the range. By convention, '0' denotes the earliest possible version.",
      "from_schema": "https://w3id.org/lmodel/cve",
      "aliases": [
        "version"
      ],
      "slot_uri": "https://w3id.org/lmodel/cve/version_value",
      "owner": "VersionEntry",
      "domain_of": [
        "VersionEntry"
      ],
      "range": "VersionString",
      "@type": "SlotDefinition"
    },
    {
      "name": "version_status",
      "definition_uri": "https://w3id.org/lmodel/cve/version_status",
      "description": "The vulnerability status for the version or range of versions. For a range, the status may be refined by the 'changes' list.",
      "from_schema": "https://w3id.org/lmodel/cve",
      "aliases": [
        "status"
      ],
      "slot_uri": "https://w3id.org/lmodel/cve/version_status",
      "owner": "VersionEntry",
      "domain_of": [
        "VersionEntry"
      ],
      "range": "VersionStatus",
      "@type": "SlotDefinition"
    },
    {
      "name": "version_type",
      "definition_uri": "https://w3id.org/lmodel/cve/version_type",
      "annotations": [
        {
          "tag": "min_length",
          "value": 1,
          "@type": "Annotation"
        },
        {
          "tag": "max_length",
          "value": 128,
          "@type": "Annotation"
        }
      ],
      "description": "The version numbering system used for specifying the range (e.g., semver, git, maven, rpm, python, custom). Defines the semantics of comparison.",
      "from_schema": "https://w3id.org/lmodel/cve",
      "aliases": [
        "versionType"
      ],
      "slot_uri": "https://w3id.org/lmodel/cve/version_type",
      "owner": "VersionEntry",
      "domain_of": [
        "VersionEntry"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "less_than",
      "definition_uri": "https://w3id.org/lmodel/cve/less_than",
      "description": "The non-inclusive upper limit of the range. This is the least version NOT in the range. Supports wildcard '*' suffix.",
      "from_schema": "https://w3id.org/lmodel/cve",
      "aliases": [
        "lessThan"
      ],
      "slot_uri": "https://w3id.org/lmodel/cve/less_than",
      "owner": "VersionEntry",
      "domain_of": [
        "VersionEntry"
      ],
      "range": "VersionString",
      "@type": "SlotDefinition"
    },
    {
      "name": "less_than_or_equal",
      "definition_uri": "https://w3id.org/lmodel/cve/less_than_or_equal",
      "description": "The inclusive upper limit of the range. This is the greatest version contained in the range. Only one of lessThan and lessThanOrEqual should be specified.",
      "from_schema": "https://w3id.org/lmodel/cve",
      "aliases": [
        "lessThanOrEqual"
      ],
      "slot_uri": "https://w3id.org/lmodel/cve/less_than_or_equal",
      "owner": "VersionEntry",
      "domain_of": [
        "VersionEntry"
      ],
      "range": "VersionString",
      "@type": "SlotDefinition"
    },
    {
      "name": "version_changes",
      "definition_uri": "https://w3id.org/lmodel/cve/version_changes",
      "description": "A list of status changes that take place during the version range. The array should be sorted by 'at' field according to versionType, but clients must re-sort rather than assume ordering.",
      "from_schema": "https://w3id.org/lmodel/cve",
      "aliases": [
        "changes"
      ],
      "slot_uri": "https://w3id.org/lmodel/cve/version_changes",
      "owner": "VersionEntry",
      "domain_of": [
        "VersionEntry"
      ],
      "range": "VersionChange",
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "change_at",
      "definition_uri": "https://w3id.org/lmodel/cve/change_at",
      "description": "The version at which a status change occurs within a range.",
      "from_schema": "https://w3id.org/lmodel/cve",
      "aliases": [
        "at"
      ],
      "slot_uri": "https://w3id.org/lmodel/cve/change_at",
      "owner": "VersionChange",
      "domain_of": [
        "VersionChange"
      ],
      "range": "VersionString",
      "@type": "SlotDefinition"
    },
    {
      "name": "change_status",
      "definition_uri": "https://w3id.org/lmodel/cve/change_status",
      "description": "The new status in the range starting at the given version.",
      "from_schema": "https://w3id.org/lmodel/cve",
      "aliases": [
        "status"
      ],
      "slot_uri": "https://w3id.org/lmodel/cve/change_status",
      "owner": "VersionChange",
      "domain_of": [
        "VersionChange"
      ],
      "range": "VersionStatus",
      "@type": "SlotDefinition"
    },
    {
      "name": "routine_name",
      "definition_uri": "https://w3id.org/lmodel/cve/routine_name",
      "annotations": [
        {
          "tag": "min_length",
          "value": 1,
          "@type": "Annotation"
        },
        {
          "tag": "max_length",
          "value": 4096,
          "@type": "Annotation"
        }
      ],
      "description": "Name of the affected source code function, method, subroutine, or procedure.",
      "from_schema": "https://w3id.org/lmodel/cve",
      "aliases": [
        "name"
      ],
      "slot_uri": "https://w3id.org/lmodel/cve/routine_name",
      "owner": "ProgramRoutine",
      "domain_of": [
        "ProgramRoutine"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "lang",
      "definition_uri": "https://w3id.org/lmodel/cve/lang",
      "description": "BCP 47 language code indicating the language of accompanying text.",
      "from_schema": "https://w3id.org/lmodel/cve",
      "slot_uri": "https://w3id.org/lmodel/cve/lang",
      "ifabsent": "string(en)",
      "owner": "CreditEntry",
      "domain_of": [
        "MultiLangDescription",
        "ProblemTypeDescription",
        "MetricScenario",
        "TimelineEntry",
        "CreditEntry"
      ],
      "range": "LanguageTag",
      "@type": "SlotDefinition"
    },
    {
      "name": "description_value",
      "definition_uri": "https://w3id.org/lmodel/cve/description_value",
      "annotations": [
        {
          "tag": "min_length",
          "value": 1,
          "@type": "Annotation"
        },
        {
          "tag": "max_length",
          "value": 4096,
          "@type": "Annotation"
        }
      ],
      "description": "Plain text description (up to 4096 characters).",
      "from_schema": "https://w3id.org/lmodel/cve",
      "aliases": [
        "value"
      ],
      "slot_uri": "https://w3id.org/lmodel/cve/description_value",
      "owner": "MultiLangDescription",
      "domain_of": [
        "MultiLangDescription"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "supporting_media",
      "definition_uri": "https://w3id.org/lmodel/cve/supporting_media",
      "description": "Supporting media data for the description such as markdown, diagrams, etc. Similar to RFC 2397, each object has a media type, data value, and optional base64 flag.",
      "from_schema": "https://w3id.org/lmodel/cve",
      "aliases": [
        "supportingMedia"
      ],
      "slot_uri": "https://w3id.org/lmodel/cve/supporting_media",
      "owner": "MultiLangDescription",
      "domain_of": [
        "MultiLangDescription"
      ],
      "range": "SupportingMedia",
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "media_type",
      "definition_uri": "https://w3id.org/lmodel/cve/media_type",
      "annotations": [
        {
          "tag": "min_length",
          "value": 1,
          "@type": "Annotation"
        },
        {
          "tag": "max_length",
          "value": 256,
          "@type": "Annotation"
        }
      ],
      "description": "RFC2046 compliant IANA Media type (e.g., text/markdown, text/html, image/png, image/svg, audio/mp3).",
      "from_schema": "https://w3id.org/lmodel/cve",
      "aliases": [
        "type"
      ],
      "slot_uri": "https://w3id.org/lmodel/cve/media_type",
      "owner": "SupportingMedia",
      "domain_of": [
        "SupportingMedia"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "base64_encoded",
      "definition_uri": "https://w3id.org/lmodel/cve/base64_encoded",
      "description": "If true, the media_value field contains the media data encoded in base64. If false, the media_value field contains UTF-8 media content.",
      "from_schema": "https://w3id.org/lmodel/cve",
      "aliases": [
        "base64"
      ],
      "slot_uri": "https://w3id.org/lmodel/cve/base64_encoded",
      "ifabsent": "False",
      "owner": "SupportingMedia",
      "domain_of": [
        "SupportingMedia"
      ],
      "range": "boolean",
      "@type": "SlotDefinition"
    },
    {
      "name": "media_value",
      "definition_uri": "https://w3id.org/lmodel/cve/media_value",
      "annotations": [
        {
          "tag": "min_length",
          "value": 1,
          "@type": "Annotation"
        },
        {
          "tag": "max_length",
          "value": 16384,
          "@type": "Annotation"
        }
      ],
      "description": "Supporting media content, up to 16K characters. If base64_encoded is true, this stores base64 encoded data.",
      "from_schema": "https://w3id.org/lmodel/cve",
      "aliases": [
        "value"
      ],
      "slot_uri": "https://w3id.org/lmodel/cve/media_value",
      "owner": "SupportingMedia",
      "domain_of": [
        "SupportingMedia"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "problem_type_descriptions",
      "definition_uri": "https://w3id.org/lmodel/cve/problem_type_descriptions",
      "description": "One or more problem type descriptions (e.g., CWE IDs or OWASP categories).",
      "from_schema": "https://w3id.org/lmodel/cve",
      "aliases": [
        "descriptions"
      ],
      "slot_uri": "https://w3id.org/lmodel/cve/problem_type_descriptions",
      "owner": "ProblemType",
      "domain_of": [
        "ProblemType"
      ],
      "range": "ProblemTypeDescription",
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "problem_description",
      "definition_uri": "https://w3id.org/lmodel/cve/problem_description",
      "annotations": [
        {
          "tag": "min_length",
          "value": 1,
          "@type": "Annotation"
        },
        {
          "tag": "max_length",
          "value": 4096,
          "@type": "Annotation"
        }
      ],
      "description": "Text description of the problem type, or title from CWE or OWASP.",
      "from_schema": "https://w3id.org/lmodel/cve",
      "aliases": [
        "description"
      ],
      "close_mappings": [
        "https://w3id.org/lmodel/cwe/Weakness"
      ],
      "slot_uri": "https://w3id.org/lmodel/cve/problem_description",
      "owner": "ProblemTypeDescription",
      "domain_of": [
        "ProblemTypeDescription"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "problem_source_type",
      "definition_uri": "https://w3id.org/lmodel/cve/problem_source_type",
      "annotations": [
        {
          "tag": "min_length",
          "value": 1,
          "@type": "Annotation"
        },
        {
          "tag": "max_length",
          "value": 64,
          "@type": "Annotation"
        }
      ],
      "description": "Problem type source format (e.g., text, OWASP, CWE).",
      "from_schema": "https://w3id.org/lmodel/cve",
      "aliases": [
        "type"
      ],
      "slot_uri": "https://w3id.org/lmodel/cve/problem_source_type",
      "owner": "ProblemTypeDescription",
      "domain_of": [
        "ProblemTypeDescription"
      ],
      "range": "string",
      "@type": "SlotDefinition"
    },
    {
      "name": "problem_references",
      "definition_uri": "https://w3id.org/lmodel/cve/problem_references",
      "description": "References supporting this specific problem type.",
      "from_schema": "https://w3id.org/lmodel/cve",
      "aliases": [
        "references"
      ],
      "slot_uri": "https://w3id.org/lmodel/cve/problem_references",
      "owner": "ProblemTypeDescription",
      "domain_of": [
        "ProblemTypeDescription"
      ],
      "range": "CveReference",
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "reference_tags",
      "definition_uri": "https://w3id.org/lmodel/cve/reference_tags",
      "description": "An array of tags describing the resource referenced by the URL.",
      "from_schema": "https://w3id.org/lmodel/cve",
      "aliases": [
        "tags"
      ],
      "slot_uri": "https://w3id.org/lmodel/cve/reference_tags",
      "owner": "CveReference",
      "domain_of": [
        "CveReference"
      ],
      "range": "ReferenceTag",
      "multivalued": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "capec_id",
      "definition_uri": "https://w3id.org/lmodel/cve/capec_id",
      "description": "CAPEC ID that best relates to this impact (e.g., CAPEC-123).",
