      ],
      "range": "Timestamp",
      "@type": "SlotDefinition"
    },
    {
      "name": "date_rejected",
      "definition_uri": "https://w3id.org/lmodel/cve/date_rejected",
      "description": "The date/time the CVE ID was rejected.",
