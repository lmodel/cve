          ],
          "close_mappings": [
            "sepses_cve:hasCPE"
          ],
          "list_elements_unique": true,
          "range": "cve_cpe22and23",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "modules",
          "annotations": [
