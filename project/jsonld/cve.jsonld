    },
    {
      "name": "VersionEntry",
      "definition_uri": "https://w3id.org/lmodel/cve/VersionEntry",
      "description": "A single version or a range of versions of a product with associated vulnerability status. An entry with only version and status is a point version; an entry with versionType and a less-than limit describes a range.",
      "from_schema": "https://w3id.org/lmodel/cve",
      "slots": [
        "VersionEntry_version_value",
        "VersionEntry_version_status",
        "version_type",
        "less_than",
        "less_than_or_equal",
        "version_changes"
      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/lmodel/cve/VersionEntry",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "less_than",
                "required": true,
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "version_type",
                "required": true,
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "less_than_or_equal",
                "required": true,
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "version_type",
                "required": true,
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "@type": "ClassRule"
        }
      ],
      "none_of": [
        {
          "slot_conditions": [
            {
              "name": "less_than",
              "required": true,
              "@type": "SlotDefinition"
            },
            {
              "name": "less_than_or_equal",
              "required": true,
              "@type": "SlotDefinition"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "VersionChange",
      "definition_uri": "https://w3id.org/lmodel/cve/VersionChange",
      "description": "A status change that takes place at a specific point within a version range.",
