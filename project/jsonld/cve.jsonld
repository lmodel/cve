        "cveCpeMatch__versionStartIncluding",
        "cveCpeMatch__versionEndExcluding",
        "cveCpeMatch__versionEndIncluding"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "vulnerable",
          "annotations": [
            {
              "tag": "upstream_path",
              "value": "CVE_Record_Format.json#/definitions/cpe_match/properties/vulnerable",
              "@type": "Annotation"
            }
          ],
          "description": "Whether what this match covers is vulnerable.",
