      ],
      "range": "AdpContainer",
      "multivalued": true,
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "org_id",
      "definition_uri": "https://w3id.org/lmodel/cve/org_id",
