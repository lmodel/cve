          "annotations": [
            {
              "tag": "upstream_path",
              "value": "CVE_Record_Format.json#/definitions/cveMetadataPublished/properties/serial",
              "@type": "Annotation"
            }
          ],
          "description": "A counter that the system of record raises each time a provider changes the record.",
          "range": "integer",
          "minimum_value": 1,
