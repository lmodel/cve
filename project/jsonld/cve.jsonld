          "value": "CVE_Record_Format.json#/definitions/cnaPublishedContainer",
          "@type": "Annotation"
        }
      ],
      "description": "The assigning authority's account of a published vulnerability.",
      "comments": [
        "It accepts keys of the publisher's own, whose names must begin x_ and hold no full stop. JSON Schema from LinkML 1.12.1 cannot state that rule on a name, so tests/cve_rules.py checks each extra key."
      ],
      "from_schema": "https://w3id.org/lmodel/cve/cve_record",
