    {
      "name": "CVERecord",
      "definition_uri": "https://w3id.org/lmodel/cve/CVERecord",
      "description": "Official CVE Record corresponding to a CVE ID. Represents either a Published or Rejected record in the CVE\u2122 Program. The dataType field is always CVE_RECORD. Use cveMetadata.state to distinguish Published from Rejected records.\nThis class deliberately does NOT inherit from ``vulnerability_core.Vulnerability``: the upstream CVE Record Format places the CVE ID inside ``cveMetadata.cveId`` rather than at the record root. Semantic equivalence with the broader ``Vulnerability`` concept is preserved via ``exact_mappings``.",
      "in_subset": [
        "cve_record"
      ],
      "from_schema": "https://w3id.org/lmodel/cve",
      "exact_mappings": [
        "WIKIDATA:Q631425",
        "core:Vulnerability"
      ],
      "close_mappings": [
        "nvd:NVDEntry"
      ],
      "related_mappings": [
        "kev_catalog:KevEntry"
      ],
      "slots": [
        "data_type",
        "data_version",
        "CVERecord_cve_metadata",
        "CVERecord_containers"
      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/lmodel/cve/CVERecord",
      "tree_root": true,
      "@type": "ClassDefinition"
    },
    {
      "name": "CveMetadata",
      "definition_uri": "https://w3id.org/lmodel/cve/CveMetadata",
      "description": "Abstract base for CVE Record metadata. Represents either a Published or Rejected record's metadata. All fields are controlled by CVE Services. Polymorphism is provided via ``is_a`` on the two concrete subclasses (``CveMetadataPublished``, ``CveMetadataRejected``); slot-level ``any_of`` on the ``cve_metadata`` slot preserves the choice for generators (e.g. JSON Schema ``anyOf``).",
      "from_schema": "https://w3id.org/lmodel/cve",
      "abstract": true,
      "slot_usage": {},
      "class_uri": "https://w3id.org/lmodel/cve/CveMetadata",
      "@type": "ClassDefinition"
    },
    {
      "name": "CveMetadataPublished",
