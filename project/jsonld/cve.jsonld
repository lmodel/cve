    {
      "name": "Any",
      "definition_uri": "https://w3id.org/lmodel/cve/Any",
      "description": "A linkml placeholder class accepting any JSON-compatible value (string, number, boolean, object, or array). Use for slots that hold arbitrary or schema-less data.",
