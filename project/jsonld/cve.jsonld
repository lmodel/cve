              "@type": "Annotation"
            }
          ],
          "description": "When the CVE identifier was reserved.",
          "comments": [
            "This says nothing about when the flaw was found, reported or disclosed."
          ],
          "range": "cve_timestamp",
          "@type": "SlotDefinition"
        },
        {
