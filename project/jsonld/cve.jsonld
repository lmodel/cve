      "from_schema": "https://w3id.org/lmodel/cve",
      "slot_uri": "https://w3id.org/lmodel/cve/modules",
      "owner": "AffectedProduct",
      "domain_of": [
        "AffectedProduct"
      ],
      "range": "string",
