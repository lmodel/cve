      "aliases": [
        "source"
      ],
      "slot_uri": "https://w3id.org/lmodel/cve/cna_source",
      "owner": "AdpContainer",
      "domain_of": [
        "CnaPublishedContainer",
        "AdpContainer"
      ],
      "range": "SourceInformation",
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "source_defects",
      "definition_uri": "https://w3id.org/lmodel/cve/source_defects",
      "annotations": [
        {
          "tag": "min_length",
          "value": 1,
          "@type": "Annotation"
        },
        {
          "tag": "max_length",
          "value": 4096,
          "@type": "Annotation"
        }
      ],
      "description": "Bug tracking system IDs (e.g., JIRA ticket IDs) related to the vulnerability.",
