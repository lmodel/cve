        "cvssV40__exploitMaturity",
        "cvssV40__modifiedAttackRequirements",
        "cvssV40__modifiedVulnConfidentialityImpact",
        "cvssV40__modifiedVulnIntegrityImpact",
        "cvssV40__modifiedVulnAvailabilityImpact",
        "cvssV40__modifiedSubConfidentialityImpact",
        "cvssV40__modifiedSubIntegrityImpact",
        "cvssV40__modifiedSubAvailabilityImpact",
        "cvssV40__Safety",
        "cvssV40__Automatable",
        "cvssV40__Recovery",
        "cvssV40__valueDensity",
        "cvssV40__vulnerabilityResponseEffort",
        "cvssV40__providerUrgency",
        "baseScore",
        "baseSeverity"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "attackRequirements",
          "annotations": [
            {
              "tag": "upstream_path",
              "value": "imports/cvss/cvss-v4.0.json#/properties/attackRequirements",
              "@type": "Annotation"
            }
          ],
          "description": "Whether the attack needs conditions in the target that the attacker does not control.",
          "range": "CvssV4AttackRequirements",
          "@type": "SlotDefinition"
        },
        {
          "name": "vulnConfidentialityImpact",
          "annotations": [
            {
              "tag": "upstream_path",
              "value": "imports/cvss/cvss-v4.0.json#/properties/vulnConfidentialityImpact",
              "@type": "Annotation"
            }
          ],
          "description": "How much information in the vulnerable system an attack could expose.",
