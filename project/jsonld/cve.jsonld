      "aliases": [
        "defects"
      ],
      "slot_uri": "https://w3id.org/lmodel/cve/source_defects",
      "owner": "SourceInformation",
      "domain_of": [
        "SourceInformation"
      ],
      "range": "string",
      "multivalued": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "source_advisory",
      "definition_uri": "https://w3id.org/lmodel/cve/source_advisory",
      "annotations": [
        {
          "tag": "min_length",
          "value": 1,
          "@type": "Annotation"
        },
        {
          "tag": "max_length",
          "value": 4096,
          "@type": "Annotation"
        }
      ],
      "description": "Advisory identifier associated with the vulnerability discovery.",
