    },
    {
      "name": "AffectedProduct",
      "definition_uri": "https://w3id.org/lmodel/cve/AffectedProduct",
      "description": "Information about the set of products and services affected by a vulnerability. At least one of (vendor + product) or (collectionURL + packageName) is required, and at least one of versions or defaultStatus is required.\nNote: this class deliberately does NOT inherit from ``vulnerability_core.Product``. The upstream CVE ``product`` definition uses a multivalued ``versions`` slot (range ``VersionEntry``), which conflicts with ``Product.version`` (singular string). The ``vendor``, ``name`` (= upstream ``product``), and ``platforms`` slots are reused from the core schema directly. Semantic equivalence is preserved via ``exact_mappings``.",
      "from_schema": "https://w3id.org/lmodel/cve",
      "exact_mappings": [
        "core:Product",
        "schema:SoftwareApplication"
      ],
      "related_mappings": [
        "kev_catalog:KevEntry"
      ],
      "slots": [
        "AffectedProduct_vendor",
        "AffectedProduct_name",
        "AffectedProduct_platforms",
        "collection_url",
        "package_name",
        "cpes",
        "modules",
        "program_files",
        "program_routines",
        "repo",
        "default_status",
        "versions",
        "package_url"
      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/lmodel/cve/AffectedProduct",
      "all_of": [
        {
          "any_of": [
            {
              "slot_conditions": [
                {
                  "name": "vendor",
                  "required": true,
                  "@type": "SlotDefinition"
                },
                {
                  "name": "name",
                  "required": true,
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "collection_url",
                  "required": true,
                  "@type": "SlotDefinition"
                },
                {
                  "name": "package_name",
                  "required": true,
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        },
        {
          "any_of": [
            {
              "slot_conditions": [
                {
                  "name": "versions",
                  "required": true,
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "default_status",
                  "required": true,
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "ProgramRoutine",
