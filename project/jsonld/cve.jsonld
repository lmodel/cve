      "@type": "SlotDefinition"
    },
    {
      "name": "cna",
      "definition_uri": "https://w3id.org/lmodel/cve/cna",
      "description": "The CNA container holding vulnerability information for this CVE ID. For published records, this is a CnaPublishedContainer. For rejected records, this is a CnaRejectedContainer.",
