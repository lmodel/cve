              "value": "CVE_Record_Format.json#/definitions/cveMetadataPublished/properties/datePublished",
              "@type": "Annotation"
            }
          ],
          "description": "When the record first appeared in the CVE List.",
          "close_mappings": [
            "dcterms:issued",
            "schema:datePublished",
            "spdx_security:publishedTime"
          ],
          "range": "cve_timestamp",
          "@type": "SlotDefinition"
        }
      ],
