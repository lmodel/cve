    {
      "name": "CnaContainer",
      "definition_uri": "https://w3id.org/lmodel/cve/CnaContainer",
      "description": "Abstract base for CNA containers (published and rejected). Polymorphism is provided via ``is_a`` on the two concrete subclasses (``CnaPublishedContainer``, ``CnaRejectedContainer``); slot-level ``any_of`` on the ``cna`` slot preserves the choice for generators.",
      "from_schema": "https://w3id.org/lmodel/cve",
