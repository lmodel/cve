        },
        {
          "name": "packageName",
          "annotations": [
            {
              "tag": "upstream_path",
              "value": "CVE_Record_Format.json#/definitions/product/properties/packageName",
              "@type": "Annotation"
            }
          ],
          "description": "The package's name or identifier within its collection.",
          "range": "cve_text_2048",
