          "range": "CvssModifiedImpact",
          "@type": "SlotDefinition"
        },
        {
          "name": "modifiedVulnAvailabilityImpact",
          "annotations": [
            {
              "tag": "upstream_path",
              "value": "imports/cvss/cvss-v4.0.json#/properties/modifiedVulnAvailabilityImpact",
              "@type": "Annotation"
            }
          ],
          "description": "The availability impact on the vulnerable system, in the scorer's environment.",
          "ifabsent": "CvssModifiedImpact(NOT_DEFINED)",
          "range": "CvssModifiedImpact",
          "@type": "SlotDefinition"
        },
        {
          "name": "modifiedSubConfidentialityImpact",
          "annotations": [
            {
              "tag": "upstream_path",
              "value": "imports/cvss/cvss-v4.0.json#/properties/modifiedSubConfidentialityImpact",
              "@type": "Annotation"
            }
          ],
          "description": "The confidentiality impact on connected systems, in the scorer's environment.",
          "ifabsent": "CvssModifiedImpact(NOT_DEFINED)",
          "range": "CvssModifiedImpact",
          "@type": "SlotDefinition"
        },
        {
          "name": "modifiedSubIntegrityImpact",
          "annotations": [
            {
              "tag": "upstream_path",
              "value": "imports/cvss/cvss-v4.0.json#/properties/modifiedSubIntegrityImpact",
              "@type": "Annotation"
            }
          ],
          "description": "The integrity impact on connected systems, in the scorer's environment.",
          "ifabsent": "CvssV4ModifiedSubsequentImpact(NOT_DEFINED)",
          "range": "CvssV4ModifiedSubsequentImpact",
          "@type": "SlotDefinition"
        },
        {
          "name": "modifiedSubAvailabilityImpact",
          "annotations": [
            {
              "tag": "upstream_path",
              "value": "imports/cvss/cvss-v4.0.json#/properties/modifiedSubAvailabilityImpact",
              "@type": "Annotation"
            }
          ],
          "description": "The availability impact on connected systems, in the scorer's environment.",
          "ifabsent": "CvssV4ModifiedSubsequentImpact(NOT_DEFINED)",
          "range": "CvssV4ModifiedSubsequentImpact",
          "@type": "SlotDefinition"
        },
        {
          "name": "Safety",
          "annotations": [
            {
              "tag": "upstream_path",
              "value": "imports/cvss/cvss-v4.0.json#/properties/Safety",
              "@type": "Annotation"
            }
          ],
          "description": "Whether an attack could put people's safety at risk.",
          "ifabsent": "CvssV4Safety(NOT_DEFINED)",
          "range": "CvssV4Safety",
          "@type": "SlotDefinition"
        },
        {
          "name": "Automatable",
          "annotations": [
            {
              "tag": "upstream_path",
              "value": "imports/cvss/cvss-v4.0.json#/properties/Automatable",
              "@type": "Annotation"
            }
          ],
          "description": "Whether an attacker could automate every step of an attack across many targets.",
          "ifabsent": "CvssV4Automatable(NOT_DEFINED)",
          "range": "CvssV4Automatable",
          "@type": "SlotDefinition"
        },
        {
          "name": "Recovery",
          "annotations": [
            {
              "tag": "upstream_path",
              "value": "imports/cvss/cvss-v4.0.json#/properties/Recovery",
              "@type": "Annotation"
            }
          ],
          "description": "How the affected system comes back after an attack.",
          "ifabsent": "CvssV4Recovery(NOT_DEFINED)",
          "range": "CvssV4Recovery",
          "@type": "SlotDefinition"
        },
        {
          "name": "valueDensity",
          "annotations": [
