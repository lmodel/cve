      "annotations": [
        {
          "tag": "upstream_path",
          "value": "CVE_Record_Format.json#/definitions/adpContainer",
          "@type": "Annotation"
        }
      ],
      "description": "What an Authorized Data Publisher adds to a record beside the assigning authority's account.",
      "comments": [
        "It accepts keys of the publisher's own, whose names must begin x_ and hold no full stop, and it must hold something beside providerMetadata. tests/cve_rules.py checks both, since LinkML 1.12.1 can state neither."
      ],
      "from_schema": "https://w3id.org/lmodel/cve/cve_record",
      "slots": [
        "providerMetadata",
        "datePublic",
        "title",
