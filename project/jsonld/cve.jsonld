          "range": "cve_text_4096",
          "multivalued": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "programFiles",
          "annotations": [
            {
              "tag": "upstream_path",
              "value": "CVE_Record_Format.json#/definitions/product/properties/programFiles",
              "@type": "Annotation"
            }
          ],
          "description": "The affected source files.",
          "list_elements_unique": true,
          "range": "cve_text_1024",
          "multivalued": true,
