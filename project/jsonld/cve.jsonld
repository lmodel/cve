  ],
  "enums": [
    {
      "name": "CvssSeverity",
      "definition_uri": "https://w3id.org/lmodel/cve/CvssSeverity",
      "annotations": [
        {
          "tag": "upstream_path",
          "value": "imports/cvss/cvss-v3.0.json#/definitions/severityType imports/cvss/cvss-v3.1.json#/definitions/severityType imports/cvss/cvss-v4.0.json#/definitions/severityType"
        }
      ],
      "description": "A CVSS rating in words.",
      "from_schema": "https://w3id.org/lmodel/cve/cve_cvss",
      "permissible_values": [
        {
          "text": "NONE",
          "description": "No severity at all, for a score of 0.",
          "meaning": "spdx_security:CvssSeverityType/none"
        },
        {
          "text": "LOW",
          "description": "The lowest rating above none.",
          "meaning": "spdx_security:CvssSeverityType/low"
        },
        {
          "text": "MEDIUM",
          "description": "The middle rating.",
          "meaning": "spdx_security:CvssSeverityType/medium"
        },
        {
          "text": "HIGH",
          "description": "The rating below critical.",
          "meaning": "spdx_security:CvssSeverityType/high"
        },
        {
          "text": "CRITICAL",
          "description": "The highest rating.",
          "meaning": "spdx_security:CvssSeverityType/critical"
        }
      ]
    },
    {
      "name": "CvssV2AccessVector",
      "definition_uri": "https://w3id.org/lmodel/cve/CvssV2AccessVector",
      "annotations": [
        {
          "tag": "upstream_path",
          "value": "imports/cvss/cvss-v2.0.json#/definitions/accessVectorType"
        }
      ],
      "description": "How far away an attacker can be, in CVSS 2.0's terms.",
      "from_schema": "https://w3id.org/lmodel/cve/cve_cvss",
      "permissible_values": [
        {
          "text": "NETWORK",
          "description": "From anywhere that can route to the system."
        },
        {
          "text": "ADJACENT_NETWORK",
          "description": "Only from the same local network segment."
        },
        {
          "text": "LOCAL",
          "description": "Only with an account on the system or hands on it."
        }
      ]
    },
    {
      "name": "CvssV2AccessComplexity",
      "definition_uri": "https://w3id.org/lmodel/cve/CvssV2AccessComplexity",
      "annotations": [
        {
          "tag": "upstream_path",
          "value": "imports/cvss/cvss-v2.0.json#/definitions/accessComplexityType"
        }
      ],
      "description": "How hard the flaw is to use, in CVSS 2.0's terms.",
      "from_schema": "https://w3id.org/lmodel/cve/cve_cvss",
      "permissible_values": [
        {
          "text": "HIGH",
          "description": "Only under unusual, hard-to-arrange conditions."
        },
        {
          "text": "MEDIUM",
          "description": "Under conditions that take some arranging."
        },
        {
          "text": "LOW",
          "description": "With no special conditions."
        }
      ]
    },
    {
      "name": "CvssV2Authentication",
      "definition_uri": "https://w3id.org/lmodel/cve/CvssV2Authentication",
      "annotations": [
        {
          "tag": "upstream_path",
          "value": "imports/cvss/cvss-v2.0.json#/definitions/authenticationType"
        }
      ],
      "description": "How many logins an attacker needs, in CVSS 2.0's terms.",
      "from_schema": "https://w3id.org/lmodel/cve/cve_cvss",
      "permissible_values": [
        {
          "text": "MULTIPLE",
          "description": "More than one login."
        },
        {
          "text": "SINGLE",
          "description": "One login."
        },
        {
          "text": "NONE",
          "description": "No login at all."
        }
      ]
    },
    {
      "name": "CvssV2Impact",
      "definition_uri": "https://w3id.org/lmodel/cve/CvssV2Impact",
      "annotations": [
        {
          "tag": "upstream_path",
          "value": "imports/cvss/cvss-v2.0.json#/definitions/ciaType"
        }
      ],
      "description": "How much of one security property an attack could cost, in CVSS 2.0's terms.",
      "from_schema": "https://w3id.org/lmodel/cve/cve_cvss",
      "permissible_values": [
        {
          "text": "NONE",
          "description": "Nothing is lost."
        },
        {
          "text": "PARTIAL",
          "description": "Some is lost, and the attacker cannot choose all of it."
        },
        {
          "text": "COMPLETE",
          "description": "All of it is lost."
        }
      ]
    },
    {
      "name": "CvssExploitCodeMaturity",
      "definition_uri": "https://w3id.org/lmodel/cve/CvssExploitCodeMaturity",
      "annotations": [
        {
          "tag": "upstream_path",
          "value": "imports/cvss/cvss-v2.0.json#/definitions/exploitabilityType imports/cvss/cvss-v3.0.json#/definitions/exploitCodeMaturityType imports/cvss/cvss-v3.1.json#/definitions/exploitCodeMaturityType"
        }
      ],
      "description": "How far working attack code has come.",
      "from_schema": "https://w3id.org/lmodel/cve/cve_cvss",
      "permissible_values": [
        {
          "text": "UNPROVEN",
          "description": "No attack code is known, or the attack is only theory."
        },
        {
          "text": "PROOF_OF_CONCEPT",
          "description": "A demonstration exists that needs skilled work to use."
        },
        {
          "text": "FUNCTIONAL",
          "description": "Working attack code exists for most situations."
        },
        {
          "text": "HIGH",
          "description": "Attack code is reliable and widely available, or no code is needed."
        },
        {
          "text": "NOT_DEFINED",
          "description": "The scorer gave no value, so the metric does not change the score."
        }
      ]
    },
    {
      "name": "CvssRemediationLevel",
      "definition_uri": "https://w3id.org/lmodel/cve/CvssRemediationLevel",
      "annotations": [
        {
          "tag": "upstream_path",
          "value": "imports/cvss/cvss-v2.0.json#/definitions/remediationLevelType imports/cvss/cvss-v3.0.json#/definitions/remediationLevelType imports/cvss/cvss-v3.1.json#/definitions/remediationLevelType"
        }
      ],
      "description": "What kind of fix is available.",
      "from_schema": "https://w3id.org/lmodel/cve/cve_cvss",
      "permissible_values": [
        {
          "text": "OFFICIAL_FIX",
          "description": "The vendor offers a complete fix."
        },
        {
          "text": "TEMPORARY_FIX",
          "description": "The vendor offers a stopgap for now."
        },
        {
          "text": "WORKAROUND",
          "description": "Others offer a way round the flaw that is not from the vendor."
        },
        {
          "text": "UNAVAILABLE",
          "description": "No fix exists, or it cannot be applied."
        },
        {
          "text": "NOT_DEFINED",
          "description": "The scorer gave no value, so the metric does not change the score."
        }
      ]
    },
    {
      "name": "CvssV2ReportConfidence",
      "definition_uri": "https://w3id.org/lmodel/cve/CvssV2ReportConfidence",
      "annotations": [
        {
          "tag": "upstream_path",
          "value": "imports/cvss/cvss-v2.0.json#/definitions/reportConfidenceType"
        }
      ],
      "description": "How far the flaw has been confirmed, in CVSS 2.0's terms.",
      "from_schema": "https://w3id.org/lmodel/cve/cve_cvss",
      "permissible_values": [
        {
          "text": "UNCONFIRMED",
          "description": "A single report or conflicting reports that nobody has checked."
        },
        {
          "text": "UNCORROBORATED",
          "description": "Several unofficial sources agree, with some doubt remaining."
        },
        {
          "text": "CONFIRMED",
          "description": "The vendor accepts it, or a working attack shows it."
        },
        {
          "text": "NOT_DEFINED",
          "description": "The scorer gave no value, so the metric does not change the score."
        }
      ]
    },
    {
      "name": "CvssV2CollateralDamagePotential",
      "definition_uri": "https://w3id.org/lmodel/cve/CvssV2CollateralDamagePotential",
      "annotations": [
        {
          "tag": "upstream_path",
          "value": "imports/cvss/cvss-v2.0.json#/definitions/collateralDamagePotentialType"
        }
      ],
      "description": "How much loss could follow beyond the system itself.",
      "from_schema": "https://w3id.org/lmodel/cve/cve_cvss",
      "permissible_values": [
        {
          "text": "NONE",
          "description": "No such loss."
        },
        {
          "text": "LOW",
          "description": "Slight loss."
        },
        {
          "text": "LOW_MEDIUM",
          "description": "Moderate loss."
        },
        {
          "text": "MEDIUM_HIGH",
          "description": "Significant loss."
        },
        {
          "text": "HIGH",
          "description": "Catastrophic loss."
        },
        {
          "text": "NOT_DEFINED",
          "description": "The scorer gave no value, so the metric does not change the score."
        }
      ]
    },
    {
      "name": "CvssV2TargetDistribution",
      "definition_uri": "https://w3id.org/lmodel/cve/CvssV2TargetDistribution",
      "annotations": [
        {
          "tag": "upstream_path",
          "value": "imports/cvss/cvss-v2.0.json#/definitions/targetDistributionType"
        }
      ],
      "description": "How much of the environment the flaw exposes.",
      "from_schema": "https://w3id.org/lmodel/cve/cve_cvss",
      "permissible_values": [
        {
          "text": "NONE",
          "description": "No systems at all, or only in a lab."
        },
        {
          "text": "LOW",
          "description": "Up to about a quarter of systems."
        },
        {
          "text": "MEDIUM",
          "description": "About a quarter to three quarters of systems."
        },
        {
          "text": "HIGH",
          "description": "More than about three quarters of systems."
        },
        {
          "text": "NOT_DEFINED",
          "description": "The scorer gave no value, so the metric does not change the score."
        }
      ]
    },
    {
      "name": "CvssRequirement",
      "definition_uri": "https://w3id.org/lmodel/cve/CvssRequirement",
      "annotations": [
        {
          "tag": "upstream_path",
          "value": "imports/cvss/cvss-v2.0.json#/definitions/ciaRequirementType imports/cvss/cvss-v3.0.json#/definitions/ciaRequirementType imports/cvss/cvss-v3.1.json#/definitions/ciaRequirementType imports/cvss/cvss-v4.0.json#/definitions/ciaRequirementType"
        }
      ],
      "description": "How much one security property matters to the scorer.",
      "from_schema": "https://w3id.org/lmodel/cve/cve_cvss",
      "permissible_values": [
        {
          "text": "LOW",
          "description": "A loss would have limited effect."
        },
        {
          "text": "MEDIUM",
          "description": "A loss would have serious effect."
        },
        {
          "text": "HIGH",
          "description": "A loss would have catastrophic effect."
        },
        {
          "text": "NOT_DEFINED",
          "description": "The scorer gave no value, so the metric does not change the score."
        }
      ]
    },
    {
      "name": "CvssV3AttackVector",
      "definition_uri": "https://w3id.org/lmodel/cve/CvssV3AttackVector",
      "annotations": [
        {
          "tag": "upstream_path",
          "value": "imports/cvss/cvss-v3.0.json#/definitions/attackVectorType imports/cvss/cvss-v3.1.json#/definitions/attackVectorType"
        }
      ],
      "description": "How far away an attacker can be, in CVSS 3's terms.",
      "from_schema": "https://w3id.org/lmodel/cve/cve_cvss",
      "permissible_values": [
        {
          "text": "NETWORK",
          "description": "From anywhere that can route to the system."
        },
        {
          "text": "ADJACENT_NETWORK",
          "description": "Only from a logically nearby network."
        },
        {
          "text": "LOCAL",
          "description": "Only by acting on the system itself, directly or through a user."
        },
        {
          "text": "PHYSICAL",
          "description": "Only by touching the hardware."
        }
      ]
    },
    {
      "name": "CvssV3ModifiedAttackVector",
      "definition_uri": "https://w3id.org/lmodel/cve/CvssV3ModifiedAttackVector",
      "annotations": [
        {
          "tag": "upstream_path",
          "value": "imports/cvss/cvss-v3.0.json#/definitions/modifiedAttackVectorType imports/cvss/cvss-v3.1.json#/definitions/modifiedAttackVectorType"
        }
      ],
      "description": "The attack vector as the scorer's environment changes it, in CVSS 3's terms.",
      "from_schema": "https://w3id.org/lmodel/cve/cve_cvss",
      "permissible_values": [
        {
          "text": "NETWORK",
          "description": "From anywhere that can route to the system."
        },
        {
          "text": "ADJACENT_NETWORK",
          "description": "Only from a logically nearby network."
        },
        {
          "text": "LOCAL",
          "description": "Only by acting on the system itself, directly or through a user."
        },
        {
          "text": "PHYSICAL",
          "description": "Only by touching the hardware."
        },
        {
          "text": "NOT_DEFINED",
          "description": "The scorer gave no value, so the base metric stands."
        }
      ]
    },
    {
      "name": "CvssAttackComplexity",
      "definition_uri": "https://w3id.org/lmodel/cve/CvssAttackComplexity",
      "annotations": [
        {
          "tag": "upstream_path",
          "value": "imports/cvss/cvss-v3.0.json#/definitions/attackComplexityType imports/cvss/cvss-v3.1.json#/definitions/attackComplexityType imports/cvss/cvss-v4.0.json#/definitions/attackComplexityType"
        }
      ],
      "description": "How much is outside the attacker's control.",
      "from_schema": "https://w3id.org/lmodel/cve/cve_cvss",
      "permissible_values": [
        {
          "text": "HIGH",
          "description": "Success depends on conditions the attacker must overcome or wait for."
        },
        {
          "text": "LOW",
          "description": "The attacker can succeed again and again with no special effort."
        }
      ]
    },
    {
      "name": "CvssModifiedAttackComplexity",
      "definition_uri": "https://w3id.org/lmodel/cve/CvssModifiedAttackComplexity",
      "annotations": [
        {
          "tag": "upstream_path",
          "value": "imports/cvss/cvss-v3.0.json#/definitions/modifiedAttackComplexityType imports/cvss/cvss-v3.1.json#/definitions/modifiedAttackComplexityType imports/cvss/cvss-v4.0.json#/definitions/modifiedAttackComplexityType"
        }
      ],
      "description": "The attack complexity as the scorer's environment changes it.",
      "from_schema": "https://w3id.org/lmodel/cve/cve_cvss",
      "permissible_values": [
        {
          "text": "HIGH",
          "description": "Success depends on conditions the attacker must overcome or wait for."
        },
        {
          "text": "LOW",
          "description": "The attacker can succeed again and again with no special effort."
        },
        {
          "text": "NOT_DEFINED",
          "description": "The scorer gave no value, so the base metric stands."
        }
      ]
    },
    {
      "name": "CvssPrivilegesRequired",
      "definition_uri": "https://w3id.org/lmodel/cve/CvssPrivilegesRequired",
      "annotations": [
        {
          "tag": "upstream_path",
          "value": "imports/cvss/cvss-v3.0.json#/definitions/privilegesRequiredType imports/cvss/cvss-v3.1.json#/definitions/privilegesRequiredType imports/cvss/cvss-v4.0.json#/definitions/privilegesRequiredType"
        }
      ],
      "description": "What access an attacker needs beforehand.",
      "from_schema": "https://w3id.org/lmodel/cve/cve_cvss",
      "permissible_values": [
        {
          "text": "HIGH",
          "description": "Administrator-level access."
        },
        {
          "text": "LOW",
          "description": "Ordinary user access."
        },
        {
          "text": "NONE",
          "description": "No access at all."
        }
      ]
    },
    {
      "name": "CvssModifiedPrivilegesRequired",
      "definition_uri": "https://w3id.org/lmodel/cve/CvssModifiedPrivilegesRequired",
      "annotations": [
        {
          "tag": "upstream_path",
          "value": "imports/cvss/cvss-v3.0.json#/definitions/modifiedPrivilegesRequiredType imports/cvss/cvss-v3.1.json#/definitions/modifiedPrivilegesRequiredType imports/cvss/cvss-v4.0.json#/definitions/modifiedPrivilegesRequiredType"
        }
      ],
      "description": "The access needed as the scorer's environment changes it.",
      "from_schema": "https://w3id.org/lmodel/cve/cve_cvss",
      "permissible_values": [
        {
          "text": "HIGH",
          "description": "Administrator-level access."
        },
        {
          "text": "LOW",
          "description": "Ordinary user access."
        },
