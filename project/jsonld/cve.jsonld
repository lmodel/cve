        },
        {
          "name": "programRoutines",
          "annotations": [
            {
              "tag": "upstream_path",
              "value": "CVE_Record_Format.json#/definitions/product/properties/programRoutines",
              "@type": "Annotation"
            }
          ],
          "description": "The affected functions or similar routines in the source.",
          "list_elements_unique": true,
          "range": "CveProgramRoutine",
          "multivalued": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "platforms",
          "annotations": [
            {
              "tag": "upstream_path",
              "value": "CVE_Record_Format.json#/definitions/product/properties/platforms",
              "@type": "Annotation"
            }
          ],
          "description": "The platforms the flaw is limited to. Without this, it applies to all of them.",
          "list_elements_unique": true,
          "range": "cve_text_up_to_1024",
          "multivalued": true,
          "minimum_cardinality": 1,
          "@type": "SlotDefinition"
        },
        {
          "name": "repo",
          "annotations": [
            {
              "tag": "upstream_path",
              "value": "CVE_Record_Format.json#/definitions/product/properties/repo",
              "@type": "Annotation"
            }
          ],
          "description": "The address of the product's source code repository.",
          "close_mappings": [
            "schema:codeRepository"
          ],
          "range": "cve_uri",
          "@type": "SlotDefinition"
        },
        {
          "name": "defaultStatus",
          "annotations": [
            {
              "tag": "upstream_path",
              "value": "CVE_Record_Format.json#/definitions/product/properties/defaultStatus",
              "@type": "Annotation"
            }
          ],
          "description": "The status of every version the versions list does not cover.",
          "comments": [
            "Left out, it reads as unknown, as the upstream's text says."
          ],
          "range": "CveVersionStatus",
          "@type": "SlotDefinition"
        },
        {
          "name": "versions",
          "annotations": [
            {
              "tag": "upstream_path",
              "value": "CVE_Record_Format.json#/definitions/product/properties/versions",
              "@type": "Annotation"
            }
          ],
          "description": "The versions or ranges of versions, each with its status.",
          "list_elements_unique": true,
          "range": "CveProductVersion",
          "multivalued": true,
          "inlined_as_list": true,
          "minimum_cardinality": 1,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/cve/CveProduct",
      "all_of": [
        {
          "any_of": [
            {
              "slot_conditions": [
                {
                  "name": "vendor",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                },
                {
                  "name": "product",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "collectionURL",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                },
                {
                  "name": "packageName",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        },
        {
          "any_of": [
            {
              "slot_conditions": [
                {
                  "name": "versions",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            },
            {
              "slot_conditions": [
                {
                  "name": "defaultStatus",
                  "value_presence": "PRESENT",
                  "@type": "SlotDefinition"
                }
              ],
              "@type": "AnonymousClassExpression"
            }
          ],
          "@type": "AnonymousClassExpression"
        }
      ],
      "@type": "ClassDefinition"
    },
    {
      "name": "CveProgramRoutine",
      "definition_uri": "https://w3id.org/lmodel/cve/CveProgramRoutine",
      "annotations": [
        {
          "tag": "upstream_path",
          "value": "CVE_Record_Format.json#/definitions/product/properties/programRoutines/items",
          "@type": "Annotation"
        }
      ],
      "description": "One affected function, method or similar routine in the source.",
      "from_schema": "https://w3id.org/lmodel/cve/cve_record",
      "slots": [
        "CveProgramRoutine_name"
      ],
      "slot_usage": {},
      "class_uri": "https://w3id.org/lmodel/cve/CveProgramRoutine",
      "@type": "ClassDefinition"
    },
    {
      "name": "CveProductVersion",
      "definition_uri": "https://w3id.org/lmodel/cve/CveProductVersion",
      "annotations": [
        {
          "tag": "upstream_path",
          "value": "CVE_Record_Format.json#/definitions/product/properties/versions/items",
          "@type": "Annotation"
        }
      ],
      "description": "A single version or a stretch of versions, and whether it is affected.",
      "from_schema": "https://w3id.org/lmodel/cve/cve_record",
      "slots": [
        "CveProductVersion_version",
        "CveProductVersion_status",
        "cveProductVersion__versionType",
        "cveProductVersion__lessThan",
        "cveProductVersion__lessThanOrEqual",
        "cveProductVersion__changes"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "versionType",
          "annotations": [
            {
              "tag": "upstream_path",
              "value": "CVE_Record_Format.json#/definitions/product/properties/versions/items/properties/versionType",
              "@type": "Annotation"
            }
          ],
          "description": "The numbering system that says how these versions compare, such as semver or git.",
          "comments": [
            "The upstream lists examples, not a closed list, so this is free text."
          ],
          "range": "cve_text_128",
          "@type": "SlotDefinition"
        },
        {
          "name": "lessThan",
          "annotations": [
            {
              "tag": "upstream_path",
              "value": "CVE_Record_Format.json#/definitions/product/properties/versions/items/properties/lessThan",
              "@type": "Annotation"
            }
          ],
          "description": "The first version above the range, which is not itself in it.",
          "range": "cve_version",
          "@type": "SlotDefinition"
        },
        {
          "name": "lessThanOrEqual",
          "annotations": [
            {
              "tag": "upstream_path",
              "value": "CVE_Record_Format.json#/definitions/product/properties/versions/items/properties/lessThanOrEqual",
              "@type": "Annotation"
            }
          ],
          "description": "The last version in the range.",
          "range": "cve_version",
          "@type": "SlotDefinition"
        },
        {
          "name": "changes",
          "annotations": [
            {
              "tag": "upstream_path",
              "value": "CVE_Record_Format.json#/definitions/product/properties/versions/items/properties/changes",
              "@type": "Annotation"
            }
          ],
          "description": "The points within the range where the status changes.",
          "comments": [
            "A reader must sort them, as the upstream says the order cannot be trusted."
          ],
          "list_elements_unique": true,
          "range": "CveVersionChange",
          "multivalued": true,
          "inlined_as_list": true,
          "minimum_cardinality": 1,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/cve/CveProductVersion",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "lessThan",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "versionType",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "An entry with lessThan also has versionType.",
          "title": "a range below a limit names its version type",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "lessThanOrEqual",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "versionType",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "An entry with lessThanOrEqual also has versionType.",
          "title": "a range up to a limit names its version type",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "lessThan",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "lessThanOrEqual",
                "value_presence": "ABSENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "An entry with lessThan has no lessThanOrEqual.",
          "title": "a range has one upper limit",
          "@type": "ClassRule"
        },
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "changes",
                "value_presence": "PRESENT",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "any_of": [
              {
                "slot_conditions": [
                  {
                    "name": "lessThan",
                    "value_presence": "PRESENT",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              },
              {
                "slot_conditions": [
                  {
                    "name": "lessThanOrEqual",
                    "value_presence": "PRESENT",
                    "@type": "SlotDefinition"
                  }
                ],
                "@type": "AnonymousClassExpression"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "An entry with changes also has lessThan or lessThanOrEqual.",
          "title": "status changes belong to a range",
          "@type": "ClassRule"
        }
      ],
      "@type": "ClassDefinition"
    },
