    {
      "name": "VulnerabilityStatus",
      "definition_uri": "https://w3id.org/lmodel/vulnerability-core/VulnerabilityStatus",
      "description": "Lifecycle state of a vulnerability record.",
      "from_schema": "https://w3id.org/lmodel/vulnerability-core",
      "permissible_values": [
        {
          "text": "ACTIVE",
          "description": "Vulnerability is actively maintained and published."
        },
        {
          "text": "REJECTED",
          "description": "CVE ID was rejected and should not be used."
        },
        {
          "text": "DISPUTED",
          "description": "The vulnerability details are disputed by a party."
        },
        {
          "text": "RESERVED",
          "description": "CVE ID is reserved but details are not yet published."
        },
        {
          "text": "DEPRECATED",
          "description": "Entry has been superseded or withdrawn."
        }
      ]
    },
    {
      "name": "ImpactSeverity",
      "definition_uri": "https://w3id.org/lmodel/vulnerability-core/ImpactSeverity",
      "description": "CVSS qualitative severity rating.",
      "from_schema": "https://w3id.org/lmodel/vulnerability-core",
      "permissible_values": [
        {
          "text": "NONE",
          "description": "No measurable impact."
        },
        {
          "text": "LOW",
          "description": "Limited impact; exploitation requires specific conditions."
        },
        {
          "text": "MEDIUM",
          "description": "Moderate impact; partial compromise of security properties."
        },
        {
          "text": "HIGH",
          "description": "High impact; significant compromise of security properties."
        },
        {
          "text": "CRITICAL",
          "description": "Critical impact; complete compromise; remote exploitation likely."
        },
        {
          "text": "UNKNOWN",
          "description": "Severity has not been assessed or is unavailable."
        }
      ]
    }
  ],
  "slots": [
    {
      "name": "data_type",
      "definition_uri": "https://w3id.org/lmodel/cve/data_type",
      "description": "Indicates the type of information represented in the JSON instance.",
      "in_subset": [
        "cve_record"
      ],
      "from_schema": "https://w3id.org/lmodel/cve",
      "aliases": [
        "dataType"
      ],
      "slot_uri": "https://w3id.org/lmodel/cve/data_type",
      "ifabsent": "DataType(CVE_RECORD)",
      "owner": "CVERecord",
      "domain_of": [
        "CVERecord"
      ],
      "range": "DataType",
      "@type": "SlotDefinition"
    },
    {
      "name": "data_version",
      "definition_uri": "https://w3id.org/lmodel/cve/data_version",
      "description": "The version of the CVE schema used for validating this record. Supports multiple versions of the format (e.g., '5.2.0').",
      "in_subset": [
        "cve_record"
      ],
      "from_schema": "https://w3id.org/lmodel/cve",
      "aliases": [
        "dataVersion"
      ],
      "slot_uri": "https://w3id.org/lmodel/cve/data_version",
      "ifabsent": "string(5.2.0)",
      "owner": "CVERecord",
      "domain_of": [
        "CVERecord"
      ],
      "range": "string",
      "pattern": "^5\\.(0|[1-9][0-9]*)(\\.(0|[1-9][0-9]*))?$",
      "@type": "SlotDefinition"
    },
    {
      "name": "cve_metadata",
      "definition_uri": "https://w3id.org/lmodel/cve/cve_metadata",
      "description": "Metadata about the CVE ID. A Published record uses CveMetadataPublished; a Rejected record uses CveMetadataRejected.",
      "in_subset": [
        "cve_record"
      ],
      "from_schema": "https://w3id.org/lmodel/cve",
      "aliases": [
        "cveMetadata"
      ],
      "slot_uri": "https://w3id.org/lmodel/cve/cve_metadata",
      "owner": "CVERecord",
      "domain_of": [
        "CVERecord"
      ],
      "range": "CveMetadata",
      "inlined": true,
      "inlined_as_list": true,
      "any_of": [
        {
          "range": "CveMetadataPublished",
          "@type": "AnonymousSlotExpression"
        },
        {
          "range": "CveMetadataRejected",
          "@type": "AnonymousSlotExpression"
        }
      ],
      "@type": "SlotDefinition"
    },
    {
      "name": "containers",
      "definition_uri": "https://w3id.org/lmodel/cve/containers",
      "description": "A set of containers (CNA and optionally ADP) holding vulnerability information related to the CVE ID.",
      "in_subset": [
        "cve_record"
      ],
      "from_schema": "https://w3id.org/lmodel/cve",
      "slot_uri": "https://w3id.org/lmodel/cve/containers",
      "owner": "CVERecord",
      "domain_of": [
        "CVERecord"
      ],
      "range": "Containers",
      "inlined": true,
      "inlined_as_list": true,
      "@type": "SlotDefinition"
    },
    {
      "name": "record_cve_id",
      "definition_uri": "https://w3id.org/lmodel/cve/record_cve_id",
      "description": "The CVE identifier that this record pertains to.",
      "in_subset": [
        "cna_metadata"
      ],
      "from_schema": "https://w3id.org/lmodel/cve",
      "aliases": [
        "cveId"
      ],
      "slot_uri": "https://w3id.org/lmodel/cve/record_cve_id",
      "owner": "CveMetadataRejected",
      "domain_of": [
        "CveMetadataPublished",
        "CveMetadataRejected"
      ],
      "range": "CveId",
      "pattern": "^CVE-[0-9]{4}-[0-9]{4,19}$",
      "@type": "SlotDefinition"
    },
    {
      "name": "assigner_org_id",
      "definition_uri": "https://w3id.org/lmodel/cve/assigner_org_id",
      "description": "The UUID for the organization to which the CVE ID was originally assigned. This UUID can be used to lookup the organization record in the user registry service.",
      "in_subset": [
        "cna_metadata"
      ],
      "from_schema": "https://w3id.org/lmodel/cve",
      "aliases": [
        "assignerOrgId"
      ],
      "slot_uri": "https://w3id.org/lmodel/cve/assigner_org_id",
      "owner": "CveMetadataRejected",
      "domain_of": [
        "CveMetadataPublished",
        "CveMetadataRejected"
      ],
      "range": "UuidType",
      "@type": "SlotDefinition"
    },
    {
      "name": "assigner_short_name",
      "definition_uri": "https://w3id.org/lmodel/cve/assigner_short_name",
      "description": "The short name for the organization to which the CVE ID was originally assigned.",
      "in_subset": [
        "cna_metadata"
      ],
      "from_schema": "https://w3id.org/lmodel/cve",
      "aliases": [
        "assignerShortName"
      ],
      "slot_uri": "https://w3id.org/lmodel/cve/assigner_short_name",
      "owner": "CveMetadataRejected",
      "domain_of": [
        "CveMetadataPublished",
        "CveMetadataRejected"
      ],
      "range": "string",
      "pattern": "^.{2,32}$",
      "@type": "SlotDefinition"
    },
    {
      "name": "requester_user_id",
      "definition_uri": "https://w3id.org/lmodel/cve/requester_user_id",
      "description": "The user that requested the CVE identifier.",
      "in_subset": [
        "cna_metadata"
      ],
      "from_schema": "https://w3id.org/lmodel/cve",
      "aliases": [
        "requesterUserId"
      ],
      "slot_uri": "https://w3id.org/lmodel/cve/requester_user_id",
      "owner": "CveMetadataPublished",
      "domain_of": [
        "CveMetadataPublished"
      ],
      "range": "UuidType",
      "@type": "SlotDefinition"
    },
    {
      "name": "serial",
      "definition_uri": "https://w3id.org/lmodel/cve/serial",
      "description": "Monotonically increasing integer, starting at 1, incremented each time a submission from a data provider changes this CVE Record.",
      "in_subset": [
        "cna_metadata"
      ],
      "from_schema": "https://w3id.org/lmodel/cve",
      "slot_uri": "https://w3id.org/lmodel/cve/serial",
      "owner": "CveMetadataRejected",
      "domain_of": [
        "CveMetadataPublished",
        "CveMetadataRejected"
      ],
      "range": "integer",
      "minimum_value": 1,
      "@type": "SlotDefinition"
    },
    {
      "name": "date_reserved",
      "definition_uri": "https://w3id.org/lmodel/cve/date_reserved",
      "description": "The date/time this CVE ID was reserved in the CVE automation workgroup services system. This date does not necessarily indicate when the vulnerability was discovered, shared with the vendor, or publicly disclosed.",
      "in_subset": [
        "cna_metadata"
      ],
      "from_schema": "https://w3id.org/lmodel/cve",
      "aliases": [
        "dateReserved"
      ],
      "slot_uri": "https://w3id.org/lmodel/cve/date_reserved",
      "owner": "CveMetadataRejected",
      "domain_of": [
        "CveMetadataPublished",
        "CveMetadataRejected"
      ],
      "range": "Timestamp",
      "@type": "SlotDefinition"
    },
    {
      "name": "date_published",
      "definition_uri": "https://w3id.org/lmodel/cve/date_published",
      "description": "The date/time the CVE Record was first published in the CVE List.",
      "in_subset": [
        "cna_metadata"
      ],
      "from_schema": "https://w3id.org/lmodel/cve",
      "aliases": [
        "datePublished"
      ],
      "related_mappings": [
        "https://w3id.org/lmodel/kev-catalog/date_added"
      ],
      "slot_uri": "https://w3id.org/lmodel/cve/date_published",
      "owner": "CveMetadataRejected",
      "domain_of": [
        "CveMetadataPublished",
        "CveMetadataRejected"
      ],
      "range": "Timestamp",
      "@type": "SlotDefinition"
    },
    {
      "name": "date_updated",
      "definition_uri": "https://w3id.org/lmodel/cve/date_updated",
      "description": "The date/time the record was last updated.",
