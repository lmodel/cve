    {
      "name": "collection_url",
      "definition_uri": "https://w3id.org/lmodel/cve/collection_url",
      "annotations": [
        {
          "tag": "min_length",
          "value": 1,
          "@type": "Annotation"
        },
        {
          "tag": "max_length",
          "value": 2048,
          "@type": "Annotation"
        }
      ],
