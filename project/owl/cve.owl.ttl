	cve:upstream_path "imports/cvss/cvss-v3.0.json#/properties/privilegesRequired imports/cvss/cvss-v3.1.json#/properties/privilegesRequired imports/cvss/cvss-v4.0.json#/properties/privilegesRequired" .
cve:problemTypes a owl:ObjectProperty ;
	rdfs:label "problemTypes" ;
	rdfs:range cve:CveProblemType ;
