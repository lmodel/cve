	skos:definition "The platforms the flaw is limited to. Without this, it applies to all of them." ;
	skos:inScheme cve:cve_record ;
	cve:upstream_path "CVE_Record_Format.json#/definitions/product/properties/platforms" .
cve:privilegesRequired a owl:DatatypeProperty ;
	rdfs:label "privilegesRequired" ;
	skos:closeMatch <http://w3id.org/sepses/vocab/ref/cvss#privilegesRequired> ;
