cve:modifiedScope a owl:ObjectProperty ;
	rdfs:label "modifiedScope" ;
	rdfs:range cve:CvssV3ModifiedScope ;
	skos:definition "The scope as the scorer's own environment changes it." ;
	skos:inScheme cve:cve_cvss ;
	cve:upstream_path "imports/cvss/cvss-v3.0.json#/properties/modifiedScope imports/cvss/cvss-v3.1.json#/properties/modifiedScope" .
cve:modifiedSubAvailabilityImpact a owl:ObjectProperty ;
	rdfs:label "modifiedSubAvailabilityImpact" ;
	skos:definition "The availability impact on connected systems, in the scorer's environment." ;
	skos:inScheme cve:cve_cvss ;
	cve:upstream_path "imports/cvss/cvss-v4.0.json#/properties/modifiedSubAvailabilityImpact" .
cve:modifiedSubConfidentialityImpact a owl:ObjectProperty ;
