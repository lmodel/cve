<https://w3id.org/lmodel/cve/ImpactSeverity#CRITICAL> a owl:Class ;
    rdfs:label "CRITICAL" ;
    rdfs:subClassOf cve:ImpactSeverity ;
    skos:definition "Critical impact; complete compromise; remote exploitation likely." .

<https://w3id.org/lmodel/cve/ImpactSeverity#HIGH> a owl:Class ;
    rdfs:label "HIGH" ;
    rdfs:subClassOf cve:ImpactSeverity ;
    skos:definition "High impact; significant compromise of security properties." .

<https://w3id.org/lmodel/cve/ImpactSeverity#LOW> a owl:Class ;
    rdfs:label "LOW" ;
    rdfs:subClassOf cve:ImpactSeverity ;
    skos:definition "Limited impact; exploitation requires specific conditions." .

<https://w3id.org/lmodel/cve/ImpactSeverity#MEDIUM> a owl:Class ;
    rdfs:label "MEDIUM" ;
    rdfs:subClassOf cve:ImpactSeverity ;
    skos:definition "Moderate impact; partial compromise of security properties." .

<https://w3id.org/lmodel/cve/ImpactSeverity#NONE> a owl:Class ;
    rdfs:label "NONE" ;
    rdfs:subClassOf cve:ImpactSeverity ;
    skos:definition "No measurable impact." .

<https://w3id.org/lmodel/cve/ImpactSeverity#UNKNOWN> a owl:Class ;
    rdfs:label "UNKNOWN" ;
    rdfs:subClassOf cve:ImpactSeverity ;
    skos:definition "Severity has not been assessed or is unavailable." .

cve:MetricScenario a owl:Class ;
    rdfs:label "MetricScenario" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cve:lang ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cve:lang ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cve:scenario_value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:scenario_value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:lang ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cve:scenario_value ] ;
    skos:definition "A scenario description indicating the context in which a metric applies. If no specific scenario is given, GENERAL is used as the default." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:OtherMetric a owl:Class ;
    rdfs:label "OtherMetric" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cve:other_metric_content ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:other_metric_type ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cve:other_metric_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:other_metric_content ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cve:other_metric_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom cve:Any ;
            owl:onProperty cve:other_metric_content ] ;
    skos:definition "A non-standard impact description in a custom format. May be a prose description or an arbitrary JSON-compatible object." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:ProblemTypeDescription a owl:Class ;
    rdfs:label "ProblemTypeDescription" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:lang ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:problem_description ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cve:problem_source_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cve:problem_description ],
        [ a owl:Restriction ;
            owl:allValuesFrom cve:CveReference ;
            owl:onProperty cve:problem_references ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:problem_source_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:problem_references ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cve:lang ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/cwe_id> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cve:lang ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cve:problem_description ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:problem_source_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^CWE-[1-9][0-9]*$" ] ) ] ) ] ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/cwe_id> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/cwe_id> ] ;
    skos:closeMatch cwe:Weakness ;
    skos:definition "Individual problem type description entry." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:ProgramRoutine a owl:Class ;
    rdfs:label "ProgramRoutine" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:routine_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cve:routine_name ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cve:routine_name ] ;
    skos:definition "An affected source code function, method, subroutine, or procedure." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

<https://w3id.org/lmodel/cve/RecordState#PUBLISHED> a owl:Class ;
    rdfs:label "PUBLISHED" ;
    rdfs:subClassOf cve:RecordState ;
    skos:definition "The CVE ID has associated vulnerability data published in the CVE List." .

<https://w3id.org/lmodel/cve/RecordState#REJECTED> a owl:Class ;
    rdfs:label "REJECTED" ;
    rdfs:subClassOf cve:RecordState ;
    skos:definition "The CVE ID has been rejected and should not be used." .

<https://w3id.org/lmodel/cve/ReferenceTag#broken-link> a owl:Class ;
    rdfs:label "broken-link" ;
    rdfs:subClassOf cve:ReferenceTag ;
    skos:definition "The reference link is returning a 404 error, or the site is no longer online." .

<https://w3id.org/lmodel/cve/ReferenceTag#customer-entitlement> a owl:Class ;
    rdfs:label "customer-entitlement" ;
    rdfs:subClassOf cve:ReferenceTag ;
    skos:definition "Similar to Privileges Required, but specific to references that require non-public or paid access for customers of the particular vendor." .

<https://w3id.org/lmodel/cve/ReferenceTag#exploit> a owl:Class ;
    rdfs:label "exploit" ;
    rdfs:subClassOf cve:ReferenceTag ;
    skos:definition "Reference contains an in-depth description of steps to exploit a vulnerability OR contains legitimate Proof of Concept (PoC) code or an exploit kit." .

<https://w3id.org/lmodel/cve/ReferenceTag#government-resource> a owl:Class ;
    rdfs:label "government-resource" ;
    rdfs:subClassOf cve:ReferenceTag ;
    skos:definition "All reference links that are from a government agency or organization." .

<https://w3id.org/lmodel/cve/ReferenceTag#issue-tracking> a owl:Class ;
    rdfs:label "issue-tracking" ;
    rdfs:subClassOf cve:ReferenceTag ;
    skos:definition "The reference is a post from a bug tracking tool such as MantisBT, Bugzilla, JIRA, GitHub Issues, etc." .

<https://w3id.org/lmodel/cve/ReferenceTag#mailing-list> a owl:Class ;
    rdfs:label "mailing-list" ;
    rdfs:subClassOf cve:ReferenceTag ;
    skos:definition "The reference is from a mailing list -- often specific to a product or vendor." .

<https://w3id.org/lmodel/cve/ReferenceTag#media-coverage> a owl:Class ;
    rdfs:label "media-coverage" ;
    rdfs:subClassOf cve:ReferenceTag ;
    skos:definition "The reference is from a media outlet such as a newspaper, magazine, social media, or weblog. Not intended for individual personal social media accounts." .

<https://w3id.org/lmodel/cve/ReferenceTag#mitigation> a owl:Class ;
    rdfs:label "mitigation" ;
    rdfs:subClassOf cve:ReferenceTag ;
    skos:definition "The reference contains information on steps to mitigate against the vulnerability when a patch cannot be applied or is unavailable, or for EOL product situations." .

<https://w3id.org/lmodel/cve/ReferenceTag#not-applicable> a owl:Class ;
    rdfs:label "not-applicable" ;
    rdfs:subClassOf cve:ReferenceTag ;
    skos:definition "The reference link is not applicable to the vulnerability and was likely associated accidentally (should be used sparingly)." .

<https://w3id.org/lmodel/cve/ReferenceTag#patch> a owl:Class ;
    rdfs:label "patch" ;
    rdfs:subClassOf cve:ReferenceTag ;
    skos:definition "The reference contains an update to the software that fixes the vulnerability." .

<https://w3id.org/lmodel/cve/ReferenceTag#permissions-required> a owl:Class ;
    rdfs:label "permissions-required" ;
    rdfs:subClassOf cve:ReferenceTag ;
    skos:definition "The reference link provided is blocked by a logon page." .

<https://w3id.org/lmodel/cve/ReferenceTag#product> a owl:Class ;
    rdfs:label "product" ;
    rdfs:subClassOf cve:ReferenceTag ;
    skos:definition "A reference appropriate for describing a product for the purpose of CPE or SWID." .

<https://w3id.org/lmodel/cve/ReferenceTag#related> a owl:Class ;
    rdfs:label "related" ;
    rdfs:subClassOf cve:ReferenceTag ;
    skos:definition "A reference that is for a related (but not the same) vulnerability." .

<https://w3id.org/lmodel/cve/ReferenceTag#release-notes> a owl:Class ;
    rdfs:label "release-notes" ;
    rdfs:subClassOf cve:ReferenceTag ;
    skos:definition "The reference is in the format of a vendor or open source project's release notes or change log." .

<https://w3id.org/lmodel/cve/ReferenceTag#signature> a owl:Class ;
    rdfs:label "signature" ;
    rdfs:subClassOf cve:ReferenceTag ;
    skos:definition "The reference contains a method to detect or prevent the presence or exploitation of the vulnerability." .

<https://w3id.org/lmodel/cve/ReferenceTag#technical-description> a owl:Class ;
    rdfs:label "technical-description" ;
    rdfs:subClassOf cve:ReferenceTag ;
    skos:definition "The reference contains in-depth technical information about a vulnerability and its exploitation process, typically in the form of a presentation or whitepaper." .

<https://w3id.org/lmodel/cve/ReferenceTag#third-party-advisory> a owl:Class ;
    rdfs:label "third-party-advisory" ;
    rdfs:subClassOf cve:ReferenceTag ;
    skos:definition "Advisory is from an organization that is not the vulnerable product's vendor, publisher, or maintainer." .

<https://w3id.org/lmodel/cve/ReferenceTag#vdb-entry> a owl:Class ;
    rdfs:label "vdb-entry" ;
    rdfs:subClassOf cve:ReferenceTag ;
    skos:definition "VDBs are loosely defined as sites that provide information about this vulnerability, such as advisories, with identifiers." .

<https://w3id.org/lmodel/cve/ReferenceTag#vendor-advisory> a owl:Class ;
    rdfs:label "vendor-advisory" ;
    rdfs:subClassOf cve:ReferenceTag ;
    skos:definition "Advisory is from the vendor, publisher, or maintainer of the product or the parent organization." .

cve:SupportingMedia a owl:Class ;
    rdfs:label "SupportingMedia" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cve:media_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:media_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cve:media_value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:base64_encoded ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:base64_encoded ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cve:media_value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cve:media_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:media_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty cve:base64_encoded ] ;
    skos:definition "Supporting media data for a description such as markdown, diagrams, etc. Similar to RFC 2397, each media object has a media type, data value, and an optional base64 flag." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:TaxonomyRelation a owl:Class ;
    rdfs:label "TaxonomyRelation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:taxonomy_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cve:relationship_value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cve:relationship_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:relationship_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cve:taxonomy_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cve:relationship_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cve:relationship_value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cve:taxonomy_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:relationship_value ] ;
    skos:closeMatch cwe:Relationship ;
    skos:definition "A relationship between a taxonomy item and a CVE or another taxonomy item. Provides subject (taxonomyId), predicate (relationshipName), and object (relationshipValue)." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:VersionChange a owl:Class ;
    rdfs:label "VersionChange" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cve:VersionStatus ;
            owl:onProperty cve:change_status ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:change_status ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cve:change_status ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cve:change_at ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cve:change_at ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:change_at ] ;
    skos:definition "A status change that takes place at a specific point within a version range." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

<https://w3id.org/lmodel/cve/VersionStatus#affected> a owl:Class ;
    rdfs:label "affected" ;
    rdfs:subClassOf cve:VersionStatus ;
    skos:definition "The version is affected by the vulnerability." .

<https://w3id.org/lmodel/cve/VersionStatus#unaffected> a owl:Class ;
    rdfs:label "unaffected" ;
    rdfs:subClassOf cve:VersionStatus ;
    skos:definition "The version is not affected by the vulnerability." .

<https://w3id.org/lmodel/cve/VersionStatus#unknown> a owl:Class ;
    rdfs:label "unknown" ;
    rdfs:subClassOf cve:VersionStatus ;
    skos:definition "It is unknown or unspecified whether the version is affected." .

<https://w3id.org/lmodel/cve/VulnerabilityStatus#ACTIVE> a owl:Class ;
    rdfs:label "ACTIVE" ;
    rdfs:subClassOf cve:VulnerabilityStatus ;
    skos:definition "Vulnerability is actively maintained and published." .

<https://w3id.org/lmodel/cve/VulnerabilityStatus#DEPRECATED> a owl:Class ;
    rdfs:label "DEPRECATED" ;
    rdfs:subClassOf cve:VulnerabilityStatus ;
    skos:definition "Entry has been superseded or withdrawn." .

<https://w3id.org/lmodel/cve/VulnerabilityStatus#DISPUTED> a owl:Class ;
    rdfs:label "DISPUTED" ;
    rdfs:subClassOf cve:VulnerabilityStatus ;
    skos:definition "The vulnerability details are disputed by a party." .

<https://w3id.org/lmodel/cve/VulnerabilityStatus#REJECTED> a owl:Class ;
    rdfs:label "REJECTED" ;
    rdfs:subClassOf cve:VulnerabilityStatus ;
    skos:definition "CVE ID was rejected and should not be used." .

<https://w3id.org/lmodel/cve/VulnerabilityStatus#RESERVED> a owl:Class ;
    rdfs:label "RESERVED" ;
    rdfs:subClassOf cve:VulnerabilityStatus ;
    skos:definition "CVE ID is reserved but details are not yet published." .

cve:adp a owl:ObjectProperty ;
    rdfs:label "adp" ;
    rdfs:range cve:AdpContainer ;
    skos:definition "One or more ADP containers providing additional vulnerability information. Multiple ADPs may contribute containers for the same CVE ID." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:adp_tags a owl:DatatypeProperty ;
    rdfs:label "adp_tags" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( [ a rdfs:Datatype ;
                        owl:unionOf ( cve:ADPTag [ a rdfs:Datatype ;
                                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                                owl:onDatatype xsd:string ;
                                                owl:withRestrictions ( [ xsd:pattern "^x_.*$" ] ) ] ) ] ) ] xsd:string ) ] ;
    skos:altLabel "tags" ;
    skos:definition "Tags provided by an ADP describing the CVE Record." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:cna_tags a owl:DatatypeProperty ;
    rdfs:label "cna_tags" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( [ a rdfs:Datatype ;
                        owl:unionOf ( cve:CNATag [ a rdfs:Datatype ;
                                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                                owl:onDatatype xsd:string ;
                                                owl:withRestrictions ( [ xsd:pattern "^x_.*$" ] ) ] ) ] ) ] xsd:string ) ] ;
    skos:altLabel "tags" ;
    skos:definition "Tags provided by a CNA describing the CVE Record." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:cpe_match_criteria a owl:ObjectProperty ;
    rdfs:label "cpe_match_criteria" ;
    rdfs:range cve:CpeMatch ;
    skos:altLabel "cpeMatch" ;
    skos:definition "Array of CPE match criteria within this node." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:cpe_nodes a owl:ObjectProperty ;
    rdfs:label "cpe_nodes" ;
    rdfs:range cve:CpeNode ;
    skos:altLabel "nodes" ;
    skos:definition "Array of CPE configuration nodes." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:cpes a owl:DatatypeProperty ;
    rdfs:label "cpes" ;
    rdfs:range xsd:string ;
    skos:definition "Affected products defined by CPE (Common Platform Enumeration) names in either 2.2 or 2.3 format." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:impact_descriptions a owl:ObjectProperty ;
    rdfs:label "impact_descriptions" ;
    rdfs:range cve:MultiLangDescription ;
    skos:altLabel "descriptions" ;
    skos:definition "Prose description of the impact scenario. At a minimum, provide the description given by CAPEC." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:metric_scenarios a owl:ObjectProperty ;
    rdfs:label "metric_scenarios" ;
    rdfs:range cve:MetricScenario ;
    skos:altLabel "scenarios" ;
    skos:definition "Scenarios this metrics object applies to. If no specific scenario is given, GENERAL applies when no more specific metric matches." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:modules a owl:DatatypeProperty ;
    rdfs:label "modules" ;
    rdfs:range xsd:string ;
    skos:definition "A list of the affected components, features, modules, sub-components, sub-products, APIs, commands, utilities, programs, or functionalities." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:problem_references a owl:ObjectProperty ;
    rdfs:label "problem_references" ;
    rdfs:range cve:CveReference ;
    skos:altLabel "references" ;
    skos:definition "References supporting this specific problem type." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:problem_type_descriptions a owl:ObjectProperty ;
    rdfs:label "problem_type_descriptions" ;
    rdfs:range cve:ProblemTypeDescription ;
    skos:altLabel "descriptions" ;
    skos:definition "One or more problem type descriptions (e.g., CWE IDs or OWASP categories)." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:program_files a owl:DatatypeProperty ;
    rdfs:label "program_files" ;
    rdfs:range xsd:string ;
    skos:altLabel "programFiles" ;
    skos:definition "A list of the affected source code files." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:program_routines a owl:ObjectProperty ;
    rdfs:label "program_routines" ;
    rdfs:range cve:ProgramRoutine ;
    skos:altLabel "programRoutines" ;
    skos:definition "A list of the affected source code functions, methods, subroutines, or procedures." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:reference_tags a owl:ObjectProperty ;
    rdfs:label "reference_tags" ;
    rdfs:range cve:ReferenceTag ;
    skos:altLabel "tags" ;
    skos:definition "An array of tags describing the resource referenced by the URL." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:rejected_reasons a owl:ObjectProperty ;
    rdfs:label "rejected_reasons" ;
    rdfs:range cve:MultiLangDescription ;
    skos:altLabel "rejectedReasons" ;
    skos:definition "Reasons for rejecting this CVE Record." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:replaced_by a owl:DatatypeProperty ;
    rdfs:label "replaced_by" ;
    rdfs:range xsd:string ;
    skos:altLabel "replacedBy" ;
    skos:definition "CVE IDs that this CVE ID was rejected in favor of because this CVE ID was incorrectly assigned to the same vulnerabilities." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:source_defects a owl:DatatypeProperty ;
    rdfs:label "source_defects" ;
    rdfs:range xsd:string ;
    skos:altLabel "defects" ;
    skos:definition "Bug tracking system IDs (e.g., JIRA ticket IDs) related to the vulnerability." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:supporting_media a owl:ObjectProperty ;
    rdfs:label "supporting_media" ;
    rdfs:range cve:SupportingMedia ;
    skos:altLabel "supportingMedia" ;
    skos:definition "Supporting media data for the description such as markdown, diagrams, etc. Similar to RFC 2397, each object has a media type, data value, and optional base64 flag." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:taxonomy_relations a owl:ObjectProperty ;
    rdfs:label "taxonomy_relations" ;
    rdfs:range cve:TaxonomyRelation ;
    skos:altLabel "taxonomyRelations" ;
    skos:definition "List of relationships to the taxonomy for this vulnerability." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:version_changes a owl:ObjectProperty ;
    rdfs:label "version_changes" ;
    rdfs:range cve:VersionChange ;
    skos:altLabel "changes" ;
    skos:definition "A list of status changes that take place during the version range. The array should be sorted by 'at' field according to versionType, but clients must re-sort rather than assume ordering." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

<https://w3id.org/lmodel/vulnerability-core/Impact> a owl:Class ;
    rdfs:label "Impact" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/vector> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/vector> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/severity> ],
        [ a owl:Restriction ;
            owl:allValuesFrom cve:ImpactSeverity ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/severity> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/severity> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:float ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/score> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/score> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/vector> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/score> ] ;
    skos:closeMatch nvd:CVSSMetric ;
    skos:definition "Assessment of the vulnerability's impact and severity." ;
    skos:inScheme <https://w3id.org/lmodel/vulnerability-core> .

<https://w3id.org/lmodel/vulnerability-core/Weakness> a owl:Class ;
    rdfs:label "Weakness" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/name> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/description> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/name> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/cwe_id> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/description> ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^CWE-[1-9][0-9]*$" ] ) ] ) ] ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/cwe_id> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/name> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/description> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/cwe_id> ] ;
    skos:closeMatch cwe:Weakness,
        nvd:NVDWeakness ;
    skos:definition "Weakness classification from CWE or a similar taxonomy." ;
    skos:inScheme <https://w3id.org/lmodel/vulnerability-core> .

<https://w3id.org/lmodel/vulnerability-core/platforms> a owl:DatatypeProperty ;
    rdfs:label "platforms" ;
    rdfs:range xsd:string ;
    skos:definition "Platforms or operating environments affected." ;
    skos:inScheme <https://w3id.org/lmodel/vulnerability-core> .

<https://w3id.org/lmodel/vulnerability-core/products> a owl:ObjectProperty ;
    rdfs:label "products" ;
    rdfs:range <https://w3id.org/lmodel/vulnerability-core/Product> ;
    skos:definition "Products affected by this vulnerability." ;
    skos:inScheme <https://w3id.org/lmodel/vulnerability-core> .

<https://w3id.org/lmodel/vulnerability-core/references> a owl:ObjectProperty ;
    rdfs:label "references" ;
    rdfs:range <https://w3id.org/lmodel/vulnerability-core/Reference> ;
    skos:definition "External references such as advisories and articles." ;
    skos:inScheme <https://w3id.org/lmodel/vulnerability-core> .

<https://w3id.org/lmodel/vulnerability-core/weaknesses> a owl:ObjectProperty ;
    rdfs:label "weaknesses" ;
    rdfs:range <https://w3id.org/lmodel/vulnerability-core/Weakness> ;
    skos:definition "Weakness classifications (e.g. CWE) associated with this vulnerability." ;
    skos:inScheme <https://w3id.org/lmodel/vulnerability-core> ;
    skos:relatedMatch cwe:Weakness .

cve:ADPTag a owl:Class ;
    rdfs:label "ADPTag" ;
    skos:definition "Tags provided by an ADP describing the CVE Record." ;
    skos:inScheme <https://w3id.org/lmodel/cve> ;
    linkml:permissible_values <https://w3id.org/lmodel/cve/ADPTag#disputed> .

cve:AffectedProduct a owl:Class ;
    rdfs:label "AffectedProduct" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:cpes ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:versions ],
        [ a owl:Restriction ;
            owl:allValuesFrom cve:ProgramRoutine ;
            owl:onProperty cve:program_routines ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cve:modules ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:repo ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:collection_url ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:package_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:collection_url ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cve:cpes ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty cve:collection_url ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:package_url ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:default_status ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:program_routines ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:default_status ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:package_url ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cve:package_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom cve:VersionStatus ;
            owl:onProperty cve:default_status ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty cve:repo ],
        [ owl:intersectionOf ( [ owl:unionOf ( [ owl:intersectionOf ( [ a owl:Restriction ;
                                                owl:allValuesFrom xsd:string ;
                                                owl:onProperty cve:name ] [ a owl:Restriction ;
                                                owl:allValuesFrom xsd:string ;
                                                owl:onProperty cve:vendor ] ) ] [ owl:intersectionOf ( [ a owl:Restriction ;
                                                owl:allValuesFrom xsd:string ;
                                                owl:onProperty cve:collection_url ] [ a owl:Restriction ;
                                                owl:allValuesFrom xsd:string ;
                                                owl:onProperty cve:package_name ] ) ] ) ] [ owl:unionOf ( [ a owl:Restriction ;
                                    owl:allValuesFrom owl:Thing ;
                                    owl:onProperty cve:versions ] [ a owl:Restriction ;
                                    owl:allValuesFrom xsd:string ;
                                    owl:onProperty cve:default_status ] ) ] ) ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:package_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:repo ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:modules ],
        [ a owl:Restriction ;
            owl:allValuesFrom cve:VersionEntry ;
            owl:onProperty cve:versions ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty cve:package_url ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:program_files ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cve:program_files ],
        <https://w3id.org/lmodel/vulnerability-core/Product> ;
    skos:definition "Information about the set of products and services affected by a vulnerability. At least one of (vendor + product) or (collectionURL + packageName) is required, and at least one of versions or defaultStatus is required." ;
    skos:inScheme <https://w3id.org/lmodel/cve> ;
    skos:relatedMatch kev_catalog:KevEntry .

cve:CpeApplicabilityElement a owl:Class ;
    rdfs:label "CpeApplicabilityElement" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:cpe_operator ],
        [ a owl:Restriction ;
            owl:allValuesFrom cve:CpeNode ;
            owl:onProperty cve:cpe_nodes ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:cpe_operator ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty cve:cpe_negate ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:cpe_negate ],
        [ a owl:Restriction ;
            owl:allValuesFrom cve:CpeOperator ;
            owl:onProperty cve:cpe_operator ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cve:cpe_nodes ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:cpe_negate ] ;
    skos:closeMatch nvd:CPEConfiguration ;
    skos:definition "Affected products defined using an implementation of the CPE Applicability Language. An operator property allows AND or OR logic between CPEs or combinations of CPEs." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:CreditEntry a owl:Class ;
    rdfs:label "CreditEntry" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:credit_user ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cve:credit_user ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:credit_value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cve:lang ],
        [ a owl:Restriction ;
            owl:allValuesFrom cve:CreditType ;
            owl:onProperty cve:credit_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:credit_user ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:lang ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:credit_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:credit_type ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cve:credit_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cve:credit_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cve:lang ] ;
    skos:definition "A credit acknowledging a specific person, organization, or tool for work related to the research, discovery, remediation, or coordination of the vulnerability." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:DataType a owl:Class ;
    rdfs:label "DataType" ;
    skos:definition "Indicates the type of information represented in a CVE JSON instance." ;
    skos:inScheme <https://w3id.org/lmodel/cve> ;
    linkml:permissible_values <https://w3id.org/lmodel/cve/DataType#CVE_RECORD> .

cve:ImpactEntry a owl:Class ;
    rdfs:label "ImpactEntry" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cve:impact_descriptions ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:capec_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:capec_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom cve:MultiLangDescription ;
            owl:onProperty cve:impact_descriptions ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^CAPEC-[1-9][0-9]{0,4}$" ] ) ] ) ] ;
            owl:onProperty cve:capec_id ] ;
    skos:definition "An impact entry linking an optional CAPEC attack pattern ID to one or more prose descriptions of the impact scenario." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:MetricEntry a owl:Class ;
    rdfs:label "MetricEntry" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cve:OtherMetric ;
            owl:onProperty cve:other_metric ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:other_metric ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:metric_format ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:cvss_v4_0 ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:cvss_v3 ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:other_metric ],
        [ a owl:Restriction ;
            owl:allValuesFrom cve:CvssV20 ;
            owl:onProperty cve:cvss_v2_0 ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:cvss_v3 ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:metric_scenarios ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:cvss_v4_0 ],
        [ owl:unionOf ( [ a owl:Restriction ;
                        owl:allValuesFrom owl:Thing ;
                        owl:onProperty cve:cvss_v4_0 ] [ a owl:Restriction ;
                        owl:allValuesFrom owl:Thing ;
                        owl:onProperty cve:cvss_v3 ] [ a owl:Restriction ;
                        owl:allValuesFrom owl:Thing ;
                        owl:onProperty cve:cvss_v2_0 ] [ a owl:Restriction ;
                        owl:allValuesFrom owl:Thing ;
                        owl:onProperty cve:other_metric ] ) ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:metric_format ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cve:metric_format ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:cvss_v2_0 ],
        [ a owl:Restriction ;
            owl:allValuesFrom cve:CvssV40 ;
            owl:onProperty cve:cvss_v4_0 ],
        [ a owl:Restriction ;
            owl:allValuesFrom cve:MetricScenario ;
            owl:onProperty cve:metric_scenarios ],
        [ a owl:Restriction ;
            owl:allValuesFrom cve:CvssV3 ;
            owl:onProperty cve:cvss_v3 ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:cvss_v2_0 ] ;
    skos:closeMatch nvd:MetricSet ;
    skos:definition "A metric entry containing scoring data in one of the CVSS formats (v4.0, v3.x, v2.0) or a custom format, with optional applicability scenarios. At least one of cvss_v4_0, cvss_v3, cvss_v2_0, or other_metric is required. CVSS 3.0 and 3.1 are both represented by CvssV3 (distinguished by the cvss3_version slot)." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:ProblemType a owl:Class ;
    rdfs:label "ProblemType" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cve:problem_type_descriptions ],
        [ a owl:Restriction ;
            owl:allValuesFrom cve:ProblemTypeDescription ;
            owl:onProperty cve:problem_type_descriptions ] ;
    skos:closeMatch cwe:Weakness,
        nvd:NVDWeakness ;
    skos:definition "Problem type information (e.g., CWE identifier). Wraps one or more problem type descriptions. The CNA requirement is [PROBLEMTYPE]." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:SourceInformation a owl:Class ;
    rdfs:label "SourceInformation" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cve:source_discovery ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:source_discovery ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:source_defects ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:source_advisory ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cve:source_defects ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:source_advisory ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cve:source_advisory ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:source_discovery ] ;
    skos:definition "Source information (who discovered it, who researched it, etc.) and optionally a chain of CNA information. This is an open object — at least one property must be present." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:TaxonomyMapping a owl:Class ;
    rdfs:label "TaxonomyMapping" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:taxonomy_version ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cve:taxonomy_version ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cve:taxonomy_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom cve:TaxonomyRelation ;
            owl:onProperty cve:taxonomy_relations ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:taxonomy_version ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:taxonomy_name ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cve:taxonomy_relations ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cve:taxonomy_name ] ;
    skos:definition "A taxonomy mapping identifying the taxonomy by name and version, along with a list of relations relevant to the CVE (e.g., ATT&CK, D3FEND, CWE)." ;
    skos:exactMatch cwe:TaxonomyMapping ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:TimelineEntry a owl:Class ;
    rdfs:label "TimelineEntry" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cve:event_time ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cve:event_time ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cve:event_value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:event_time ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cve:lang ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cve:event_value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cve:lang ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:lang ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:event_value ] ;
    skos:definition "A timeline event recording a significant event about the vulnerability or changes to the CVE Record. Requires time, lang, and value." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:base64_encoded a owl:DatatypeProperty ;
    rdfs:label "base64_encoded" ;
    rdfs:range xsd:boolean ;
    skos:altLabel "base64" ;
    skos:definition "If true, the media_value field contains the media data encoded in base64. If false, the media_value field contains UTF-8 media content." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:capec_id a owl:DatatypeProperty ;
    rdfs:label "capec_id" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                        owl:onDatatype xsd:string ;
                        owl:withRestrictions ( [ xsd:pattern "^CAPEC-[1-9][0-9]{0,4}$" ] ) ] ) ] ;
    skos:altLabel "capecId" ;
    skos:definition "CAPEC ID that best relates to this impact (e.g., CAPEC-123)." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:change_at a owl:DatatypeProperty ;
    rdfs:label "change_at" ;
    rdfs:range xsd:string ;
    skos:altLabel "at" ;
    skos:definition "The version at which a status change occurs within a range." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:change_status a owl:ObjectProperty ;
    rdfs:label "change_status" ;
    rdfs:range cve:VersionStatus ;
    skos:altLabel "status" ;
    skos:definition "The new status in the range starting at the given version." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:cna a owl:ObjectProperty ;
    rdfs:label "cna" ;
    rdfs:range [ owl:intersectionOf ( [ owl:unionOf ( cve:CnaPublishedContainer cve:CnaRejectedContainer ) ] cve:CnaContainer ) ] ;
    skos:definition "The CNA container holding vulnerability information for this CVE ID. For published records, this is a CnaPublishedContainer. For rejected records, this is a CnaRejectedContainer." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:containers a owl:ObjectProperty ;
    rdfs:label "containers" ;
    rdfs:range cve:Containers ;
    skos:definition "A set of containers (CNA and optionally ADP) holding vulnerability information related to the CVE ID." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:cpe_criteria a owl:DatatypeProperty ;
    rdfs:label "cpe_criteria" ;
    rdfs:range xsd:string ;
    skos:altLabel "criteria" ;
    skos:definition "CPE 2.3 formatted name match string or match criteria." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:cpe_vulnerable a owl:DatatypeProperty ;
    rdfs:label "cpe_vulnerable" ;
    rdfs:range xsd:boolean ;
    skos:altLabel "vulnerable" ;
    skos:definition "Whether this CPE match describes a vulnerable configuration." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:credit_type a owl:ObjectProperty ;
    rdfs:label "credit_type" ;
    rdfs:range cve:CreditType ;
    skos:altLabel "type" ;
    skos:definition "Type or role of the entity being credited." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:credit_user a owl:DatatypeProperty ;
    rdfs:label "credit_user" ;
    rdfs:range xsd:string ;
    skos:altLabel "user" ;
    skos:definition "UUID of the user being credited, if present in the CVE User Registry. This UUID can be used to lookup the user record in the user registry service." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:credit_value a owl:DatatypeProperty ;
    rdfs:label "credit_value" ;
    rdfs:range xsd:string ;
    skos:altLabel "value" ;
    skos:definition "The name or description of the credited party (up to 4096 characters)." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:cve_metadata a owl:ObjectProperty ;
    rdfs:label "cve_metadata" ;
    rdfs:range [ owl:intersectionOf ( [ owl:unionOf ( cve:CveMetadataPublished cve:CveMetadataRejected ) ] cve:CveMetadata ) ] ;
    skos:altLabel "cveMetadata" ;
    skos:definition "Metadata about the CVE ID. A Published record uses CveMetadataPublished; a Rejected record uses CveMetadataRejected." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:cvss2_access_complexity a owl:ObjectProperty ;
    rdfs:label "cvss2_access_complexity" ;
    rdfs:range cve:Cvss2AccessComplexity ;
    skos:altLabel "accessComplexity" ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:cvss2_access_vector a owl:ObjectProperty ;
    rdfs:label "cvss2_access_vector" ;
    rdfs:range cve:Cvss2AccessVector ;
    skos:altLabel "accessVector" ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:cvss2_authentication a owl:ObjectProperty ;
    rdfs:label "cvss2_authentication" ;
    rdfs:range cve:Cvss2Authentication ;
    skos:altLabel "authentication" ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:cvss2_availability_impact a owl:ObjectProperty ;
    rdfs:label "cvss2_availability_impact" ;
    rdfs:range cve:Cvss2Cia ;
    skos:altLabel "availabilityImpact" ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:cvss2_availability_requirement a owl:ObjectProperty ;
    rdfs:label "cvss2_availability_requirement" ;
    rdfs:range cve:Cvss2CiaRequirement ;
    skos:altLabel "availabilityRequirement" ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:cvss2_base_score a owl:DatatypeProperty ;
    rdfs:label "cvss2_base_score" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                        owl:onDatatype xsd:integer ;
                        owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] [ a rdfs:Datatype ;
