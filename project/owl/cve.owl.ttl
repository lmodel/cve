                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:maxInclusive 10 ] ) ] ) ] ;
            owl:onProperty cve:cvss2_environmental_score ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:cvss2_report_confidence ],
        [ a owl:Restriction ;
            owl:allValuesFrom cve:Cvss2Cia ;
            owl:onProperty cve:cvss2_availability_impact ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:cvss2_collateral_damage_potential ],
        [ a owl:Restriction ;
