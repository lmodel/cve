        <https://w3id.org/lmodel/cve/Cvss3Severity#LOW>,
        <https://w3id.org/lmodel/cve/Cvss3Severity#MEDIUM>,
        <https://w3id.org/lmodel/cve/Cvss3Severity#NONE> .

cve:CreditType a owl:Class ;
    rdfs:label "CreditType" ;
    owl:unionOf ( <https://w3id.org/lmodel/cve/CreditType#finder> <https://w3id.org/lmodel/cve/CreditType#reporter> <https://w3id.org/lmodel/cve/CreditType#analyst> <https://w3id.org/lmodel/cve/CreditType#coordinator> <https://w3id.org/lmodel/cve/CreditType#remediation%20developer> <https://w3id.org/lmodel/cve/CreditType#remediation%20reviewer> <https://w3id.org/lmodel/cve/CreditType#remediation%20verifier> <https://w3id.org/lmodel/cve/CreditType#tool> <https://w3id.org/lmodel/cve/CreditType#sponsor> <https://w3id.org/lmodel/cve/CreditType#other> ) ;
    skos:definition "Type or role of the entity being credited." ;
    skos:inScheme <https://w3id.org/lmodel/cve> ;
    linkml:permissible_values <https://w3id.org/lmodel/cve/CreditType#analyst>,
        <https://w3id.org/lmodel/cve/CreditType#coordinator>,
        <https://w3id.org/lmodel/cve/CreditType#finder>,
        <https://w3id.org/lmodel/cve/CreditType#other>,
        <https://w3id.org/lmodel/cve/CreditType#remediation%20developer>,
        <https://w3id.org/lmodel/cve/CreditType#remediation%20reviewer>,
        <https://w3id.org/lmodel/cve/CreditType#remediation%20verifier>,
        <https://w3id.org/lmodel/cve/CreditType#reporter>,
        <https://w3id.org/lmodel/cve/CreditType#sponsor>,
        <https://w3id.org/lmodel/cve/CreditType#tool> .

cve:lang a owl:DatatypeProperty ;
    rdfs:label "lang" ;
    rdfs:range xsd:string ;
    skos:definition "BCP 47 language code indicating the language of accompanying text." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:MultiLangDescription a owl:Class ;
    rdfs:label "MultiLangDescription" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:lang ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:description_value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cve:description_value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:supporting_media ],
        [ a owl:Restriction ;
            owl:allValuesFrom cve:SupportingMedia ;
            owl:onProperty cve:supporting_media ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cve:lang ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cve:description_value ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cve:lang ] ;
    skos:definition "Text in a particular language with optional alternate markup or formatted representation (e.g., Markdown) or embedded media. Used for vulnerability descriptions, rejected reasons, configurations, workarounds, solutions, and exploits." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:ReferenceTag a owl:Class ;
    rdfs:label "ReferenceTag" ;
    owl:unionOf ( <https://w3id.org/lmodel/cve/ReferenceTag#broken-link> <https://w3id.org/lmodel/cve/ReferenceTag#customer-entitlement> <https://w3id.org/lmodel/cve/ReferenceTag#exploit> <https://w3id.org/lmodel/cve/ReferenceTag#government-resource> <https://w3id.org/lmodel/cve/ReferenceTag#issue-tracking> <https://w3id.org/lmodel/cve/ReferenceTag#mailing-list> <https://w3id.org/lmodel/cve/ReferenceTag#mitigation> <https://w3id.org/lmodel/cve/ReferenceTag#not-applicable> <https://w3id.org/lmodel/cve/ReferenceTag#patch> <https://w3id.org/lmodel/cve/ReferenceTag#permissions-required> <https://w3id.org/lmodel/cve/ReferenceTag#media-coverage> <https://w3id.org/lmodel/cve/ReferenceTag#product> <https://w3id.org/lmodel/cve/ReferenceTag#related> <https://w3id.org/lmodel/cve/ReferenceTag#release-notes> <https://w3id.org/lmodel/cve/ReferenceTag#signature> <https://w3id.org/lmodel/cve/ReferenceTag#technical-description> <https://w3id.org/lmodel/cve/ReferenceTag#third-party-advisory> <https://w3id.org/lmodel/cve/ReferenceTag#vendor-advisory> <https://w3id.org/lmodel/cve/ReferenceTag#vdb-entry> ) ;
    skos:definition "A tag describing the type or nature of the resource referenced by a URL." ;
    skos:inScheme <https://w3id.org/lmodel/cve> ;
    linkml:permissible_values <https://w3id.org/lmodel/cve/ReferenceTag#broken-link>,
        <https://w3id.org/lmodel/cve/ReferenceTag#customer-entitlement>,
        <https://w3id.org/lmodel/cve/ReferenceTag#exploit>,
        <https://w3id.org/lmodel/cve/ReferenceTag#government-resource>,
        <https://w3id.org/lmodel/cve/ReferenceTag#issue-tracking>,
        <https://w3id.org/lmodel/cve/ReferenceTag#mailing-list>,
        <https://w3id.org/lmodel/cve/ReferenceTag#media-coverage>,
        <https://w3id.org/lmodel/cve/ReferenceTag#mitigation>,
        <https://w3id.org/lmodel/cve/ReferenceTag#not-applicable>,
        <https://w3id.org/lmodel/cve/ReferenceTag#patch>,
        <https://w3id.org/lmodel/cve/ReferenceTag#permissions-required>,
        <https://w3id.org/lmodel/cve/ReferenceTag#product>,
        <https://w3id.org/lmodel/cve/ReferenceTag#related>,
        <https://w3id.org/lmodel/cve/ReferenceTag#release-notes>,
        <https://w3id.org/lmodel/cve/ReferenceTag#signature>,
        <https://w3id.org/lmodel/cve/ReferenceTag#technical-description>,
        <https://w3id.org/lmodel/cve/ReferenceTag#third-party-advisory>,
        <https://w3id.org/lmodel/cve/ReferenceTag#vdb-entry>,
        <https://w3id.org/lmodel/cve/ReferenceTag#vendor-advisory> .

xsd:string a rdfs:Datatype ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "([c][pP][eE]:/[AHOaho]?(:[A-Za-z0-9._\\-~%]*){0,6})|(cpe:2\\.3:[aho*\\-](:(((\\?*|\\*?)([a-zA-Z0-9\\-._]|(\\\\[\\\\*?!\"#$%&'()+,/:;<=>@\\[\\]\\^`{|}~]))+(\\?*|\\*?))|[*\\-])){5}(:(([a-zA-Z]{2,3}(-([a-zA-Z]{2}|[0-9]{3}))?)|[*\\-]))(:(((\\?*|\\*?)([a-zA-Z0-9\\-._]|(\\\\[\\\\*?!\"#$%&'()+,/:;<=>@\\[\\]\\^`{|}~]))+(\\?*|\\*?))|[*\\-])){4})" ] ) ],
        [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^CVE-[0-9]{4}-[0-9]+$" ] ) ],
        [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "(cpe:2\\.3:[aho*\\-](:(((\\?*|\\*?)([a-zA-Z0-9\\-._]|(\\\\[\\\\*?!\"#$%&'()+,/:;<=>@\\[\\]\\^`{|}~]))+(\\?*|\\*?))|[*\\-])){5}(:(([a-zA-Z]{2,3}(-([a-zA-Z]{2}|[0-9]{3}))?)|[*\\-]))(:(((\\?*|\\*?)([a-zA-Z0-9\\-._]|(\\\\[\\\\*?!\"#$%&'()+,/:;<=>@\\[\\]\\^`{|}~]))+(\\?*|\\*?))|[*\\-])){4})" ] ) ],
        [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^[A-Za-z]{2,4}([_-][A-Za-z]{4})?([_-]([A-Za-z]{2}|[0-9]{3}))?$" ] ) ],
        [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-4[0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$" ] ) ],
        [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^(((2000|2400|2800|(19|2[0-9](0[48]|[2468][048]|[13579][26])))-02-29)|(((19|2[0-9])[0-9]{2})-02-(0[1-9]|1[0-9]|2[0-8]))|(((19|2[0-9])[0-9]{2})-(0[13578]|10|12)-(0[1-9]|[12][0-9]|3[01]))|(((19|2[0-9])[0-9]{2})-(0[469]|11)-(0[1-9]|[12][0-9]|30)))T(2[0-3]|[01][0-9]):([0-5][0-9]):([0-5][0-9])(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})?$" ] ) ] .

[] rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cve:version_type ;
            owl:someValuesFrom xsd:string ] ;
    owl:intersectionOf ( [ a owl:Restriction ;
                owl:onProperty cve:less_than_or_equal ;
                owl:someValuesFrom xsd:string ] cve:VersionEntry ) .

[] rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty cve:version_type ;
            owl:someValuesFrom xsd:string ] ;
    owl:intersectionOf ( [ a owl:Restriction ;
                owl:onProperty cve:less_than ;
                owl:someValuesFrom xsd:string ] cve:VersionEntry ) .


