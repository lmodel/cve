	skos:definition "What kind of fix is available." ;
	skos:inScheme cve:cve_cvss ;
	cve:upstream_path "imports/cvss/cvss-v2.0.json#/properties/remediationLevel imports/cvss/cvss-v3.0.json#/properties/remediationLevel imports/cvss/cvss-v3.1.json#/properties/remediationLevel" .
cve:replacedBy a owl:DatatypeProperty ;
