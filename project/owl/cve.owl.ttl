cve:CvssV20 a owl:Class ;
    rdfs:label "CvssV2_0" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:cvss2_temporal_score ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^((AV:[NAL]|AC:[LMH]|Au:[MSN]|[CIA]:[NPC]|E:(U|POC|F|H|ND)|RL:(OF|TF|W|U|ND)|RC:(UC|UR|C|ND)|CDP:(N|L|LM|MH|H|ND)|TD:(N|L|M|H|ND)|[CIA]R:(L|M|H|ND))/)*(AV:[NAL]|AC:[LMH]|Au:[MSN]|[CIA]:[NPC]|E:(U|POC|F|H|ND)|RL:(OF|TF|W|U|ND)|RC:(UC|UR|C|ND)|CDP:(N|L|LM|MH|H|ND)|TD:(N|L|M|H|ND)|[CIA]R:(L|M|H|ND))$" ] ) ] ) ] ;
            owl:onProperty cve:cvss2_vector_string ],
        [ a owl:Restriction ;
            owl:allValuesFrom cve:Cvss2AccessVector ;
            owl:onProperty cve:cvss2_access_vector ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:cvss2_exploitability ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:cvss2_target_distribution ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:cvss2_confidentiality_impact ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:float [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 0 ] ) ] [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:maxInclusive 10 ] ) ] ) ] ;
            owl:onProperty cve:cvss2_temporal_score ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:cvss2_authentication ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:cvss2_base_score ],
        [ a owl:Restriction ;
            owl:allValuesFrom cve:Cvss2CiaRequirement ;
            owl:onProperty cve:cvss2_availability_requirement ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
