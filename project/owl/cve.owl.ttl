	cve:upstream_path "CVE_Record_Format.json#/definitions/product/properties/packageName" .
cve:packageURL a owl:DatatypeProperty ;
	rdfs:label "packageURL" ;
	skos:closeMatch <https://spdx.org/rdf/3.0.1/terms/Software/packageUrl> ;
	skos:definition "A Package URL for the package, with no version in it." ;
	skos:inScheme cve:cve_record ;
	cve:upstream_path "CVE_Record_Format.json#/definitions/product/properties/packageURL" .
cve:platforms a owl:DatatypeProperty ;
