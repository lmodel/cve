<https://spdx.org/rdf/3.0.1/terms/Security/CvssSeverityType/critical> a owl:Class ;
	rdfs:label "CRITICAL" ;
	rdfs:subClassOf cve:CvssSeverity ;
	skos:definition "The highest rating." .
<https://spdx.org/rdf/3.0.1/terms/Security/CvssSeverityType/high> a owl:Class ;
	rdfs:label "HIGH" ;
	rdfs:subClassOf cve:CvssSeverity ;
	skos:definition "The rating below critical." .
<https://spdx.org/rdf/3.0.1/terms/Security/CvssSeverityType/low> a owl:Class ;
	rdfs:label "LOW" ;
	rdfs:subClassOf cve:CvssSeverity ;
	skos:definition "The lowest rating above none." .
<https://spdx.org/rdf/3.0.1/terms/Security/CvssSeverityType/medium> a owl:Class ;
	rdfs:label "MEDIUM" ;
	rdfs:subClassOf cve:CvssSeverity ;
	skos:definition "The middle rating." .
<https://spdx.org/rdf/3.0.1/terms/Security/CvssSeverityType/none> a owl:Class ;
	rdfs:label "NONE" ;
	rdfs:subClassOf cve:CvssSeverity ;
	skos:definition "No severity at all, for a score of 0." .
<https://w3id.org/lmodel/cve.owl.ttl> dcterms:license "Apache-2.0" ;
	dcterms:source <https://github.com/CVEProject/cve-schema/blob/v5.2.0/schema/CVE_Record_Format.json> ;
	dcterms:title "Common Vulnerabilities and Exposures (CVE) Record Format" ;
	pav:version "5.2.0" ;
	a owl:Ontology ;
	rdfs:label "cve" ;
	rdfs:seeAlso <https://lmodel.github.io/cve> , <https://www.cve.org/> ;
	skos:definition "A LinkML model of the CVE Record Format, in which the CVE Program publishes each vulnerability record, with its CVSS scores. It keeps the format's own keys and values, so a real record validates unchanged." ;
	skos:note "The version is the edition of the format that the schema renders. upstream/ holds that edition's files unchanged, tests/test_coverage.py holds the schema to them, and scripts/check_upstream_release.py reports when the edition moves." ;
	cve:upstream_commit "5533f6038cc0434e544e69240c704906d591de46" ;
	cve:upstream_licence "CC0-1.0" ;
	cve:upstream_published "2025-10-29" .
cve:Automatable a owl:ObjectProperty ;
	rdfs:label "Automatable" ;
	skos:definition "Whether an attacker could automate every step of an attack across many targets." ;
	skos:inScheme cve:cve_cvss ;
	cve:upstream_path "imports/cvss/cvss-v4.0.json#/properties/Automatable" .
cve:CveAdpContainer a owl:Class ;
	rdfs:label "CveAdpContainer" ;
	rdfs:subClassOf _:c14n125 , _:c14n14 , _:c14n168 , _:c14n185 , _:c14n204 , _:c14n232 , _:c14n243 , _:c14n256 , _:c14n263 , _:c14n275 , _:c14n281 , _:c14n288 , _:c14n310 , _:c14n341 , _:c14n377 , _:c14n383 , _:c14n404 , _:c14n405 , _:c14n423 , _:c14n424 , _:c14n432 , _:c14n435 , _:c14n475 , _:c14n487 , _:c14n501 , _:c14n517 , _:c14n559 , _:c14n589 , _:c14n604 , _:c14n620 , _:c14n643 , _:c14n713 , _:c14n728 , _:c14n744 , _:c14n775 , _:c14n792 , _:c14n8 , _:c14n800 , _:c14n827 , _:c14n833 , _:c14n920 , _:c14n923 , _:c14n968 , _:c14n975 ;
	skos:definition "What an Authorized Data Publisher adds to a record beside the assigning authority's account." ;
	skos:inScheme cve:cve_record ;
	skos:note "It accepts keys of the publisher's own, whose names must begin x_ and hold no full stop, and it must hold something beside providerMetadata. tests/cve_rules.py checks both, since LinkML 1.12.1 can state neither." ;
	cve:upstream_path "CVE_Record_Format.json#/definitions/adpContainer" .
cve:CveAdpTag\#disputed a owl:Class ;
	rdfs:label "disputed" ;
	rdfs:subClassOf cve:CveAdpTag ;
	skos:definition "Someone disagrees that this is a vulnerability at all." .
cve:CveAdpTag a owl:Class ;
	rdfs:label "CveAdpTag" ;
	skos:definition "A label an Authorized Data Publisher can put on a record." ;
	skos:inScheme cve:cve_record ;
	linkml:permissible_values cve:CveAdpTag\#disputed ;
	cve:upstream_path "tags/adp-tags.json#/" .
cve:CveCnaContainer a owl:Class ;
	rdfs:label "CveCnaContainer" ;
	rdfs:subClassOf _:c14n267 , _:c14n348 , _:c14n736 , _:c14n953 ;
