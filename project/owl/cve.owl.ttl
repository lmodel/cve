	rdfs:range cve:CveCpeOperator ;
	skos:definition "How the parts combine, all of them or any of them." ;
	skos:inScheme cve:cve_record ;
	cve:upstream_path "CVE_Record_Format.json#/definitions/cpeApplicabilityElement/properties/operator CVE_Record_Format.json#/definitions/cpe_node/properties/operator" .
cve:orgId a owl:DatatypeProperty ;
	rdfs:label "orgId" ;
	skos:definition "The UUID of the organisation that provided the container." ;
