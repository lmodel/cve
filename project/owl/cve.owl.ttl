cve:CveCreditType\#sponsor a owl:Class ;
	rdfs:label "sponsor" ;
	rdfs:subClassOf cve:CveCreditType ;
	skos:definition "Supported the work of finding or fixing it." .
cve:CveCreditType\#tool a owl:Class ;
	rdfs:label "tool" ;
	rdfs:subClassOf cve:CveCreditType ;
	skos:definition "A tool used to find or identify it." .
cve:CveCreditType a owl:Class ;
	rdfs:label "CveCreditType" ;
	owl:unionOf _:c14n208 ;
	skos:definition "The part a credited person or organisation played." ;
	skos:inScheme cve:cve_record ;
	linkml:permissible_values cve:CveCreditType\#analyst , cve:CveCreditType\#coordinator , cve:CveCreditType\#finder , cve:CveCreditType\#other , cve:CveCreditType\#remediation\%20developer , cve:CveCreditType\#remediation\%20reviewer , cve:CveCreditType\#remediation\%20verifier , cve:CveCreditType\#reporter , cve:CveCreditType\#sponsor , cve:CveCreditType\#tool ;
	cve:upstream_path "CVE_Record_Format.json#/definitions/credits/items/properties/type" .
