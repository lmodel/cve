	cve:upstream_path "CVE_Record_Format.json#/definitions/problemTypes" .
cve:product a owl:DatatypeProperty ;
	rdfs:label "product" ;
	skos:definition "The name of the affected product." ;
	skos:inScheme cve:cve_record ;
	cve:upstream_path "CVE_Record_Format.json#/definitions/product/properties/product" .
cve:programFiles a owl:DatatypeProperty ;
