	cve:upstream_path "CVE_Record_Format.json#/definitions/product/properties/modules" .
cve:name a owl:DatatypeProperty ;
	rdfs:label "name" ;
	skos:definition "A name, of a reference or of a routine." ;
	skos:inScheme cve:cve_record ;
	cve:upstream_path "CVE_Record_Format.json#/definitions/reference/properties/name CVE_Record_Format.json#/definitions/product/properties/programRoutines/items/properties/name" .
cve:negate a owl:DatatypeProperty ;
	rdfs:label "negate" ;
	rdfs:range xsd:boolean ;
	skos:definition "Whether the combined result is reversed." ;
	skos:inScheme cve:cve_record ;
	cve:upstream_path "CVE_Record_Format.json#/definitions/cpeApplicabilityElement/properties/negate CVE_Record_Format.json#/definitions/cpe_node/properties/negate" .
cve:nodes a owl:ObjectProperty ;
	rdfs:label "nodes" ;
	skos:definition "The groups of matches that the statement combines." ;
	skos:inScheme cve:cve_record ;
	cve:upstream_path "CVE_Record_Format.json#/definitions/cpeApplicabilityElement/properties/nodes" .
cve:operator a owl:ObjectProperty ;
