cve:dataType a owl:ObjectProperty ;
	rdfs:label "dataType" ;
	skos:definition "The kind of document this is, which is always a CVE record." ;
	skos:inScheme cve:cve_record ;
	cve:upstream_path "CVE_Record_Format.json#/definitions/dataType" .
cve:dataVersion a owl:DatatypeProperty ;
	rdfs:label "dataVersion" ;
	skos:definition "The version of the record format that this record follows." ;
	skos:inScheme cve:cve_record ;
	skos:note "The upstream gives 5.2.0 as a default, which cannot apply to a required key." ;
	cve:upstream_path "CVE_Record_Format.json#/definitions/dataVersion" .
cve:dateAssigned a owl:DatatypeProperty ;
	rdfs:label "dateAssigned" ;
	skos:definition "When the authority tied the CVE identifier to a vulnerability." ;
	skos:inScheme cve:cve_record ;
	cve:upstream_path "CVE_Record_Format.json#/definitions/cnaPublishedContainer/properties/dateAssigned" .
cve:datePublic a owl:DatatypeProperty ;
	rdfs:label "datePublic" ;
	rdfs:range xsd:dateTime ;
	skos:definition "When the vulnerability was made public, if known." ;
	skos:inScheme cve:cve_record ;
	cve:upstream_path "CVE_Record_Format.json#/definitions/cnaPublishedContainer/properties/datePublic CVE_Record_Format.json#/definitions/adpContainer/properties/datePublic" .
cve:datePublished a owl:DatatypeProperty ;
	rdfs:label "datePublished" ;
	skos:closeMatch dcterms:issued , <http://schema.org/datePublished> , <https://spdx.org/rdf/3.0.1/terms/Security/publishedTime> ;
	skos:definition "When the record first appeared in the CVE List." ;
	skos:inScheme cve:cve_record ;
	cve:upstream_path "CVE_Record_Format.json#/definitions/cveMetadataPublished/properties/datePublished" .
cve:dateRejected a owl:DatatypeProperty ;
	rdfs:label "dateRejected" ;
	skos:closeMatch <https://spdx.org/rdf/3.0.1/terms/Security/withdrawnTime> ;
	skos:definition "When the CVE identifier was rejected." ;
	skos:inScheme cve:cve_record ;
	cve:upstream_path "CVE_Record_Format.json#/definitions/cveMetadataRejected/properties/dateRejected" .
cve:dateReserved a owl:DatatypeProperty ;
	rdfs:label "dateReserved" ;
	skos:definition "When the CVE identifier was reserved." ;
	skos:inScheme cve:cve_record ;
	skos:note "This says nothing about when the flaw was found, reported or disclosed." ;
	cve:upstream_path "CVE_Record_Format.json#/definitions/cveMetadataPublished/properties/dateReserved" .
cve:dateUpdated a owl:DatatypeProperty ;
	rdfs:label "dateUpdated" ;
	rdfs:range xsd:dateTime ;
	skos:closeMatch dcterms:modified , <http://schema.org/dateModified> , <https://spdx.org/rdf/3.0.1/terms/Security/modifiedTime> ;
	skos:definition "When the record or container was last updated." ;
	skos:inScheme cve:cve_record ;
	cve:upstream_path "CVE_Record_Format.json#/definitions/cveMetadataPublished/properties/dateUpdated CVE_Record_Format.json#/definitions/cveMetadataRejected/properties/dateUpdated CVE_Record_Format.json#/definitions/providerMetadata/properties/dateUpdated" .
cve:defaultStatus a owl:ObjectProperty ;
	rdfs:label "defaultStatus" ;
	skos:definition "The status of every version the versions list does not cover." ;
	skos:inScheme cve:cve_record ;
	skos:note "Left out, it reads as unknown, as the upstream's text says." ;
	cve:upstream_path "CVE_Record_Format.json#/definitions/product/properties/defaultStatus" .
cve:description a owl:DatatypeProperty ;
	rdfs:label "description" ;
	skos:definition "The text of a problem type, or the title of a weakness." ;
	skos:inScheme cve:cve_record ;
	cve:upstream_path "CVE_Record_Format.json#/definitions/problemTypes/items/properties/descriptions/items/properties/description" .
cve:descriptions a owl:ObjectProperty ;
	rdfs:label "descriptions" ;
	rdfs:range cve:CveDescription ;
	skos:closeMatch dcterms:description ;
	skos:definition "The same text in one or more languages." ;
	skos:inScheme cve:cve_record ;
	skos:note "A list of this kind must hold at least one member in English, stated where a class uses it, since a problem type's own list has no such rule." ;
	cve:upstream_path "CVE_Record_Format.json#/definitions/descriptions CVE_Record_Format.json#/definitions/englishLanguageDescription" .
cve:environmentalScore a owl:DatatypeProperty ;
	rdfs:label "environmentalScore" ;
	rdfs:range _:c14n126 ;
	skos:definition "The score adjusted for the scorer's own environment." ;
	skos:inScheme cve:cve_cvss ;
	cve:upstream_path "imports/cvss/cvss-v2.0.json#/properties/environmentalScore imports/cvss/cvss-v3.0.json#/properties/environmentalScore imports/cvss/cvss-v3.1.json#/properties/environmentalScore" .
cve:environmentalSeverity a owl:ObjectProperty ;
	rdfs:label "environmentalSeverity" ;
	rdfs:range cve:CvssSeverity ;
	skos:definition "The rating in words for the environmental score." ;
	skos:inScheme cve:cve_cvss ;
	cve:upstream_path "imports/cvss/cvss-v3.0.json#/properties/environmentalSeverity imports/cvss/cvss-v3.1.json#/properties/environmentalSeverity" .
cve:exploitCodeMaturity a owl:ObjectProperty ;
	rdfs:label "exploitCodeMaturity" ;
	rdfs:range cve:CvssExploitCodeMaturity ;
	skos:definition "How far working attack code has come." ;
	skos:inScheme cve:cve_cvss ;
	cve:upstream_path "imports/cvss/cvss-v3.0.json#/properties/exploitCodeMaturity imports/cvss/cvss-v3.1.json#/properties/exploitCodeMaturity" .
cve:exploitMaturity a owl:ObjectProperty ;
	rdfs:label "exploitMaturity" ;
	skos:definition "How much is known about attacks on this flaw, in CVSS 4.0's terms." ;
	skos:inScheme cve:cve_cvss ;
	cve:upstream_path "imports/cvss/cvss-v4.0.json#/properties/exploitMaturity" .
cve:exploitability a owl:ObjectProperty ;
	rdfs:label "exploitability" ;
	skos:definition "How far working attack code has come, in CVSS 2.0's terms." ;
	skos:inScheme cve:cve_cvss ;
	cve:upstream_path "imports/cvss/cvss-v2.0.json#/properties/exploitability" .
cve:exploits a owl:ObjectProperty ;
	rdfs:label "exploits" ;
	rdfs:range cve:CveDescription ;
	skos:definition "What is known about attacks on the vulnerability." ;
	skos:inScheme cve:cve_record ;
	cve:upstream_path "CVE_Record_Format.json#/definitions/exploits" .
cve:format a owl:DatatypeProperty ;
	rdfs:label "format" ;
	skos:definition "The name of the scoring format." ;
	skos:inScheme cve:cve_record ;
	cve:upstream_path "CVE_Record_Format.json#/definitions/metrics/items/properties/format" .
cve:impacts a owl:ObjectProperty ;
	rdfs:label "impacts" ;
	rdfs:range cve:CveImpact ;
	skos:definition "The consequences of the vulnerability, in words." ;
	skos:inScheme cve:cve_record ;
	cve:upstream_path "CVE_Record_Format.json#/definitions/impacts" .
