cve:less_than a owl:DatatypeProperty ;
    rdfs:label "less_than" ;
    rdfs:range xsd:string ;
    skos:altLabel "lessThan" ;
    skos:definition "The non-inclusive upper limit of the range. This is the least version NOT in the range. Supports wildcard '*' suffix." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:less_than_or_equal a owl:DatatypeProperty ;
    rdfs:label "less_than_or_equal" ;
    rdfs:range xsd:string ;
    skos:altLabel "lessThanOrEqual" ;
    skos:definition "The inclusive upper limit of the range. This is the greatest version contained in the range. Only one of lessThan and lessThanOrEqual should be specified." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:version_type a owl:DatatypeProperty ;
    rdfs:label "version_type" ;
    rdfs:range xsd:string ;
    skos:altLabel "versionType" ;
    skos:definition "The version numbering system used for specifying the range (e.g., semver, git, maven, rpm, python, custom). Defines the semantics of comparison." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

