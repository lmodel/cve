            owl:onProperty cve:cvss2_integrity_impact ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cve:cvss2_vector_string ] ;
    skos:definition "CVSS version 2.0 scoring object. Requires version ('2.0'), vectorString, and baseScore." ;
    skos:inScheme <https://w3id.org/lmodel/cve> ;
    skos:narrowMatch nvd:CVSSMetric .

