	skos:definition "The confidentiality impact as the scorer's own environment changes it." ;
	skos:inScheme cve:cve_cvss ;
	cve:upstream_path "imports/cvss/cvss-v3.0.json#/properties/modifiedConfidentialityImpact imports/cvss/cvss-v3.1.json#/properties/modifiedConfidentialityImpact" .
cve:modifiedIntegrityImpact a owl:DatatypeProperty ;
	rdfs:label "modifiedIntegrityImpact" ;
	skos:definition "The integrity impact as the scorer's own environment changes it." ;
	skos:inScheme cve:cve_cvss ;
	cve:upstream_path "imports/cvss/cvss-v3.0.json#/properties/modifiedIntegrityImpact imports/cvss/cvss-v3.1.json#/properties/modifiedIntegrityImpact" .
cve:modifiedPrivilegesRequired a owl:DatatypeProperty ;
