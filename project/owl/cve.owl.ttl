	skos:inScheme cve:cve_cvss ;
	cve:upstream_path "imports/cvss/cvss-v3.0.json#/properties/modifiedAttackComplexity imports/cvss/cvss-v3.1.json#/properties/modifiedAttackComplexity imports/cvss/cvss-v4.0.json#/properties/modifiedAttackComplexity" .
cve:modifiedAttackRequirements a owl:ObjectProperty ;
