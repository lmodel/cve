@prefix WIKIDATA: <https://www.wikidata.org/wiki/> .
@prefix cve: <https://w3id.org/lmodel/cve/> .
@prefix cwe: <https://w3id.org/lmodel/cwe/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix kev_catalog: <https://w3id.org/lmodel/kev-catalog/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix nvd: <https://w3id.org/lmodel/nist-nvd/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pav: <http://purl.org/pav/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema1: <http://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

xsd:date a rdfs:Datatype ;
    owl:equivalentClass [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^((2000|2400|2800|(19|2[0-9](0[48]|[2468][048]|[13579][26])))-02-29)|(((19|2[0-9])[0-9]{2})-02-(0[1-9]|1[0-9]|2[0-8]))|(((19|2[0-9])[0-9]{2})-(0[13578]|10|12)-(0[1-9]|[12][0-9]|3[01]))|(((19|2[0-9])[0-9]{2})-(0[469]|11)-(0[1-9]|[12][0-9]|30))$" ] ) ],
        [ a rdfs:Datatype ;
            owl:onDatatype xsd:string ;
            owl:withRestrictions ( [ xsd:pattern "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" ] ) ] .

<https://w3id.org/lmodel/cve.owl.ttl> a owl:Ontology ;
    rdfs:label "cve" ;
    dct:license "https://creativecommons.org/publicdomain/zero/1.0/" ;
    dct:source <https://github.com/CVEProject/cve-schema/blob/main/schema/CVE_Record_Format.json> ;
    dct:title "cve" ;
    pav:version "5.2.0" ;
    rdfs:seeAlso <https://cveproject.github.io/cve-schema/schema/CVE_Record_Format.json>,
        <https://lmodel.github.io/cve>,
        <https://www.cve.org/> ;
    skos:definition """Common Vulnerabilities and Exposures (CVE™) Program - LinkML Schema.
Provides complete semantic coverage of the CVE Record Format v5 JSON Schema, including published and rejected records, all container types, CVSS 4.0/3.1/3.0/2.0 scoring, CPE applicability, taxonomy mappings, credits, and timeline entries.""" .

cve:CVERecord a owl:Class ;
    rdfs:label "CVERecord" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:data_version ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cve:cve_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cve:cve_metadata ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cve:cve_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cve:containers ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:data_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:intersectionOf ( [ owl:unionOf ( cve:CveMetadataPublished cve:CveMetadataRejected ) ] cve:CveMetadata ) ] ;
            owl:onProperty cve:cve_metadata ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:cve_metadata ],
        [ a owl:Restriction ;
            owl:allValuesFrom cve:DataType ;
            owl:onProperty cve:data_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom cve:Containers ;
            owl:onProperty cve:containers ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:containers ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:data_version ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:data_type ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:cve_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^5\\.(0|[1-9][0-9]*)(\\.(0|[1-9][0-9]*))?$" ] ) ] ) ] ;
            owl:onProperty cve:data_version ],
        <https://w3id.org/lmodel/vulnerability-core/Vulnerability> ;
    skos:closeMatch nvd:NVDEntry ;
    skos:definition "Official CVE Record corresponding to a CVE ID. Represents either a Published or Rejected record in the CVE™ Program. The dataType field is always CVE_RECORD. Use cveMetadata.state to distinguish Published from Rejected records." ;
    skos:exactMatch WIKIDATA:Q631425 ;
    skos:inScheme <https://w3id.org/lmodel/cve> ;
    skos:relatedMatch kev_catalog:KevEntry .

<https://w3id.org/lmodel/vulnerability-core/Configuration> a owl:Class ;
    rdfs:label "Configuration" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/cpe_uri> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/operator> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/cpe_uri> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/operator> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/cpe_uri> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/operator> ] ;
    skos:closeMatch nvd:CPEConfiguration ;
    skos:definition "Logical grouping of CPE match expressions." ;
    skos:inScheme <https://w3id.org/lmodel/vulnerability-core> .

<https://w3id.org/lmodel/cve/ADPTag#disputed> a owl:Class ;
    rdfs:label "disputed" ;
    rdfs:subClassOf cve:ADPTag ;
    skos:definition "One party disagrees with another party's assertion that a particular issue in software is a vulnerability." .

<https://w3id.org/lmodel/cve/DataType#CVE_RECORD> a owl:Class ;
    rdfs:label "CVE_RECORD" ;
    rdfs:subClassOf cve:DataType ;
    skos:definition "The instance is a CVE Record." .

<https://w3id.org/lmodel/vulnerability-core/Vulnerability> a owl:Class ;
    rdfs:label "Vulnerability" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/lmodel/vulnerability-core/Weakness> ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/weaknesses> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/cve_id> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/status> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/published_date> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/description> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/lmodel/vulnerability-core/Reference> ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/references> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/title> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/weaknesses> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/description> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/impact> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/published_date> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/last_modified_date> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/products> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/lmodel/vulnerability-core/Impact> ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/impact> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/description> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/last_modified_date> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/cve_id> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:dateTime ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/published_date> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/cve_id> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/references> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/title> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/impact> ],
        [ a owl:Restriction ;
            owl:allValuesFrom <https://w3id.org/lmodel/vulnerability-core/Product> ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/products> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/title> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/last_modified_date> ],
        [ a owl:Restriction ;
            owl:allValuesFrom cve:VulnerabilityStatus ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/status> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/status> ] ;
    skos:broadMatch kev_catalog:KevEntry,
        nvd:NVDEntry ;
    skos:definition "Abstract base representation of a security vulnerability. Extended by source-specific schemas (KEV, CVE, NVD)." ;
    skos:exactMatch WIKIDATA:Q631425 ;
    skos:inScheme <https://w3id.org/lmodel/vulnerability-core> ;
    skos:relatedMatch schema1:SoftwareApplication,
        cwe:Weakness .

cve:AdpContainer a owl:Class ;
    rdfs:label "AdpContainer" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:cpe_applicability ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/title> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:timeline ],
        [ a owl:Restriction ;
            owl:allValuesFrom cve:MetricEntry ;
            owl:onProperty cve:metrics ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( [ a rdfs:Datatype ;
                                owl:unionOf ( cve:ADPTag [ a rdfs:Datatype ;
                                            owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                                        owl:onDatatype xsd:string ;
                                                        owl:withRestrictions ( [ xsd:pattern "^x_.*$" ] ) ] ) ] ) ] xsd:string ) ] ;
            owl:onProperty cve:adp_tags ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:date_public ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:cna_source ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:exploits ],
        [ a owl:Restriction ;
            owl:allValuesFrom cve:TaxonomyMapping ;
            owl:onProperty cve:taxonomy_mappings ],
        [ a owl:Restriction ;
            owl:allValuesFrom cve:TimelineEntry ;
            owl:onProperty cve:timeline ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:adp_tags ],
        [ a owl:Restriction ;
            owl:allValuesFrom cve:ProblemType ;
            owl:onProperty cve:problem_types ],
        [ a owl:Restriction ;
            owl:allValuesFrom cve:CreditEntry ;
            owl:onProperty cve:credits ],
        [ a owl:Restriction ;
            owl:allValuesFrom cve:MultiLangDescription ;
            owl:onProperty cve:exploits ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:problem_types ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:workarounds ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:credits ],
        [ a owl:Restriction ;
            owl:allValuesFrom cve:MultiLangDescription ;
            owl:onProperty cve:solutions ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cve:date_public ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:cna_source ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/title> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:cve_references ],
        [ a owl:Restriction ;
            owl:allValuesFrom cve:MultiLangDescription ;
            owl:onProperty cve:configurations_text ],
        [ a owl:Restriction ;
            owl:allValuesFrom cve:CveReference ;
            owl:onProperty cve:cve_references ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:descriptions ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:solutions ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:impacts ],
        [ a owl:Restriction ;
            owl:allValuesFrom cve:MultiLangDescription ;
            owl:onProperty cve:descriptions ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:taxonomy_mappings ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:affected ],
        [ a owl:Restriction ;
            owl:allValuesFrom cve:CpeApplicabilityElement ;
            owl:onProperty cve:cpe_applicability ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:metrics ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cve:provider_metadata ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/title> ],
        [ a owl:Restriction ;
            owl:allValuesFrom cve:MultiLangDescription ;
            owl:onProperty cve:workarounds ],
        [ a owl:Restriction ;
            owl:allValuesFrom cve:ProviderMetadata ;
            owl:onProperty cve:provider_metadata ],
        [ a owl:Restriction ;
            owl:allValuesFrom cve:ImpactEntry ;
            owl:onProperty cve:impacts ],
        [ a owl:Restriction ;
            owl:allValuesFrom cve:AffectedProduct ;
            owl:onProperty cve:affected ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:provider_metadata ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:date_public ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:configurations_text ],
        [ a owl:Restriction ;
            owl:allValuesFrom cve:SourceInformation ;
            owl:onProperty cve:cna_source ] ;
    skos:definition "An object containing vulnerability information provided by an Authorized Data Publisher (ADP). Multiple ADPs can provide containers for a single CVE ID." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:Any a owl:Class ;
    rdfs:label "Any" ;
    skos:definition "A linkml placeholder class accepting any JSON-compatible value (string, number, boolean, object, or array). Use for slots that hold arbitrary or schema-less data." ;
    skos:exactMatch linkml:Any ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

<https://w3id.org/lmodel/cve/CNATag#disputed> a owl:Class ;
    rdfs:label "disputed" ;
    rdfs:subClassOf cve:CNATag ;
    skos:definition "One party disagrees with another party's assertion that a particular issue in software is a vulnerability." .

<https://w3id.org/lmodel/cve/CNATag#exclusively-hosted-service> a owl:Class ;
    rdfs:label "exclusively-hosted-service" ;
    rdfs:subClassOf cve:CNATag ;
    skos:definition "All known software and/or hardware affected by this CVE Record is known to exist only in the affected hosted service." .

<https://w3id.org/lmodel/cve/CNATag#unsupported-when-assigned> a owl:Class ;
    rdfs:label "unsupported-when-assigned" ;
    rdfs:subClassOf cve:CNATag ;
    skos:definition "When a request for a CVE assignment was received, the product was already end-of-life (EOL) or a product or specific version was deemed not to be supported by the vendor." .

cve:CnaPublishedContainer a owl:Class ;
    rdfs:label "CnaPublishedContainer" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cve:MultiLangDescription ;
            owl:onProperty cve:exploits ],
        [ a owl:Restriction ;
            owl:allValuesFrom cve:TaxonomyMapping ;
            owl:onProperty cve:taxonomy_mappings ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cve:affected ],
        [ a owl:Restriction ;
            owl:allValuesFrom cve:CreditEntry ;
            owl:onProperty cve:credits ],
        [ a owl:Restriction ;
            owl:allValuesFrom cve:MultiLangDescription ;
            owl:onProperty cve:descriptions ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:configurations_text ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:impacts ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:date_public ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cve:descriptions ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:cna_source ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:cna_tags ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/title> ],
        [ a owl:Restriction ;
            owl:allValuesFrom cve:ProviderMetadata ;
            owl:onProperty cve:provider_metadata ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/title> ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cve:provider_metadata ],
        [ a owl:Restriction ;
            owl:allValuesFrom cve:CpeApplicabilityElement ;
            owl:onProperty cve:cpe_applicability ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cve:date_assigned ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:metrics ],
        [ a owl:Restriction ;
            owl:allValuesFrom cve:TimelineEntry ;
            owl:onProperty cve:timeline ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cve:date_public ],
        [ a owl:Restriction ;
            owl:allValuesFrom cve:CveReference ;
            owl:onProperty cve:cve_references ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( [ a rdfs:Datatype ;
                                owl:unionOf ( cve:CNATag [ a rdfs:Datatype ;
                                            owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                                        owl:onDatatype xsd:string ;
                                                        owl:withRestrictions ( [ xsd:pattern "^x_.*$" ] ) ] ) ] ) ] xsd:string ) ] ;
            owl:onProperty cve:cna_tags ],
        [ a owl:Restriction ;
            owl:allValuesFrom cve:SourceInformation ;
            owl:onProperty cve:cna_source ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:problem_types ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cve:cve_references ],
        [ a owl:Restriction ;
            owl:allValuesFrom cve:MultiLangDescription ;
            owl:onProperty cve:solutions ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:date_assigned ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:credits ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:solutions ],
        [ a owl:Restriction ;
            owl:allValuesFrom cve:ImpactEntry ;
            owl:onProperty cve:impacts ],
        [ a owl:Restriction ;
            owl:allValuesFrom cve:MultiLangDescription ;
            owl:onProperty cve:configurations_text ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:workarounds ],
        [ a owl:Restriction ;
            owl:allValuesFrom cve:AffectedProduct ;
            owl:onProperty cve:affected ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:provider_metadata ],
        [ a owl:Restriction ;
            owl:allValuesFrom cve:MultiLangDescription ;
            owl:onProperty cve:workarounds ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:exploits ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/title> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:cpe_applicability ],
        [ a owl:Restriction ;
            owl:allValuesFrom cve:ProblemType ;
            owl:onProperty cve:problem_types ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:taxonomy_mappings ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:cna_source ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:timeline ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:date_public ],
        [ a owl:Restriction ;
            owl:allValuesFrom cve:MetricEntry ;
            owl:onProperty cve:metrics ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:date_assigned ],
        cve:CnaContainer ;
    skos:definition "An object containing vulnerability information provided by a CVE Numbering Authority (CNA) for a published CVE ID. There can only be one CNA container per CVE record since there can only be one assigning CNA." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:CnaRejectedContainer a owl:Class ;
    rdfs:label "CnaRejectedContainer" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cve:rejected_reasons ],
        [ a owl:Restriction ;
            owl:allValuesFrom cve:MultiLangDescription ;
            owl:onProperty cve:rejected_reasons ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:replaced_by ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:provider_metadata ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cve:provider_metadata ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cve:replaced_by ],
        [ a owl:Restriction ;
            owl:allValuesFrom cve:ProviderMetadata ;
            owl:onProperty cve:provider_metadata ],
        cve:CnaContainer ;
    skos:definition "An object containing vulnerability information provided by a CVE Numbering Authority (CNA) for a rejected CVE ID. There can only be one CNA container per CVE record." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:Containers a owl:Class ;
    rdfs:label "Containers" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:adp ],
        [ a owl:Restriction ;
            owl:allValuesFrom cve:AdpContainer ;
            owl:onProperty cve:adp ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:cna ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cve:cna ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ owl:intersectionOf ( [ owl:unionOf ( cve:CnaPublishedContainer cve:CnaRejectedContainer ) ] cve:CnaContainer ) ] ;
            owl:onProperty cve:cna ] ;
    skos:definition "A set of structures (called containers) used to store vulnerability information related to a specific CVE ID. At minimum a 'cna' container is required." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:CpeMatch a owl:Class ;
    rdfs:label "CpeMatch" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:cpe_vulnerable ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty cve:cpe_vulnerable ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:version_start_including ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cve:version_start_excluding ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cve:version_end_excluding ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:version_end_including ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:version_start_including ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:version_start_excluding ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:version_end_excluding ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cve:match_criteria_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:version_start_excluding ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:version_end_excluding ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:match_criteria_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:cpe_criteria ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:match_criteria_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cve:cpe_criteria ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cve:cpe_vulnerable ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cve:version_end_including ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cve:cpe_criteria ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cve:version_start_including ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:version_end_including ] ;
    skos:definition "CPE match string or range within a CPE applicability node." ;
    skos:exactMatch nvd:CPEMatch ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:CpeNode a owl:Class ;
    rdfs:label "CpeNode" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:cpe_negate ],
        [ a owl:Restriction ;
            owl:allValuesFrom cve:CpeMatch ;
            owl:onProperty cve:cpe_match_criteria ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cve:cpe_match_criteria ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:boolean ;
            owl:onProperty cve:cpe_negate ],
        [ a owl:Restriction ;
            owl:allValuesFrom cve:CpeOperator ;
            owl:onProperty cve:cpe_operator ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cve:cpe_operator ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:cpe_negate ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:cpe_operator ] ;
    skos:definition "Defines a CPE configuration node in an applicability statement." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

<https://w3id.org/lmodel/cve/CpeOperator#AND> a owl:Class ;
    rdfs:label "AND" ;
    rdfs:subClassOf cve:CpeOperator ;
    skos:definition "All CPE match criteria must be satisfied." .

<https://w3id.org/lmodel/cve/CpeOperator#OR> a owl:Class ;
    rdfs:label "OR" ;
    rdfs:subClassOf cve:CpeOperator ;
    skos:definition "Any one CPE match criterion must be satisfied." .

<https://w3id.org/lmodel/cve/CreditType#analyst> a owl:Class ;
    rdfs:label "analyst" ;
    rdfs:subClassOf cve:CreditType ;
    skos:definition "Validates the vulnerability to ensure accuracy or severity." .

<https://w3id.org/lmodel/cve/CreditType#coordinator> a owl:Class ;
    rdfs:label "coordinator" ;
    rdfs:subClassOf cve:CreditType ;
    skos:definition "Facilitates the coordinated response process." .

<https://w3id.org/lmodel/cve/CreditType#finder> a owl:Class ;
    rdfs:label "finder" ;
    rdfs:subClassOf cve:CreditType ;
    skos:definition "Identifies the vulnerability." .

<https://w3id.org/lmodel/cve/CreditType#other> a owl:Class ;
    rdfs:label "other" ;
    rdfs:subClassOf cve:CreditType ;
    skos:definition "Other credit type not covered by the above categories." .

<https://w3id.org/lmodel/cve/CreditType#remediation%20developer> a owl:Class ;
    rdfs:label "remediation developer" ;
    rdfs:subClassOf cve:CreditType ;
    skos:definition "Prepares a code change or other remediation plans." .

<https://w3id.org/lmodel/cve/CreditType#remediation%20reviewer> a owl:Class ;
    rdfs:label "remediation reviewer" ;
    rdfs:subClassOf cve:CreditType ;
    skos:definition "Reviews vulnerability remediation plans or code changes for effectiveness and completeness." .

<https://w3id.org/lmodel/cve/CreditType#remediation%20verifier> a owl:Class ;
    rdfs:label "remediation verifier" ;
    rdfs:subClassOf cve:CreditType ;
    skos:definition "Tests and verifies the vulnerability or its remediation." .

<https://w3id.org/lmodel/cve/CreditType#reporter> a owl:Class ;
    rdfs:label "reporter" ;
    rdfs:subClassOf cve:CreditType ;
    skos:definition "Notifies the vendor of the vulnerability to a CNA." .

<https://w3id.org/lmodel/cve/CreditType#sponsor> a owl:Class ;
    rdfs:label "sponsor" ;
    rdfs:subClassOf cve:CreditType ;
    skos:definition "Supports the vulnerability identification or remediation activities." .

<https://w3id.org/lmodel/cve/CreditType#tool> a owl:Class ;
    rdfs:label "tool" ;
    rdfs:subClassOf cve:CreditType ;
    skos:definition "Names of tools used in vulnerability discovery or identification." .

cve:CveMetadataPublished a owl:Class ;
    rdfs:label "CveMetadataPublished" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:requester_user_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:date_reserved ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:date_updated ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^CVE-[0-9]{4}-[0-9]{4,19}$" ] ) ] ) ] ;
            owl:onProperty cve:record_cve_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cve:assigner_org_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cve:date_reserved ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:date_published ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:record_cve_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                                owl:onDatatype xsd:integer ;
                                owl:withRestrictions ( [ xsd:minInclusive 1 ] ) ] ) ] ;
            owl:onProperty cve:serial ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:assigner_org_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:date_updated ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:serial ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^.{2,32}$" ] ) ] ) ] ;
            owl:onProperty cve:assigner_short_name ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cve:published_state ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:date_published ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cve:date_published ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:assigner_short_name ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cve:record_cve_id ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cve:date_updated ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:assigner_short_name ],
        [ a owl:Restriction ;
            owl:allValuesFrom cve:RecordState ;
            owl:onProperty cve:published_state ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:requester_user_id ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cve:assigner_org_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:date_reserved ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cve:requester_user_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:serial ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:published_state ],
        cve:CveMetadata ;
    skos:definition "Metadata for a CVE Record in the PUBLISHED state." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

