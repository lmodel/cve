	skos:closeMatch <http://w3id.org/sepses/vocab/ref/cvss#hasCVSS> ;
	skos:definition "The scorings of the vulnerability." ;
	skos:inScheme cve:cve_record ;
	cve:upstream_path "CVE_Record_Format.json#/definitions/metrics" .
