	rdfs:label "integrityImpact" ;
	skos:closeMatch <http://w3id.org/sepses/vocab/ref/cvss#integrityImpact> ;
	skos:definition "How much an attack could change that should not change." ;
	skos:inScheme cve:cve_cvss ;
	cve:upstream_path "imports/cvss/cvss-v2.0.json#/properties/integrityImpact imports/cvss/cvss-v3.0.json#/properties/integrityImpact imports/cvss/cvss-v3.1.json#/properties/integrityImpact" .
cve:integrityRequirement a owl:DatatypeProperty ;
	rdfs:label "integrityRequirement" ;
	skos:definition "How much integrity matters to the scorer for the affected system." ;
	skos:inScheme cve:cve_cvss ;
	cve:upstream_path "imports/cvss/cvss-v2.0.json#/properties/integrityRequirement imports/cvss/cvss-v3.0.json#/properties/integrityRequirement imports/cvss/cvss-v3.1.json#/properties/integrityRequirement imports/cvss/cvss-v4.0.json#/properties/integrityRequirement" .
cve:lang a owl:DatatypeProperty ;
	rdfs:label "lang" ;
	rdfs:range xsd:language ;
	skos:closeMatch dcterms:language , <http://schema.org/inLanguage> ;
	skos:definition "The language of the text beside it." ;
	skos:inScheme cve:cve_record ;
	cve:upstream_path "CVE_Record_Format.json#/definitions/language" .
cve:lessThan a owl:DatatypeProperty ;
	rdfs:label "lessThan" ;
	skos:definition "The first version above the range, which is not itself in it." ;
	skos:inScheme cve:cve_record ;
	cve:upstream_path "CVE_Record_Format.json#/definitions/product/properties/versions/items/properties/lessThan" .
cve:lessThanOrEqual a owl:DatatypeProperty ;
	rdfs:label "lessThanOrEqual" ;
	skos:definition "The last version in the range." ;
	skos:inScheme cve:cve_record ;
	cve:upstream_path "CVE_Record_Format.json#/definitions/product/properties/versions/items/properties/lessThanOrEqual" .
cve:matchCriteriaId a owl:DatatypeProperty ;
	rdfs:label "matchCriteriaId" ;
	skos:definition "A UUID for this match." ;
	skos:inScheme cve:cve_record ;
	cve:upstream_path "CVE_Record_Format.json#/definitions/cpe_match/properties/matchCriteriaId" .
