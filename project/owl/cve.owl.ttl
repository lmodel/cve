    rdfs:label "cvss4_user_interaction" ;
    rdfs:range cve:Cvss4UserInteraction ;
    skos:altLabel "userInteraction" ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:cvss4_value_density a owl:ObjectProperty ;
    rdfs:label "cvss4_value_density" ;
    rdfs:range cve:Cvss4ValueDensity ;
    skos:altLabel "valueDensity" ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:cvss4_vector_string a owl:DatatypeProperty ;
    rdfs:label "cvss4_vector_string" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                        owl:onDatatype xsd:string ;
                        owl:withRestrictions ( [ xsd:pattern "^CVSS:4[.]0/AV:[NALP]/AC:[LH]/AT:[NP]/PR:[NLH]/UI:[NPA]/VC:[HLN]/VI:[HLN]/VA:[HLN]/SC:[HLN]/SI:[HLN]/SA:[HLN](/E:[XAPU])?(/CR:[XHML])?(/IR:[XHML])?(/AR:[XHML])?(/MAV:[XNALP])?(/MAC:[XLH])?(/MAT:[XNP])?(/MPR:[XNLH])?(/MUI:[XNPA])?(/MVC:[XNLH])?(/MVI:[XNLH])?(/MVA:[XNLH])?(/MSC:[XNLH])?(/MSI:[XNLHS])?(/MSA:[XNLHS])?(/S:[XNP])?(/AU:[XNY])?(/R:[XAUI])?(/V:[XDC])?(/RE:[XLMH])?(/U:(X|Clear|Green|Amber|Red))?$" ] ) ] ) ] ;
    skos:altLabel "vectorString" ;
    skos:definition "CVSS 4.0 vector string encoding all base, threat, and environmental metrics." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:cvss4_version a owl:DatatypeProperty ;
    rdfs:label "cvss4_version" ;
    rdfs:range xsd:string ;
    skos:altLabel "version" ;
    skos:definition "CVSS version identifier. Must be '4.0' for CVSS v4.0 objects." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:cvss4_vuln_availability_impact a owl:ObjectProperty ;
    rdfs:label "cvss4_vuln_availability_impact" ;
    rdfs:range cve:Cvss4VulnCia ;
    skos:altLabel "vulnAvailabilityImpact" ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:cvss4_vuln_confidentiality_impact a owl:ObjectProperty ;
    rdfs:label "cvss4_vuln_confidentiality_impact" ;
    rdfs:range cve:Cvss4VulnCia ;
    skos:altLabel "vulnConfidentialityImpact" ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:cvss4_vuln_integrity_impact a owl:ObjectProperty ;
    rdfs:label "cvss4_vuln_integrity_impact" ;
    rdfs:range cve:Cvss4VulnCia ;
    skos:altLabel "vulnIntegrityImpact" ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:cvss4_vulnerability_response_effort a owl:ObjectProperty ;
    rdfs:label "cvss4_vulnerability_response_effort" ;
    rdfs:range cve:Cvss4VulnerabilityResponseEffort ;
    skos:altLabel "vulnerabilityResponseEffort" ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:data_type a owl:ObjectProperty ;
    rdfs:label "data_type" ;
    rdfs:range cve:DataType ;
    skos:altLabel "dataType" ;
    skos:definition "Indicates the type of information represented in the JSON instance." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:data_version a owl:DatatypeProperty ;
    rdfs:label "data_version" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                        owl:onDatatype xsd:string ;
                        owl:withRestrictions ( [ xsd:pattern "^5\\.(0|[1-9][0-9]*)(\\.(0|[1-9][0-9]*))?$" ] ) ] ) ] ;
    skos:altLabel "dataVersion" ;
    skos:definition "The version of the CVE schema used for validating this record. Supports multiple versions of the format (e.g., '5.2.0')." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:date_assigned a owl:DatatypeProperty ;
    rdfs:label "date_assigned" ;
    rdfs:range xsd:string ;
    skos:altLabel "dateAssigned" ;
    skos:definition "The date/time this CVE ID was associated with a vulnerability by a CNA." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:date_rejected a owl:DatatypeProperty ;
    rdfs:label "date_rejected" ;
    rdfs:range xsd:string ;
    skos:altLabel "dateRejected" ;
    skos:definition "The date/time the CVE ID was rejected." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:description_value a owl:DatatypeProperty ;
    rdfs:label "description_value" ;
    rdfs:range xsd:string ;
    skos:altLabel "value" ;
    skos:definition "Plain text description (up to 4096 characters)." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:event_time a owl:DatatypeProperty ;
    rdfs:label "event_time" ;
    rdfs:range xsd:string ;
    skos:altLabel "time" ;
    skos:definition "Timestamp representing when the event in the timeline occurred. Format is RFC3339 / ISO8601 with optional timezone." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:event_value a owl:DatatypeProperty ;
    rdfs:label "event_value" ;
    rdfs:range xsd:string ;
    skos:altLabel "value" ;
    skos:definition "A summary of the timeline event (up to 4096 characters)." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:match_criteria_id a owl:DatatypeProperty ;
    rdfs:label "match_criteria_id" ;
    rdfs:range xsd:string ;
    skos:altLabel "matchCriteriaId" ;
    skos:definition "UUID identifying the CPE match criteria set." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:media_type a owl:DatatypeProperty ;
    rdfs:label "media_type" ;
    rdfs:range xsd:string ;
    skos:altLabel "type" ;
    skos:definition "RFC2046 compliant IANA Media type (e.g., text/markdown, text/html, image/png, image/svg, audio/mp3)." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:media_value a owl:DatatypeProperty ;
    rdfs:label "media_value" ;
    rdfs:range xsd:string ;
    skos:altLabel "value" ;
    skos:definition "Supporting media content, up to 16K characters. If base64_encoded is true, this stores base64 encoded data." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:metric_format a owl:DatatypeProperty ;
    rdfs:label "metric_format" ;
    rdfs:range xsd:string ;
    skos:altLabel "format" ;
    skos:definition "Name of the scoring format (e.g., cvssV4_0, cvssV3_1). Provides future-proofing and supports proprietary format inclusion." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:org_id a owl:DatatypeProperty ;
    rdfs:label "org_id" ;
    rdfs:range xsd:string ;
    skos:altLabel "orgId" ;
    skos:definition "The container provider's organizational UUID." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:other_metric_content a owl:ObjectProperty ;
    rdfs:label "other_metric_content" ;
    rdfs:range cve:Any ;
    skos:altLabel "content" ;
    skos:definition "Arbitrary JSON-compatible object (or prose string) containing non-standard metric data not covered by the CVSS formats. Upstream JSON Schema defines this as 'type: object, minProperties: 1'; range: Any allows any value." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:other_metric_type a owl:DatatypeProperty ;
    rdfs:label "other_metric_type" ;
    rdfs:range xsd:string ;
    skos:altLabel "type" ;
    skos:definition "Name of the non-standard impact metrics format used." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:package_url a owl:DatatypeProperty ;
    rdfs:label "package_url" ;
    rdfs:range xsd:anyURI ;
    skos:altLabel "packageURL" ;
    skos:definition "A Package URL (PURL), a unified URL specification for identifying packages hosted by known package hosts. The Package URL MUST NOT include a version." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:problem_description a owl:DatatypeProperty ;
    rdfs:label "problem_description" ;
    rdfs:range xsd:string ;
    skos:altLabel "description" ;
    skos:definition "Text description of the problem type, or title from CWE or OWASP." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:problem_source_type a owl:DatatypeProperty ;
    rdfs:label "problem_source_type" ;
    rdfs:range xsd:string ;
    skos:altLabel "type" ;
    skos:definition "Problem type source format (e.g., text, OWASP, CWE)." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:published_state a owl:ObjectProperty ;
    rdfs:label "published_state" ;
    rdfs:range cve:RecordState ;
    skos:altLabel "state" ;
    skos:definition "State of the CVE Record. For published records, this is always PUBLISHED." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:rejected_state a owl:ObjectProperty ;
    rdfs:label "rejected_state" ;
    rdfs:range cve:RecordState ;
    skos:altLabel "state" ;
    skos:definition "State of the CVE Record. For rejected records, this is always REJECTED." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:relationship_name a owl:DatatypeProperty ;
    rdfs:label "relationship_name" ;
    rdfs:range xsd:string ;
    skos:altLabel "relationshipName" ;
    skos:definition "A description of the relationship between the taxonomy item and the CVE." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:relationship_value a owl:DatatypeProperty ;
    rdfs:label "relationship_value" ;
    rdfs:range xsd:string ;
    skos:altLabel "relationshipValue" ;
    skos:definition "The target of the relationship. Can be the CVE ID or another taxonomy identifier." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:repo a owl:DatatypeProperty ;
    rdfs:label "repo" ;
    rdfs:range xsd:anyURI ;
    skos:definition "The URL of the source code repository, for informational purposes and/or to resolve git hash version ranges." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:requester_user_id a owl:DatatypeProperty ;
    rdfs:label "requester_user_id" ;
    rdfs:range xsd:string ;
    skos:altLabel "requesterUserId" ;
    skos:definition "The user that requested the CVE identifier." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:routine_name a owl:DatatypeProperty ;
    rdfs:label "routine_name" ;
    rdfs:range xsd:string ;
    skos:altLabel "name" ;
    skos:definition "Name of the affected source code function, method, subroutine, or procedure." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:scenario_value a owl:DatatypeProperty ;
    rdfs:label "scenario_value" ;
    rdfs:range xsd:string ;
    skos:altLabel "value" ;
    skos:definition "Description of the scenario this metrics object applies to." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:short_name a owl:DatatypeProperty ;
    rdfs:label "short_name" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                        owl:onDatatype xsd:string ;
                        owl:withRestrictions ( [ xsd:pattern "^.{2,32}$" ] ) ] ) ] ;
    skos:altLabel "shortName" ;
    skos:definition "The container provider's organizational short name (2-32 characters)." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:source_advisory a owl:DatatypeProperty ;
    rdfs:label "source_advisory" ;
    rdfs:range xsd:string ;
    skos:altLabel "advisory" ;
    skos:definition "Advisory identifier associated with the vulnerability discovery." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:source_discovery a owl:DatatypeProperty ;
    rdfs:label "source_discovery" ;
    rdfs:range xsd:string ;
    skos:altLabel "discovery" ;
    skos:definition "How the vulnerability was discovered (e.g., INTERNAL, EXTERNAL, USER)." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:taxonomy_id a owl:DatatypeProperty ;
    rdfs:label "taxonomy_id" ;
    rdfs:range xsd:string ;
    skos:altLabel "taxonomyId" ;
    skos:definition "Identifier of the item in the taxonomy. Used as the subject of the relationship." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:taxonomy_name a owl:DatatypeProperty ;
    rdfs:label "taxonomy_name" ;
    rdfs:range xsd:string ;
    skos:altLabel "taxonomyName" ;
    skos:definition "The name of the taxonomy (e.g., ATT&CK, D3FEND, CWE, CVSS)." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:taxonomy_version a owl:DatatypeProperty ;
    rdfs:label "taxonomy_version" ;
    rdfs:range xsd:string ;
    skos:altLabel "taxonomyVersion" ;
    skos:definition "The version of the taxonomy the identifiers come from." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:version_end_excluding a owl:DatatypeProperty ;
    rdfs:label "version_end_excluding" ;
    rdfs:range xsd:string ;
    skos:altLabel "versionEndExcluding" ;
    skos:definition "The end of a version range, exclusive (versions strictly less than this)." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:version_end_including a owl:DatatypeProperty ;
    rdfs:label "version_end_including" ;
    rdfs:range xsd:string ;
    skos:altLabel "versionEndIncluding" ;
    skos:definition "The end of a version range, inclusive (versions less than or equal to this)." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:version_start_excluding a owl:DatatypeProperty ;
    rdfs:label "version_start_excluding" ;
    rdfs:range xsd:string ;
    skos:altLabel "versionStartExcluding" ;
    skos:definition "The start of a version range, exclusive (versions strictly greater than this)." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:version_start_including a owl:DatatypeProperty ;
    rdfs:label "version_start_including" ;
    rdfs:range xsd:string ;
    skos:altLabel "versionStartIncluding" ;
    skos:definition "The start of a version range, inclusive (versions greater than or equal to this)." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:version_status a owl:ObjectProperty ;
    rdfs:label "version_status" ;
    rdfs:range cve:VersionStatus ;
    skos:altLabel "status" ;
    skos:definition "The vulnerability status for the version or range of versions. For a range, the status may be refined by the 'changes' list." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:version_value a owl:DatatypeProperty ;
    rdfs:label "version_value" ;
    rdfs:range xsd:string ;
    skos:altLabel "version" ;
    skos:definition "The single version being described, or the version at the start of the range. By convention, '0' denotes the earliest possible version." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:versions a owl:ObjectProperty ;
    rdfs:label "versions" ;
    rdfs:range cve:VersionEntry ;
    skos:definition "Set of product versions or version ranges related to the vulnerability. Versions or defaultStatus may be omitted, but not both." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

<https://w3id.org/lmodel/vulnerability-core/Product> a owl:Class ;
    rdfs:label "Product" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/version> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/name> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/vendor> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/vendor> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/platforms> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/platforms> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/name> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/version> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/vendor> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/name> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/version> ] ;
    skos:definition "Software or hardware entity affected by the vulnerability." ;
    skos:exactMatch schema1:SoftwareApplication ;
    skos:inScheme <https://w3id.org/lmodel/vulnerability-core> ;
    skos:relatedMatch kev_catalog:KevEntry .

<https://w3id.org/lmodel/vulnerability-core/Reference> a owl:Class ;
    rdfs:label "Reference" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/name> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/name> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/source> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:anyURI ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/url> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/url> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/name> ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/source> ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/source> ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty <https://w3id.org/lmodel/vulnerability-core/url> ] ;
    skos:closeMatch cwe:ExternalReference,
        nvd:NVDReference ;
    skos:definition "External reference such as an advisory or article." ;
    skos:exactMatch schema1:CreativeWork ;
    skos:inScheme <https://w3id.org/lmodel/vulnerability-core> .

<https://w3id.org/lmodel/vulnerability-core/cpe_uri> a owl:DatatypeProperty ;
    rdfs:label "cpe_uri" ;
    rdfs:range xsd:string ;
    skos:altLabel "cpeUri" ;
    skos:definition "CPE 2.2 URI identifying an affected product configuration." ;
    skos:inScheme <https://w3id.org/lmodel/vulnerability-core> ;
    skos:relatedMatch nvd:CPEMatch .

<https://w3id.org/lmodel/vulnerability-core/cve_id> a owl:DatatypeProperty ;
    rdfs:label "cve_id" ;
    rdfs:range xsd:string ;
    skos:altLabel "cveId" ;
    skos:definition "The CVE identifier assigned by a CVE Numbering Authority (CNA). Format: CVE-YYYY-NNNNN." ;
    skos:exactMatch schema1:identifier ;
    skos:inScheme <https://w3id.org/lmodel/vulnerability-core> .

<https://w3id.org/lmodel/vulnerability-core/impact> a owl:ObjectProperty ;
    rdfs:label "impact" ;
    rdfs:range <https://w3id.org/lmodel/vulnerability-core/Impact> ;
    skos:definition "Impact and severity assessment for this vulnerability." ;
    skos:inScheme <https://w3id.org/lmodel/vulnerability-core> .

<https://w3id.org/lmodel/vulnerability-core/last_modified_date> a owl:DatatypeProperty ;
    rdfs:label "last_modified_date" ;
    rdfs:range xsd:dateTime ;
    skos:definition "Date and time the vulnerability record was last modified." ;
    skos:inScheme <https://w3id.org/lmodel/vulnerability-core> .

<https://w3id.org/lmodel/vulnerability-core/operator> a owl:DatatypeProperty ;
    rdfs:label "operator" ;
    rdfs:range xsd:string ;
    skos:definition "Logical operator (AND/OR) used in configuration node groupings." ;
    skos:inScheme <https://w3id.org/lmodel/vulnerability-core> .

<https://w3id.org/lmodel/vulnerability-core/published_date> a owl:DatatypeProperty ;
    rdfs:label "published_date" ;
    rdfs:range xsd:dateTime ;
    skos:definition "Date and time the vulnerability was first published." ;
    skos:inScheme <https://w3id.org/lmodel/vulnerability-core> ;
    skos:relatedMatch kev_catalog:date_added .

<https://w3id.org/lmodel/vulnerability-core/score> a owl:DatatypeProperty ;
    rdfs:label "score" ;
    rdfs:range xsd:float ;
    skos:definition "Numeric vulnerability score (e.g. CVSS base score)." ;
    skos:inScheme <https://w3id.org/lmodel/vulnerability-core> .

<https://w3id.org/lmodel/vulnerability-core/severity> a owl:ObjectProperty ;
    rdfs:label "severity" ;
    rdfs:range cve:ImpactSeverity ;
    skos:closeMatch nvd:CVSSMetric ;
    skos:definition "Qualitative severity rating." ;
    skos:inScheme <https://w3id.org/lmodel/vulnerability-core> .

<https://w3id.org/lmodel/vulnerability-core/source> a owl:DatatypeProperty ;
    rdfs:label "source" ;
    rdfs:range xsd:string ;
    skos:definition "Source or origin of the reference or data." ;
    skos:inScheme <https://w3id.org/lmodel/vulnerability-core> .

<https://w3id.org/lmodel/vulnerability-core/status> a owl:ObjectProperty ;
    rdfs:label "status" ;
    rdfs:range cve:VulnerabilityStatus ;
    skos:closeMatch nvd:NVDWorkflowStatus ;
    skos:definition "Current lifecycle state of the vulnerability record." ;
    skos:inScheme <https://w3id.org/lmodel/vulnerability-core> .

<https://w3id.org/lmodel/vulnerability-core/url> a owl:DatatypeProperty ;
    rdfs:label "url" ;
    rdfs:range xsd:anyURI ;
    skos:definition "URL pointing to the reference resource." ;
    skos:inScheme <https://w3id.org/lmodel/vulnerability-core> .

<https://w3id.org/lmodel/vulnerability-core/vector> a owl:DatatypeProperty ;
    rdfs:label "vector" ;
    rdfs:range xsd:string ;
    skos:closeMatch nvd:CVSSMetric ;
    skos:definition "CVSS vector string or equivalent scoring vector expression." ;
    skos:inScheme <https://w3id.org/lmodel/vulnerability-core> .

<https://w3id.org/lmodel/vulnerability-core/vendor> a owl:DatatypeProperty ;
    rdfs:label "vendor" ;
    rdfs:range xsd:string ;
    skos:definition "Name of the vendor or organization responsible for the product." ;
    skos:inScheme <https://w3id.org/lmodel/vulnerability-core> .

<https://w3id.org/lmodel/vulnerability-core/version> a owl:DatatypeProperty ;
    rdfs:label "version" ;
    rdfs:range xsd:string ;
    skos:definition "Version string of the affected product." ;
    skos:inScheme <https://w3id.org/lmodel/vulnerability-core> .

cve:CnaContainer a owl:Class ;
    rdfs:label "CnaContainer" ;
    skos:definition "Abstract base for CNA containers (published and rejected)." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:CveMetadata a owl:Class ;
    rdfs:label "CveMetadata" ;
    skos:definition "Abstract base for CVE Record metadata. Represents either a Published or Rejected record's metadata. All fields are controlled by CVE Services." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:Cvss3AttackComplexity a owl:Class ;
    rdfs:label "Cvss3AttackComplexity" ;
    owl:unionOf ( <https://w3id.org/lmodel/cve/Cvss3AttackComplexity#HIGH> <https://w3id.org/lmodel/cve/Cvss3AttackComplexity#LOW> ) ;
    skos:definition "CVSS 3.x attack complexity base metric." ;
    skos:inScheme <https://w3id.org/lmodel/cve> ;
    linkml:permissible_values <https://w3id.org/lmodel/cve/Cvss3AttackComplexity#HIGH>,
        <https://w3id.org/lmodel/cve/Cvss3AttackComplexity#LOW> .

cve:Cvss3Scope a owl:Class ;
    rdfs:label "Cvss3Scope" ;
    owl:unionOf ( <https://w3id.org/lmodel/cve/Cvss3Scope#UNCHANGED> <https://w3id.org/lmodel/cve/Cvss3Scope#CHANGED> ) ;
    skos:definition "CVSS 3.x scope base metric." ;
    skos:inScheme <https://w3id.org/lmodel/cve> ;
    linkml:permissible_values <https://w3id.org/lmodel/cve/Cvss3Scope#CHANGED>,
        <https://w3id.org/lmodel/cve/Cvss3Scope#UNCHANGED> .

cve:Cvss3UserInteraction a owl:Class ;
    rdfs:label "Cvss3UserInteraction" ;
    owl:unionOf ( <https://w3id.org/lmodel/cve/Cvss3UserInteraction#NONE> <https://w3id.org/lmodel/cve/Cvss3UserInteraction#REQUIRED> ) ;
    skos:definition "CVSS 3.x user interaction base metric." ;
    skos:inScheme <https://w3id.org/lmodel/cve> ;
    linkml:permissible_values <https://w3id.org/lmodel/cve/Cvss3UserInteraction#NONE>,
        <https://w3id.org/lmodel/cve/Cvss3UserInteraction#REQUIRED> .

cve:Cvss4AttackComplexity a owl:Class ;
    rdfs:label "Cvss4AttackComplexity" ;
    owl:unionOf ( <https://w3id.org/lmodel/cve/Cvss4AttackComplexity#HIGH> <https://w3id.org/lmodel/cve/Cvss4AttackComplexity#LOW> ) ;
    skos:definition "CVSS 4.0 attack complexity base metric." ;
    skos:inScheme <https://w3id.org/lmodel/cve> ;
    linkml:permissible_values <https://w3id.org/lmodel/cve/Cvss4AttackComplexity#HIGH>,
        <https://w3id.org/lmodel/cve/Cvss4AttackComplexity#LOW> .

cve:Cvss4AttackRequirements a owl:Class ;
    rdfs:label "Cvss4AttackRequirements" ;
    owl:unionOf ( <https://w3id.org/lmodel/cve/Cvss4AttackRequirements#NONE> <https://w3id.org/lmodel/cve/Cvss4AttackRequirements#PRESENT> ) ;
    skos:definition "CVSS 4.0 attack requirements base metric." ;
    skos:inScheme <https://w3id.org/lmodel/cve> ;
    linkml:permissible_values <https://w3id.org/lmodel/cve/Cvss4AttackRequirements#NONE>,
        <https://w3id.org/lmodel/cve/Cvss4AttackRequirements#PRESENT> .

cve:CvssV3Version a owl:Class ;
    rdfs:label "CvssV3Version" ;
    owl:unionOf ( <https://w3id.org/lmodel/cve/CvssV3Version#3.0> <https://w3id.org/lmodel/cve/CvssV3Version#3.1> ) ;
    skos:definition "CVSS version 3.x identifier. CVSS 3.0 and 3.1 share an identical metric model; the 3.1 spec was a clarification, not a structural change. The consolidated CvssV3 class accepts either via this enum." ;
    skos:inScheme <https://w3id.org/lmodel/cve> ;
    linkml:permissible_values <https://w3id.org/lmodel/cve/CvssV3Version#3.0>,
        <https://w3id.org/lmodel/cve/CvssV3Version#3.1> .

cve:ProviderMetadata a owl:Class ;
    rdfs:label "ProviderMetadata" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a rdfs:Datatype ;
                    owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                                owl:onDatatype xsd:string ;
                                owl:withRestrictions ( [ xsd:pattern "^.{2,32}$" ] ) ] ) ] ;
            owl:onProperty cve:short_name ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:short_name ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:date_updated ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cve:org_id ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:org_id ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:date_updated ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cve:date_updated ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:short_name ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cve:org_id ] ;
    skos:definition "Details related to the information container provider (CNA or ADP)." ;
    skos:inScheme <https://w3id.org/lmodel/cve> ;
    skos:relatedMatch nvd:ScoreSource .

cve:VersionEntry a owl:Class ;
    rdfs:label "VersionEntry" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cve:version_value ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:version_value ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:less_than_or_equal ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:less_than ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cve:less_than_or_equal ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:version_type ],
        [ a owl:Restriction ;
            owl:allValuesFrom cve:VersionChange ;
            owl:onProperty cve:version_changes ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cve:version_type ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:version_type ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cve:version_status ],
        [ owl:complementOf [ owl:intersectionOf ( [ a owl:Restriction ;
                                owl:allValuesFrom xsd:string ;
                                owl:onProperty cve:less_than ] [ a owl:Restriction ;
                                owl:allValuesFrom xsd:string ;
                                owl:onProperty cve:less_than_or_equal ] ) ] ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:version_status ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:less_than_or_equal ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cve:version_value ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cve:less_than ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:less_than ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:version_changes ],
        [ a owl:Restriction ;
            owl:allValuesFrom cve:VersionStatus ;
            owl:onProperty cve:version_status ] ;
    skos:definition "A single version or a range of versions of a product with associated vulnerability status. An entry with only version and status is a point version; an entry with versionType and a less-than limit describes a range." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:affected a owl:ObjectProperty ;
    rdfs:label "affected" ;
    rdfs:range cve:AffectedProduct ;
    skos:definition "List of affected products and services." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:collection_url a owl:DatatypeProperty ;
    rdfs:label "collection_url" ;
    rdfs:range xsd:anyURI ;
    skos:altLabel "collectionURL" ;
    skos:definition "URL identifying a package collection (determines the meaning of packageName)." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:configurations_text a owl:ObjectProperty ;
    rdfs:label "configurations_text" ;
    rdfs:range cve:MultiLangDescription ;
    skos:altLabel "configurations" ;
    skos:definition "Configurations required for exploiting this vulnerability." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:cpe_applicability a owl:ObjectProperty ;
    rdfs:label "cpe_applicability" ;
    rdfs:range cve:CpeApplicabilityElement ;
    skos:altLabel "cpeApplicability" ;
    skos:definition "Affected products defined using the CPE Applicability Language. When defined, this block should align with the data in the affected block." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:credits a owl:ObjectProperty ;
    rdfs:label "credits" ;
    rdfs:range cve:CreditEntry ;
    skos:definition "Statements acknowledging specific people, organizations, or tools for work related to research, discovery, remediation, or coordination of this CVE." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:cve_references a owl:ObjectProperty ;
    rdfs:label "cve_references" ;
    rdfs:range cve:CveReference ;
    skos:altLabel "references" ;
    skos:definition "Reference data in the form of URLs describing the vulnerability, such as advisories, patches, and exploit details. Required by CNA rules." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:cvss_v2_0 a owl:ObjectProperty ;
    rdfs:label "cvss_v2_0" ;
    rdfs:range cve:CvssV20 ;
    skos:altLabel "cvssV2_0" ;
    skos:definition "CVSS version 2.0 scoring data." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:cvss_v3 a owl:ObjectProperty ;
    rdfs:label "cvss_v3" ;
    rdfs:range cve:CvssV3 ;
    skos:altLabel "cvssV3",
        "cvssV3_0",
        "cvssV3_1" ;
    skos:definition "CVSS version 3.x scoring data (covers both 3.0 and 3.1). The version is distinguished by the cvss3_version field within the CvssV3 object." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:cvss_v4_0 a owl:ObjectProperty ;
    rdfs:label "cvss_v4_0" ;
    rdfs:range cve:CvssV40 ;
    skos:altLabel "cvssV4_0" ;
    skos:definition "CVSS version 4.0 scoring data." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:default_status a owl:ObjectProperty ;
    rdfs:label "default_status" ;
    rdfs:range cve:VersionStatus ;
    skos:altLabel "defaultStatus" ;
    skos:definition "The default status for versions not otherwise listed in the versions list. Defaults to 'unknown' if not specified. Versions or defaultStatus may be omitted, but not both." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:descriptions a owl:ObjectProperty ;
    rdfs:label "descriptions" ;
    rdfs:range cve:MultiLangDescription ;
    skos:definition "A list of multi-lingual descriptions of the vulnerability. Must contain at least one English language entry. E.g., [PROBLEMTYPE] in [COMPONENT] in [VENDOR] [PRODUCT] [VERSION] on [PLATFORMS] allows [ATTACKER] to [IMPACT] via [VECTOR]." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:exploits a owl:ObjectProperty ;
    rdfs:label "exploits" ;
    rdfs:range cve:MultiLangDescription ;
    skos:definition "Information about known exploits of this vulnerability." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:impacts a owl:ObjectProperty ;
    rdfs:label "impacts" ;
    rdfs:range cve:ImpactEntry ;
    skos:definition "Collection of impacts of this vulnerability, optionally linked to CAPEC IDs." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:metrics a owl:ObjectProperty ;
    rdfs:label "metrics" ;
    rdfs:range cve:MetricEntry ;
    skos:definition "Collection of impact scores with attribution (CVSSv2, CVSSv3.0, CVSSv3.1, CVSSv4.0, or custom format)." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:other_metric a owl:ObjectProperty ;
    rdfs:label "other_metric" ;
    rdfs:range cve:OtherMetric ;
    skos:altLabel "other" ;
    skos:definition "A non-standard impact description or score." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:package_name a owl:DatatypeProperty ;
    rdfs:label "package_name" ;
    rdfs:range xsd:string ;
    skos:altLabel "packageName" ;
    skos:definition "Name or identifier of the affected software package as used in the package collection." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:problem_types a owl:ObjectProperty ;
    rdfs:label "problem_types" ;
    rdfs:range cve:ProblemType ;
    skos:altLabel "problemTypes" ;
    skos:definition "Problem type information such as CWE identifiers. Must contain at least one entry. Entries can be text, OWASP, or CWE identifiers." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:solutions a owl:ObjectProperty ;
    rdfs:label "solutions" ;
    rdfs:range cve:MultiLangDescription ;
    skos:definition "Information about solutions or remediations available for this vulnerability." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:taxonomy_mappings a owl:ObjectProperty ;
    rdfs:label "taxonomy_mappings" ;
    rdfs:range cve:TaxonomyMapping ;
    skos:altLabel "taxonomyMappings" ;
    skos:definition "List of taxonomy items (e.g., ATT&CK, CWE) related to the vulnerability." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:timeline a owl:ObjectProperty ;
    rdfs:label "timeline" ;
    rdfs:range cve:TimelineEntry ;
    skos:definition "Timeline information for significant events about the vulnerability or changes to the CVE Record." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:workarounds a owl:ObjectProperty ;
    rdfs:label "workarounds" ;
    rdfs:range cve:MultiLangDescription ;
    skos:definition "Workarounds and mitigations for this vulnerability." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:CNATag a owl:Class ;
    rdfs:label "CNATag" ;
    owl:unionOf ( <https://w3id.org/lmodel/cve/CNATag#unsupported-when-assigned> <https://w3id.org/lmodel/cve/CNATag#exclusively-hosted-service> <https://w3id.org/lmodel/cve/CNATag#disputed> ) ;
    skos:definition "Tags provided by a CNA describing the CVE Record." ;
    skos:inScheme <https://w3id.org/lmodel/cve> ;
    linkml:permissible_values <https://w3id.org/lmodel/cve/CNATag#disputed>,
        <https://w3id.org/lmodel/cve/CNATag#exclusively-hosted-service>,
        <https://w3id.org/lmodel/cve/CNATag#unsupported-when-assigned> .

cve:CpeOperator a owl:Class ;
    rdfs:label "CpeOperator" ;
    owl:unionOf ( <https://w3id.org/lmodel/cve/CpeOperator#AND> <https://w3id.org/lmodel/cve/CpeOperator#OR> ) ;
    skos:definition "Logical operator used in CPE applicability nodes." ;
    skos:inScheme <https://w3id.org/lmodel/cve> ;
    linkml:permissible_values <https://w3id.org/lmodel/cve/CpeOperator#AND>,
        <https://w3id.org/lmodel/cve/CpeOperator#OR> .

cve:CveReference a owl:Class ;
    rdfs:label "CveReference" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom cve:ReferenceTag ;
            owl:onProperty cve:reference_tags ],
        [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty cve:url ],
        [ a owl:Restriction ;
            owl:maxCardinality 1 ;
            owl:onProperty cve:url ],
        [ a owl:Restriction ;
            owl:minCardinality 1 ;
            owl:onProperty cve:url ],
        [ a owl:Restriction ;
            owl:minCardinality 0 ;
            owl:onProperty cve:reference_tags ],
        <https://w3id.org/lmodel/vulnerability-core/Reference> ;
    skos:closeMatch nvd:NVDReference ;
    skos:definition "An external reference associated with a CVE Record. Extends the core Reference with optional descriptive tags characterizing the resource." ;
    skos:inScheme <https://w3id.org/lmodel/cve> ;
    skos:relatedMatch cwe:ExternalReference .

cve:Cvss2AccessComplexity a owl:Class ;
    rdfs:label "Cvss2AccessComplexity" ;
    owl:unionOf ( <https://w3id.org/lmodel/cve/Cvss2AccessComplexity#HIGH> <https://w3id.org/lmodel/cve/Cvss2AccessComplexity#MEDIUM> <https://w3id.org/lmodel/cve/Cvss2AccessComplexity#LOW> ) ;
    skos:definition "CVSS 2.0 access complexity base metric." ;
    skos:inScheme <https://w3id.org/lmodel/cve> ;
    linkml:permissible_values <https://w3id.org/lmodel/cve/Cvss2AccessComplexity#HIGH>,
        <https://w3id.org/lmodel/cve/Cvss2AccessComplexity#LOW>,
        <https://w3id.org/lmodel/cve/Cvss2AccessComplexity#MEDIUM> .

cve:Cvss2AccessVector a owl:Class ;
    rdfs:label "Cvss2AccessVector" ;
    owl:unionOf ( <https://w3id.org/lmodel/cve/Cvss2AccessVector#NETWORK> <https://w3id.org/lmodel/cve/Cvss2AccessVector#ADJACENT_NETWORK> <https://w3id.org/lmodel/cve/Cvss2AccessVector#LOCAL> ) ;
    skos:definition "CVSS 2.0 access vector base metric." ;
    skos:inScheme <https://w3id.org/lmodel/cve> ;
    linkml:permissible_values <https://w3id.org/lmodel/cve/Cvss2AccessVector#ADJACENT_NETWORK>,
        <https://w3id.org/lmodel/cve/Cvss2AccessVector#LOCAL>,
        <https://w3id.org/lmodel/cve/Cvss2AccessVector#NETWORK> .

cve:Cvss2Authentication a owl:Class ;
    rdfs:label "Cvss2Authentication" ;
    owl:unionOf ( <https://w3id.org/lmodel/cve/Cvss2Authentication#MULTIPLE> <https://w3id.org/lmodel/cve/Cvss2Authentication#SINGLE> <https://w3id.org/lmodel/cve/Cvss2Authentication#NONE> ) ;
    skos:definition "CVSS 2.0 authentication base metric." ;
    skos:inScheme <https://w3id.org/lmodel/cve> ;
    linkml:permissible_values <https://w3id.org/lmodel/cve/Cvss2Authentication#MULTIPLE>,
        <https://w3id.org/lmodel/cve/Cvss2Authentication#NONE>,
        <https://w3id.org/lmodel/cve/Cvss2Authentication#SINGLE> .

cve:Cvss3ModifiedAttackComplexity a owl:Class ;
    rdfs:label "Cvss3ModifiedAttackComplexity" ;
    owl:unionOf ( <https://w3id.org/lmodel/cve/Cvss3ModifiedAttackComplexity#HIGH> <https://w3id.org/lmodel/cve/Cvss3ModifiedAttackComplexity#LOW> <https://w3id.org/lmodel/cve/Cvss3ModifiedAttackComplexity#NOT_DEFINED> ) ;
    skos:definition "CVSS 3.x modified attack complexity environmental metric." ;
    skos:inScheme <https://w3id.org/lmodel/cve> ;
    linkml:permissible_values <https://w3id.org/lmodel/cve/Cvss3ModifiedAttackComplexity#HIGH>,
        <https://w3id.org/lmodel/cve/Cvss3ModifiedAttackComplexity#LOW>,
        <https://w3id.org/lmodel/cve/Cvss3ModifiedAttackComplexity#NOT_DEFINED> .

cve:Cvss3ModifiedScope a owl:Class ;
    rdfs:label "Cvss3ModifiedScope" ;
    owl:unionOf ( <https://w3id.org/lmodel/cve/Cvss3ModifiedScope#UNCHANGED> <https://w3id.org/lmodel/cve/Cvss3ModifiedScope#CHANGED> <https://w3id.org/lmodel/cve/Cvss3ModifiedScope#NOT_DEFINED> ) ;
    skos:definition "CVSS 3.x modified scope environmental metric." ;
    skos:inScheme <https://w3id.org/lmodel/cve> ;
    linkml:permissible_values <https://w3id.org/lmodel/cve/Cvss3ModifiedScope#CHANGED>,
        <https://w3id.org/lmodel/cve/Cvss3ModifiedScope#NOT_DEFINED>,
        <https://w3id.org/lmodel/cve/Cvss3ModifiedScope#UNCHANGED> .

cve:Cvss3ModifiedUserInteraction a owl:Class ;
    rdfs:label "Cvss3ModifiedUserInteraction" ;
    owl:unionOf ( <https://w3id.org/lmodel/cve/Cvss3ModifiedUserInteraction#NONE> <https://w3id.org/lmodel/cve/Cvss3ModifiedUserInteraction#REQUIRED> <https://w3id.org/lmodel/cve/Cvss3ModifiedUserInteraction#NOT_DEFINED> ) ;
    skos:definition "CVSS 3.x modified user interaction environmental metric." ;
    skos:inScheme <https://w3id.org/lmodel/cve> ;
    linkml:permissible_values <https://w3id.org/lmodel/cve/Cvss3ModifiedUserInteraction#NONE>,
        <https://w3id.org/lmodel/cve/Cvss3ModifiedUserInteraction#NOT_DEFINED>,
        <https://w3id.org/lmodel/cve/Cvss3ModifiedUserInteraction#REQUIRED> .

cve:Cvss3PrivilegesRequired a owl:Class ;
    rdfs:label "Cvss3PrivilegesRequired" ;
    owl:unionOf ( <https://w3id.org/lmodel/cve/Cvss3PrivilegesRequired#HIGH> <https://w3id.org/lmodel/cve/Cvss3PrivilegesRequired#LOW> <https://w3id.org/lmodel/cve/Cvss3PrivilegesRequired#NONE> ) ;
    skos:definition "CVSS 3.x privileges required base metric." ;
    skos:inScheme <https://w3id.org/lmodel/cve> ;
    linkml:permissible_values <https://w3id.org/lmodel/cve/Cvss3PrivilegesRequired#HIGH>,
        <https://w3id.org/lmodel/cve/Cvss3PrivilegesRequired#LOW>,
        <https://w3id.org/lmodel/cve/Cvss3PrivilegesRequired#NONE> .

cve:Cvss4Automatable a owl:Class ;
    rdfs:label "Cvss4Automatable" ;
    owl:unionOf ( <https://w3id.org/lmodel/cve/Cvss4Automatable#NO> <https://w3id.org/lmodel/cve/Cvss4Automatable#YES> <https://w3id.org/lmodel/cve/Cvss4Automatable#NOT_DEFINED> ) ;
    skos:definition "CVSS 4.0 automatable supplemental metric." ;
    skos:inScheme <https://w3id.org/lmodel/cve> ;
    linkml:permissible_values <https://w3id.org/lmodel/cve/Cvss4Automatable#NO>,
        <https://w3id.org/lmodel/cve/Cvss4Automatable#NOT_DEFINED>,
        <https://w3id.org/lmodel/cve/Cvss4Automatable#YES> .

cve:Cvss4ModifiedAttackComplexity a owl:Class ;
    rdfs:label "Cvss4ModifiedAttackComplexity" ;
    owl:unionOf ( <https://w3id.org/lmodel/cve/Cvss4ModifiedAttackComplexity#HIGH> <https://w3id.org/lmodel/cve/Cvss4ModifiedAttackComplexity#LOW> <https://w3id.org/lmodel/cve/Cvss4ModifiedAttackComplexity#NOT_DEFINED> ) ;
    skos:definition "CVSS 4.0 modified attack complexity environmental metric." ;
