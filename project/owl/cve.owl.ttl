cve:Cvss4Recovery a owl:Class ;
    rdfs:label "Cvss4Recovery" ;
    owl:unionOf ( <https://w3id.org/lmodel/cve/Cvss4Recovery#AUTOMATIC> <https://w3id.org/lmodel/cve/Cvss4Recovery#USER> <https://w3id.org/lmodel/cve/Cvss4Recovery#IRRECOVERABLE> <https://w3id.org/lmodel/cve/Cvss4Recovery#NOT_DEFINED> ) ;
    skos:definition "CVSS 4.0 recovery supplemental metric." ;
    skos:inScheme <https://w3id.org/lmodel/cve> ;
    linkml:permissible_values <https://w3id.org/lmodel/cve/Cvss4Recovery#AUTOMATIC>,
        <https://w3id.org/lmodel/cve/Cvss4Recovery#IRRECOVERABLE>,
        <https://w3id.org/lmodel/cve/Cvss4Recovery#NOT_DEFINED>,
        <https://w3id.org/lmodel/cve/Cvss4Recovery#USER> .

cve:Cvss4VulnerabilityResponseEffort a owl:Class ;
    rdfs:label "Cvss4VulnerabilityResponseEffort" ;
    owl:unionOf ( <https://w3id.org/lmodel/cve/Cvss4VulnerabilityResponseEffort#LOW> <https://w3id.org/lmodel/cve/Cvss4VulnerabilityResponseEffort#MODERATE> <https://w3id.org/lmodel/cve/Cvss4VulnerabilityResponseEffort#HIGH> <https://w3id.org/lmodel/cve/Cvss4VulnerabilityResponseEffort#NOT_DEFINED> ) ;
    skos:definition "CVSS 4.0 vulnerability response effort supplemental metric." ;
    skos:inScheme <https://w3id.org/lmodel/cve> ;
    linkml:permissible_values <https://w3id.org/lmodel/cve/Cvss4VulnerabilityResponseEffort#HIGH>,
        <https://w3id.org/lmodel/cve/Cvss4VulnerabilityResponseEffort#LOW>,
        <https://w3id.org/lmodel/cve/Cvss4VulnerabilityResponseEffort#MODERATE>,
        <https://w3id.org/lmodel/cve/Cvss4VulnerabilityResponseEffort#NOT_DEFINED> .

cve:RecordState a owl:Class ;
    rdfs:label "RecordState" ;
    owl:unionOf ( <https://w3id.org/lmodel/cve/RecordState#PUBLISHED> <https://w3id.org/lmodel/cve/RecordState#REJECTED> ) ;
    skos:definition "Lifecycle state of a CVE Record (PUBLISHED or REJECTED)." ;
    skos:inScheme <https://w3id.org/lmodel/cve> ;
    linkml:permissible_values <https://w3id.org/lmodel/cve/RecordState#PUBLISHED>,
        <https://w3id.org/lmodel/cve/RecordState#REJECTED> .

cve:assigner_org_id a owl:DatatypeProperty ;
    rdfs:label "assigner_org_id" ;
    rdfs:range xsd:string ;
    skos:altLabel "assignerOrgId" ;
    skos:definition "The UUID for the organization to which the CVE ID was originally assigned. This UUID can be used to lookup the organization record in the user registry service." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:assigner_short_name a owl:DatatypeProperty ;
    rdfs:label "assigner_short_name" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                        owl:onDatatype xsd:string ;
                        owl:withRestrictions ( [ xsd:pattern "^.{2,32}$" ] ) ] ) ] ;
    skos:altLabel "assignerShortName" ;
    skos:definition "The short name for the organization to which the CVE ID was originally assigned." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:cna_source a owl:ObjectProperty ;
    rdfs:label "cna_source" ;
    rdfs:range cve:SourceInformation ;
    skos:altLabel "source" ;
    skos:definition "Source information (who discovered it, who researched it, etc.) and optionally a chain of CNA information." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:cpe_negate a owl:DatatypeProperty ;
    rdfs:label "cpe_negate" ;
    rdfs:range xsd:boolean ;
    skos:altLabel "negate" ;
    skos:definition "If true, negates the applicability of this element." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:cpe_operator a owl:ObjectProperty ;
    rdfs:label "cpe_operator" ;
    rdfs:range cve:CpeOperator ;
    skos:altLabel "operator" ;
    skos:definition "Logical operator (AND/OR) used between CPE criteria in this node." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:date_public a owl:DatatypeProperty ;
    rdfs:label "date_public" ;
    rdfs:range xsd:string ;
    skos:altLabel "datePublic" ;
    skos:definition "If known, the date/time the vulnerability was disclosed publicly." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:date_published a owl:DatatypeProperty ;
    rdfs:label "date_published" ;
    rdfs:range xsd:string ;
    skos:altLabel "datePublished" ;
    skos:definition "The date/time the CVE Record was first published in the CVE List." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:date_reserved a owl:DatatypeProperty ;
    rdfs:label "date_reserved" ;
    rdfs:range xsd:string ;
    skos:altLabel "dateReserved" ;
    skos:definition "The date/time this CVE ID was reserved in the CVE automation workgroup services system. This date does not necessarily indicate when the vulnerability was discovered, shared with the vendor, or publicly disclosed." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:record_cve_id a owl:DatatypeProperty ;
    rdfs:label "record_cve_id" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                        owl:onDatatype xsd:string ;
                        owl:withRestrictions ( [ xsd:pattern "^CVE-[0-9]{4}-[0-9]{4,19}$" ] ) ] ) ] ;
    skos:altLabel "cveId" ;
    skos:definition "The CVE identifier that this record pertains to." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

cve:serial a owl:DatatypeProperty ;
    rdfs:label "serial" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:integer [ a rdfs:Datatype ;
                        owl:onDatatype xsd:integer ;
                        owl:withRestrictions ( [ xsd:minInclusive 1 ] ) ] ) ] ;
    skos:definition "Monotonically increasing integer, starting at 1, incremented each time a submission from a data provider changes this CVE Record." ;
    skos:inScheme <https://w3id.org/lmodel/cve> .

<https://w3id.org/lmodel/vulnerability-core/cwe_id> a owl:DatatypeProperty ;
    rdfs:label "cwe_id" ;
    rdfs:range [ a rdfs:Datatype ;
            owl:intersectionOf ( xsd:string [ a rdfs:Datatype ;
                        owl:onDatatype xsd:string ;
                        owl:withRestrictions ( [ xsd:pattern "^CWE-[1-9][0-9]*$" ] ) ] ) ] ;
    skos:altLabel "cweId" ;
    skos:definition "CWE identifier for the weakness classification (e.g. CWE-79)." ;
    skos:inScheme <https://w3id.org/lmodel/vulnerability-core> ;
    skos:relatedMatch cwe:Weakness .

<https://w3id.org/lmodel/vulnerability-core/description> a owl:DatatypeProperty ;
    rdfs:label "description" ;
    rdfs:range xsd:string ;
    skos:closeMatch kev_catalog:short_description ;
    skos:definition "Narrative description of the vulnerability." ;
    skos:exactMatch schema1:description ;
    skos:inScheme <https://w3id.org/lmodel/vulnerability-core> .

cve:Cvss2Exploitability a owl:Class ;
    rdfs:label "Cvss2Exploitability" ;
    owl:unionOf ( <https://w3id.org/lmodel/cve/Cvss2Exploitability#UNPROVEN> <https://w3id.org/lmodel/cve/Cvss2Exploitability#PROOF_OF_CONCEPT> <https://w3id.org/lmodel/cve/Cvss2Exploitability#FUNCTIONAL> <https://w3id.org/lmodel/cve/Cvss2Exploitability#HIGH> <https://w3id.org/lmodel/cve/Cvss2Exploitability#NOT_DEFINED> ) ;
    skos:definition "CVSS 2.0 exploitability temporal metric." ;
    skos:inScheme <https://w3id.org/lmodel/cve> ;
    linkml:permissible_values <https://w3id.org/lmodel/cve/Cvss2Exploitability#FUNCTIONAL>,
        <https://w3id.org/lmodel/cve/Cvss2Exploitability#HIGH>,
        <https://w3id.org/lmodel/cve/Cvss2Exploitability#NOT_DEFINED>,
        <https://w3id.org/lmodel/cve/Cvss2Exploitability#PROOF_OF_CONCEPT>,
        <https://w3id.org/lmodel/cve/Cvss2Exploitability#UNPROVEN> .

cve:Cvss2RemediationLevel a owl:Class ;
    rdfs:label "Cvss2RemediationLevel" ;
    owl:unionOf ( <https://w3id.org/lmodel/cve/Cvss2RemediationLevel#OFFICIAL_FIX> <https://w3id.org/lmodel/cve/Cvss2RemediationLevel#TEMPORARY_FIX> <https://w3id.org/lmodel/cve/Cvss2RemediationLevel#WORKAROUND> <https://w3id.org/lmodel/cve/Cvss2RemediationLevel#UNAVAILABLE> <https://w3id.org/lmodel/cve/Cvss2RemediationLevel#NOT_DEFINED> ) ;
    skos:definition "CVSS 2.0 remediation level temporal metric." ;
    skos:inScheme <https://w3id.org/lmodel/cve> ;
    linkml:permissible_values <https://w3id.org/lmodel/cve/Cvss2RemediationLevel#NOT_DEFINED>,
