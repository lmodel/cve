	skos:inScheme cve:cve_record ;
	skos:note "It accepts keys of the publisher's own, whose names must begin x_ and hold no full stop. tests/cve_rules.py checks each extra key." ;
	cve:upstream_path "CVE_Record_Format.json#/definitions/cnaRejectedContainer" .
cve:CveCnaTag\#disputed a owl:Class ;
	rdfs:label "disputed" ;
	rdfs:subClassOf cve:CveCnaTag ;
	skos:definition "Someone disagrees that this is a vulnerability at all." .
