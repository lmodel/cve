	skos:inScheme cve:cve_record ;
	cve:upstream_path "CVE_Record_Format.json#/definitions/cnaPublishedContainer CVE_Record_Format.json#/definitions/cnaRejectedContainer" .
cve:CveCnaPublishedContainer a owl:Class ;
	rdfs:label "CveCnaPublishedContainer" ;
	rdfs:subClassOf cve:CveCnaContainer , _:c14n111 , _:c14n118 , _:c14n119 , _:c14n127 , _:c14n181 , _:c14n188 , _:c14n209 , _:c14n223 , _:c14n248 , _:c14n332 , _:c14n342 , _:c14n353 , _:c14n355 , _:c14n370 , _:c14n372 , _:c14n381 , _:c14n402 , _:c14n504 , _:c14n512 , _:c14n529 , _:c14n537 , _:c14n549 , _:c14n575 , _:c14n580 , _:c14n585 , _:c14n594 , _:c14n627 , _:c14n644 , _:c14n659 , _:c14n683 , _:c14n689 , _:c14n69 , _:c14n694 , _:c14n697 , _:c14n707 , _:c14n746 , _:c14n762 , _:c14n794 , _:c14n818 , _:c14n845 , _:c14n924 , _:c14n932 , _:c14n984 , _:c14n99 ;
	skos:definition "The assigning authority's account of a published vulnerability." ;
	skos:inScheme cve:cve_record ;
	skos:note "It accepts keys of the publisher's own, whose names must begin x_ and hold no full stop. JSON Schema from LinkML 1.12.1 cannot state that rule on a name, so tests/cve_rules.py checks each extra key." ;
	cve:upstream_path "CVE_Record_Format.json#/definitions/cnaPublishedContainer" .
cve:CveCnaRejectedContainer a owl:Class ;
	rdfs:label "CveCnaRejectedContainer" ;
	rdfs:subClassOf cve:CveCnaContainer , _:c14n214 , _:c14n289 , _:c14n563 , _:c14n823 , _:c14n983 ;
