cve:CveCnaTag a owl:Class ;
	rdfs:label "CveCnaTag" ;
	owl:unionOf _:c14n467 ;
	skos:definition "A label the assigning authority can put on a record." ;
	skos:inScheme cve:cve_record ;
	linkml:permissible_values cve:CveCnaTag\#disputed , cve:CveCnaTag\#exclusively-hosted-service , cve:CveCnaTag\#unsupported-when-assigned ;
	cve:upstream_path "tags/cna-tags.json#/" .
cve:CveContainers a owl:Class ;
